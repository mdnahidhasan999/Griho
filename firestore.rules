rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // USERS
    // ============================================================

    match /users/{userId} {

      allow get: if isAuthenticated()
                 && request.auth.uid == userId;

      allow create: if isAuthenticated()
                    && request.auth.uid == userId
                    && request.resource.data.uid == request.auth.uid;

      allow update: if isAuthenticated()
                    && request.auth.uid == userId
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.publicId == resource.data.publicId
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.phoneNumber == resource.data.phoneNumber
                    && request.resource.data.isActive == resource.data.isActive
                    && request.resource.data.updatedAt is timestamp
                    && request.resource.data.updatedAt <= request.time
                    && (
                      !request.resource.data.keys().hasAny(['nidNumber'])
                      || request.resource.data.nidNumber == null
                      || (
                        request.resource.data.nidNumber is string
                        && request.resource.data.nidNumber.size() <= 20
                      )
                    )
                    && (
                      (
                        !resource.data.keys().hasAny(['role'])
                        && !request.resource.data.keys().hasAny(['role'])
                      )
                      ||
                      (
                        resource.data.keys().hasAny(['role'])
                        && request.resource.data.keys().hasAny(['role'])
                        && request.resource.data.role == resource.data.role
                      )
                    )
                    && (
                      // Normal profile updates.
                      (
                        request.resource.data.diff(resource.data)
                          .affectedKeys()
                          .hasOnly([
                            'name',
                            'email',
                            'photoUrl',
                            'nidNumber',
                            'updatedAt'
                          ])
                      )
                      ||
                      // Initial role selection (owner, tenant, or manager).
                      (
                        request.resource.data.diff(resource.data)
                          .affectedKeys()
                          .hasOnly([
                            'availableRoles',
                            'defaultDashboard',
                            'updatedAt'
                          ])
                        && (
                          !resource.data.keys().hasAny(['availableRoles'])
                          || resource.data.availableRoles == []
                        )
                        && (
                          !resource.data.keys().hasAny(['defaultDashboard'])
                          || resource.data.defaultDashboard == null
                          || resource.data.defaultDashboard == ''
                        )
                        && request.resource.data.availableRoles is list
                        && request.resource.data.availableRoles.size() == 1
                        && request.resource.data.availableRoles[0] is string
                        && request.resource.data.availableRoles[0] in [
                          'owner',
                          'tenant',
                          'manager',
                          'caretaker',
                          'electrician'
                        ]
                        && request.resource.data.defaultDashboard
                           == request.resource.data.availableRoles[0]
                      )
                      ||
                      // Change default dashboard to an authorized role.
                      (
                        request.resource.data.diff(resource.data)
                          .affectedKeys()
                          .hasOnly([
                            'defaultDashboard',
                            'updatedAt'
                          ])
                        && resource.data.keys().hasAny(['availableRoles'])
                        && resource.data.availableRoles is list
                        && request.resource.data.keys().hasAny(['defaultDashboard'])
                        && request.resource.data.defaultDashboard is string
                        && request.resource.data.defaultDashboard in resource.data.availableRoles
                      )
                      ||
                      // Self-upgrade to Owner or unlock Manager role upon invitation acceptance.
                      (
                        request.resource.data.diff(resource.data)
                          .affectedKeys()
                          .hasOnly([
                            'availableRoles',
                            'defaultDashboard',
                            'updatedAt'
                          ])
                        && resource.data.keys().hasAny(['availableRoles'])
                        && resource.data.availableRoles is list
                        && request.resource.data.availableRoles is list
                        && request.resource.data.availableRoles.hasAll(resource.data.availableRoles)
                        && request.resource.data.availableRoles.size() == resource.data.availableRoles.size() + 1
                        && (
                          (
                            !('owner' in resource.data.availableRoles)
                            && 'owner' in request.resource.data.availableRoles
                            && request.resource.data.defaultDashboard == 'owner'
                          )
                          ||
                          (
                            !('manager' in resource.data.availableRoles)
                            && 'manager' in request.resource.data.availableRoles
                            && (
                              request.resource.data.get('defaultDashboard', null) == 'manager'
                              || request.resource.data.get('defaultDashboard', null) == resource.data.get('defaultDashboard', null)
                            )
                          )
                          ||
                          (
                            !('caretaker' in resource.data.availableRoles)
                            && 'caretaker' in request.resource.data.availableRoles
                            && (
                              request.resource.data.get('defaultDashboard', null) == 'caretaker'
                              || request.resource.data.get('defaultDashboard', null) == resource.data.get('defaultDashboard', null)
                            )
                          )
                          ||
                          (
                            !('electrician' in resource.data.availableRoles)
                            && 'electrician' in request.resource.data.availableRoles
                            && (
                              request.resource.data.get('defaultDashboard', null) == 'electrician'
                              || request.resource.data.get('defaultDashboard', null) == resource.data.get('defaultDashboard', null)
                            )
                          )
                        )
                      )
                    );

      allow delete: if false;
    }

    // ============================================================
    // PHONE LOOKUPS & PUBLIC IDS (NO LISTING ALLOWED)
    // ============================================================

    match /phone_lookups/{phoneNumber} {
      allow get: if isAuthenticated();
      allow list: if false;

      allow create: if isAuthenticated()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.phoneNumber == phoneNumber;

      allow update: if isAuthenticated()
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.phoneNumber == resource.data.phoneNumber
                    && request.resource.data.publicId == resource.data.publicId;

      allow delete: if isAuthenticated()
                    && resource.data.uid == request.auth.uid;
    }

    match /public_ids/{publicId} {
      allow get: if isAuthenticated();
      allow list: if false;

      allow create: if isAuthenticated()
                    && request.resource.data.publicId == publicId
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.createdBy == request.auth.uid;

      allow update: if isAuthenticated()
                    && resource.data.uid == request.auth.uid
                    && resource.data.createdBy == request.auth.uid
                    && request.resource.data.publicId == resource.data.publicId
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.createdBy == resource.data.createdBy;

      allow delete: if isAuthenticated()
                    && resource.data.createdBy == request.auth.uid;
    }

    // ============================================================
    // PROPERTIES (STRICT SCOPED READ)
    // ============================================================

    match /properties/{propertyId} {
      allow get: if isAuthenticated()
                 && (
                   resource.data.ownerId == request.auth.uid
                   || isPropertyManager(propertyId)
                   || (
                     resource.data.tenantUserIds is list
                     && request.auth.uid in resource.data.tenantUserIds
                   )
                 );

      allow list: if isAuthenticated()
                  && (
                    resource.data.ownerId == request.auth.uid
                    || isPropertyManager(propertyId)
                    || (
                      resource.data.tenantUserIds is list
                      && request.auth.uid in resource.data.tenantUserIds
                    )
                  );

      allow create: if isAuthenticated()
                    && request.resource.data.ownerId == request.auth.uid;

      allow update: if isAuthenticated()
                    && (
                      (
                        resource.data.ownerId == request.auth.uid
                        && request.resource.data.ownerId == resource.data.ownerId
                      )
                      ||
                      (
                        isPropertyManager(propertyId)
                        && request.resource.data.ownerId == resource.data.ownerId
                        && request.resource.data.diff(resource.data)
                             .affectedKeys()
                             .hasOnly(['tenantUserIds', 'updatedAt'])
                      )
                      ||
                      (
                        resource.data.tenantUserIds is list
                        && resource.data.tenantUserIds.size() == 0
                        && request.resource.data.tenantUserIds is list
                        && request.resource.data.tenantUserIds.size() == 1
                        && request.auth.uid in request.resource.data.tenantUserIds
                        && request.resource.data.ownerId == resource.data.ownerId
                        && request.resource.data.name == resource.data.name
                        && request.resource.data.propertyCode == resource.data.propertyCode
                        && request.resource.data.address == resource.data.address
                        && request.resource.data.description == resource.data.description
                        && request.resource.data.type == resource.data.type
                        && request.resource.data.status == resource.data.status
                        && request.resource.data.numberOfFloors == resource.data.numberOfFloors
                        && request.resource.data.createdAt == resource.data.createdAt
                        && isValidTenantAcceptance(
                          request.resource.data.ownerId,
                          propertyId,
                          null
                        )
                      )
                      ||
                      (
                        resource.data.tenantUserIds is list
                        && request.resource.data.tenantUserIds is list
                        && request.auth.uid in request.resource.data.tenantUserIds
                        && !(request.auth.uid in resource.data.tenantUserIds)
                        && request.resource.data.tenantUserIds.size()
                           == resource.data.tenantUserIds.size() + 1
                        && request.resource.data.tenantUserIds.hasAll(
                          resource.data.tenantUserIds
                        )
                        && request.resource.data.ownerId == resource.data.ownerId
                        && request.resource.data.name == resource.data.name
                        && request.resource.data.propertyCode == resource.data.propertyCode
                        && request.resource.data.address == resource.data.address
                        && request.resource.data.description == resource.data.description
                        && request.resource.data.type == resource.data.type
                        && request.resource.data.status == resource.data.status
                        && request.resource.data.numberOfFloors == resource.data.numberOfFloors
                        && isValidTenantAcceptance(
                          request.resource.data.ownerId,
                          propertyId,
                          null
                        )
                      )
                    );

      allow delete: if isAuthenticated()
                    && resource.data.ownerId == request.auth.uid;
    }

    // ============================================================
    // UNITS (STRICT SCOPED READ)
    // ============================================================

    match /units/{unitId} {
      allow get, list: if isAuthenticated()
                       && (
                         isPropertyOwner(resource.data.propertyId)
                         || isPropertyManager(resource.data.propertyId)
                         || resource.data.get('tenantUserId', null) == request.auth.uid
                       );

      allow create: if isAuthenticated()
                    && isPropertyOwner(request.resource.data.propertyId);

      allow update: if isAuthenticated()
                    && (
                      isPropertyOwner(resource.data.propertyId)
                      || (
                        isPropertyManager(resource.data.propertyId)
                        && request.resource.data.propertyId == resource.data.propertyId
                      )
                      || (
                        (
                          !resource.data.keys().hasAny(['tenantUserId'])
                          || resource.data.tenantUserId == null
                        )
                        && request.resource.data.tenantUserId == request.auth.uid
                        && request.resource.data.propertyId == resource.data.propertyId
                        && request.resource.data.floorNumber == resource.data.floorNumber
                        && request.resource.data.unitNumber == resource.data.unitNumber
                        && (
                          (!resource.data.keys().hasAny(['name']) && !request.resource.data.keys().hasAny(['name']))
                          || request.resource.data.name == resource.data.name
                        )
                        && request.resource.data.createdAt == resource.data.createdAt
                        && request.resource.data.status == 'occupied'
                        && isValidTenantAcceptance(
                          null,
                          resource.data.propertyId,
                          unitId
                        )
                      )
                    );

      allow delete: if isAuthenticated()
                    && isPropertyOwner(resource.data.propertyId);
    }

    // ============================================================
    // TENANT ACCESS
    // ============================================================

    match /tenantAccess/{userId} {
      allow get: if isAuthenticated()
                 && request.auth.uid == userId;

      allow create: if isAuthenticated()
                    && request.resource.data.userId == userId
                    && request.resource.data.tenantId is string
                    && request.resource.data.ownerId is string
                    && request.resource.data.propertyId is string
                    && request.resource.data.unitId is string
                    && (
                      (
                        request.auth.uid == userId
                        && request.resource.data.userId == request.auth.uid
                        && request.resource.data.invitationId is string
                        && request.resource.data.invitationId != ''
                        && isValidInvitationTenantAccess()
                      )
                      ||
                      (
                        request.resource.data.invitationId == null
                        && isValidOwnerStartNewTenancyAccess()
                      )
                    );

      allow update: if isAuthenticated()
                    && request.auth.uid == userId
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.tenantId == resource.data.tenantId
                    && request.resource.data.ownerId == resource.data.ownerId
                    && request.resource.data.propertyId == resource.data.propertyId
                    && request.resource.data.unitId == resource.data.unitId
                    && request.resource.data.invitationId == resource.data.invitationId
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.diff(resource.data)
                       .affectedKeys()
                       .hasOnly(['updatedAt'])
                    && request.resource.data.updatedAt is timestamp
                    && request.resource.data.updatedAt <= request.time;

      allow delete: if isAuthenticated()
                    && (
                      request.auth.uid == resource.data.userId
                      || (
                        (
                          resource.data.ownerId == request.auth.uid
                          || isPropertyManager(resource.data.propertyId)
                        )
                        && isValidOwnerEndTenancyAccessDelete()
                      )
                    );
    }

    // ============================================================
    // TENANTS (STRICT PRIVACY: NO CROSS-OWNER / CROSS-TENANT LEAK)
    // ============================================================

    match /tenants/{tenantId} {
      allow get, list: if isAuthenticated()
                       && (
                         resource.data.ownerId == request.auth.uid
                         || isPropertyManager(resource.data.propertyId)
                         || resource.data.get('userId', null) == request.auth.uid
                       );

      allow create: if isAuthenticated()
                    && (
                      (
                        request.resource.data.ownerId == request.auth.uid
                        && isPropertyOwner(request.resource.data.propertyId)
                      )
                      || isPropertyManager(request.resource.data.propertyId)
                    );

      allow update: if isAuthenticated()
                    && (
                      (
                        isPropertyManager(resource.data.propertyId)
                        && request.resource.data.ownerId == resource.data.ownerId
                        && request.resource.data.propertyId == resource.data.propertyId
                        && request.resource.data.get('userId', null) == resource.data.get('userId', null)
                      )
                      ||
                      (
                        resource.data.ownerId == request.auth.uid
                        && request.resource.data.ownerId == resource.data.ownerId
                        && request.resource.data.propertyId == resource.data.propertyId
                        && request.resource.data.unitId == resource.data.unitId
                        && request.resource.data.status == resource.data.status
                        && isPropertyOwner(resource.data.propertyId)
                      )
                      ||
                      (
                        resource.data.ownerId == request.auth.uid
                        && resource.data.status == 'inactive'
                        && request.resource.data.ownerId == resource.data.ownerId
                        && request.resource.data.status == 'active'
                        && request.resource.data.userId is string
                        && request.resource.data.userId == resource.data.userId
                        && request.resource.data.accountStatus == resource.data.accountStatus
                        && request.resource.data.confirmationStatus == resource.data.confirmationStatus
                        && isValidOwnerStartNewTenancyTenant(tenantId)
                      )
                      ||
                      (
                        resource.data.ownerId == request.auth.uid
                        && resource.data.status == 'active'
                        && request.resource.data.ownerId == resource.data.ownerId
                        && request.resource.data.status == 'inactive'
                        && request.resource.data.userId == resource.data.userId
                        && request.resource.data.propertyId == resource.data.propertyId
                        && request.resource.data.unitId == resource.data.unitId
                        && request.resource.data.accountStatus == resource.data.accountStatus
                        && request.resource.data.confirmationStatus == resource.data.confirmationStatus
                        && isValidOwnerEndTenancy()
                      )
                      ||
                      (
                        resource.data.userId == request.auth.uid
                        && request.resource.data.userId == resource.data.userId
                        && request.resource.data.ownerId == resource.data.ownerId
                        && request.resource.data.propertyId == resource.data.propertyId
                        && request.resource.data.unitId == resource.data.unitId
                        && request.resource.data.phone == resource.data.phone
                        && request.resource.data.status == resource.data.status
                        && request.resource.data.accountStatus == resource.data.accountStatus
                        && request.resource.data.confirmationStatus == resource.data.confirmationStatus
                        && request.resource.data.createdAt == resource.data.createdAt
                      )
                      ||
                      (
                        resource.data.userId == request.auth.uid
                        && resource.data.status == 'inactive'
                        && request.resource.data.userId == resource.data.userId
                        && request.resource.data.ownerId == resource.data.ownerId
                        && request.resource.data.propertyId == resource.data.propertyId
                        && request.resource.data.unitId == resource.data.unitId
                        && request.resource.data.phone == resource.data.phone
                        && request.resource.data.accountStatus == resource.data.accountStatus
                        && request.resource.data.status == 'active'
                        && request.resource.data.confirmationStatus == 'confirmed'
                        && request.resource.data.tenancyStartedAt is timestamp
                        && request.resource.data.createdAt == resource.data.createdAt
                        && isValidLinkedTenantInvitationAcceptance(tenantId)
                      )
                      ||
                      (
                        (
                          !resource.data.keys().hasAny(['userId'])
                          || resource.data.userId == null
                        )
                        && getAfter(/databases/$(database)/documents/tenantAccess/$(request.auth.uid)).data.invitationId is string
                        && getAfter(/databases/$(database)/documents/tenantInvitations/$(getAfter(/databases/$(database)/documents/tenantAccess/$(request.auth.uid)).data.invitationId)).data.tenantId == tenantId
                        && getAfter(/databases/$(database)/documents/tenantInvitations/$(getAfter(/databases/$(database)/documents/tenantAccess/$(request.auth.uid)).data.invitationId)).data.status == 'accepted'
                        && request.resource.data.userId == request.auth.uid
                        && request.resource.data.ownerId == resource.data.ownerId
                        && request.resource.data.propertyId == resource.data.propertyId
                        && request.resource.data.unitId == resource.data.unitId
                        && request.resource.data.phone == resource.data.phone
                        && getAfter(/databases/$(database)/documents/tenantAccess/$(request.auth.uid)).data.tenantId == tenantId
                        && getAfter(/databases/$(database)/documents/tenantAccess/$(request.auth.uid)).data.ownerId == resource.data.ownerId
                        && getAfter(/databases/$(database)/documents/tenantAccess/$(request.auth.uid)).data.propertyId == resource.data.propertyId
                        && getAfter(/databases/$(database)/documents/tenantAccess/$(request.auth.uid)).data.unitId == resource.data.unitId
                      )
                    );

      allow delete: if isAuthenticated()
                    && resource.data.ownerId == request.auth.uid;
    }

    // ============================================================
    // TENANCY HISTORIES (SCOPED READ)
    // ============================================================

    match /tenancyHistories/{historyId} {
      allow get, list: if isAuthenticated()
                       && (
                         resource.data.ownerId == request.auth.uid
                         || isPropertyManager(resource.data.propertyId)
                         || resource.data.get('tenantUserId', null) == request.auth.uid
                       );

      allow create: if isAuthenticated()
                    && (
                      isValidOwnerEndTenancyHistory()
                      || request.resource.data.ownerId == request.auth.uid
                      || request.resource.data.tenantUserId == request.auth.uid
                      || isPropertyManager(request.resource.data.propertyId)
                    );

      allow update: if false;
      allow delete: if false;
    }

    // ============================================================
    // RENT RATES (SCOPED READ)
    // ============================================================

    match /rentRates/{rentRateId} {
      allow get, list: if isAuthenticated()
                       && (
                         resource.data.ownerId == request.auth.uid
                         || isPropertyManager(resource.data.propertyId)
                         || isUnitTenant(resource.data.unitId)
                       );

      allow create: if isAuthenticated()
                    && request.resource.data.ownerId is string
                    && request.resource.data.ownerId != ''
                    && request.resource.data.propertyId is string
                    && request.resource.data.propertyId != ''
                    && request.resource.data.unitId is string
                    && request.resource.data.unitId != ''
                    && request.resource.data.amount is number
                    && request.resource.data.amount > 0
                    && request.resource.data.effectiveFrom is timestamp
                    && request.resource.data.effectiveTo == null
                    && request.resource.data.source is string
                    && request.resource.data.source in [
                      'initial',
                      'property',
                      'floor',
                      'unit'
                    ]
                    && (
                      !request.resource.data.keys().hasAny(['nextRentRateId'])
                      || request.resource.data.nextRentRateId == null
                    )
                    && (
                      !request.resource.data.keys().hasAny(['previousRentRateId'])
                      || request.resource.data.previousRentRateId == null
                      || (
                        request.resource.data.previousRentRateId is string
                        && request.resource.data.previousRentRateId != ''
                      )
                    )
                    && request.resource.data.createdAt is timestamp
                    && request.resource.data.updatedAt is timestamp
                    && (
                      isValidInitialRentRateCreate()
                      || isValidChangedRentRateCreate()
                    );

      allow update: if isAuthenticated()
                    && (
                      resource.data.ownerId == request.auth.uid
                      || isPropertyManager(resource.data.propertyId)
                    )
                    && request.resource.data.ownerId == resource.data.ownerId
                    && request.resource.data.propertyId == resource.data.propertyId
                    && request.resource.data.unitId == resource.data.unitId
                    && request.resource.data.amount == resource.data.amount
                    && request.resource.data.effectiveFrom == resource.data.effectiveFrom
                    && request.resource.data.source == resource.data.source
                    && request.resource.data.createdAt == resource.data.createdAt
                    && resource.data.effectiveTo == null
                    && request.resource.data.effectiveTo is timestamp
                    && request.resource.data.effectiveTo >= resource.data.effectiveFrom
                    && request.resource.data.updatedAt is timestamp
                    && request.resource.data.updatedAt <= request.time
                    && (
                      (
                        isValidEndTenancyRentRateClose()
                        && (
                          !request.resource.data.keys().hasAny(['nextRentRateId'])
                          || request.resource.data.nextRentRateId == null
                        )
                      )
                      ||
                      (
                        request.resource.data.nextRentRateId is string
                        && request.resource.data.nextRentRateId != ''
                        && isValidChangedRentRateClose()
                      )
                    );

      allow delete: if false;
    }

    // ============================================================
    // MONTHLY RENTS (HARDENED READ & UPDATE)
    // ============================================================

    match /monthlyRents/{monthlyRentId} {
      allow get, list: if isAuthenticated()
                       && (
                         resource.data.ownerId == request.auth.uid
                         || isPropertyManager(resource.data.propertyId)
                         || resource.data.get('tenantUserId', null) == request.auth.uid
                       );

      allow create: if isAuthenticated()
                    && isValidMonthlyRentCreate();

      allow update: if isAuthenticated()
                    && (
                      isValidMonthlyBillOwnerPaymentReview()
                      || isValidMonthlyBillPaymentReservation()
                      || isValidMonthlyBillCancellation()
                    );

      allow delete: if false;
    }

    // ============================================================
    // RENTS (SCOPED READ)
    // ============================================================

    match /rents/{rentId} {
      allow get, list: if isAuthenticated()
                       && (
                         resource.data.ownerId == request.auth.uid
                         || isPropertyManager(resource.data.propertyId)
                         || resource.data.get('tenantUserId', null) == request.auth.uid
                       );

      allow create: if isAuthenticated()
                    && isValidOwnerCreateRent();

      allow update: if false;
      allow delete: if false;
    }

    // ============================================================
    // TENANT INVITATIONS
    // ============================================================

    match /tenantInvitations/{invitationId} {
      allow create: if isAuthenticated()
                    && (
                      request.resource.data.ownerId == request.auth.uid
                      || isPropertyManager(request.resource.data.propertyId)
                    )
                    && request.resource.data.rentAmount is number
                    && request.resource.data.rentAmount > 0
                    && request.resource.data.token == invitationId;

      allow get, list: if isAuthenticated()
                       && (
                         resource.data.ownerId == request.auth.uid
                         || isPropertyManager(resource.data.propertyId)
                         || isInvitationRecipient(resource.data)
                       );

      allow update: if isAuthenticated()
                    && (
                      (
                        (
                          resource.data.ownerId == request.auth.uid
                          || isPropertyManager(resource.data.propertyId)
                        )
                        && request.resource.data.ownerId == resource.data.ownerId
                        && request.resource.data.tenantId == resource.data.tenantId
                        && request.resource.data.propertyId == resource.data.propertyId
                        && request.resource.data.unitId == resource.data.unitId
                        && request.resource.data.phone == resource.data.phone
                        && request.resource.data.token == resource.data.token
                        && request.resource.data.rentAmount == resource.data.rentAmount
                        && request.resource.data.createdAt == resource.data.createdAt
                        && request.resource.data.expiresAt == resource.data.expiresAt
                      )
                      ||
                      (
                        isInvitationRecipient(resource.data)
                        && request.resource.data.get('targetEmail', null) == resource.data.get('targetEmail', null)
                        && request.resource.data.get('targetGrihoId', null) == resource.data.get('targetGrihoId', null)
                        && resource.data.status == 'pending'
                        && request.resource.data.status == 'accepted'
                        && request.resource.data.ownerId == resource.data.ownerId
                        && request.resource.data.tenantId == resource.data.tenantId
                        && request.resource.data.propertyId == resource.data.propertyId
                        && request.resource.data.unitId == resource.data.unitId
                        && request.resource.data.get('phone', null) == resource.data.get('phone', null)
                        && request.resource.data.token == resource.data.token
                        && request.resource.data.rentAmount == resource.data.rentAmount
                        && request.resource.data.createdAt == resource.data.createdAt
                        && request.resource.data.expiresAt == resource.data.expiresAt
                        && getAfter(/databases/$(database)/documents/tenants/$(resource.data.tenantId)).data.userId == request.auth.uid
                        && getAfter(/databases/$(database)/documents/tenantAccess/$(request.auth.uid)).data.tenantId == resource.data.tenantId
                        && getAfter(/databases/$(database)/documents/tenantAccess/$(request.auth.uid)).data.ownerId == resource.data.ownerId
                        && getAfter(/databases/$(database)/documents/tenantAccess/$(request.auth.uid)).data.propertyId == resource.data.propertyId
                        && getAfter(/databases/$(database)/documents/tenantAccess/$(request.auth.uid)).data.unitId == resource.data.unitId
                        && getAfter(/databases/$(database)/documents/tenantAccess/$(request.auth.uid)).data.invitationId == invitationId
                      )
                      ||
                      (
                        isInvitationRecipient(resource.data)
                        && request.resource.data.get('targetEmail', null) == resource.data.get('targetEmail', null)
                        && request.resource.data.get('targetGrihoId', null) == resource.data.get('targetGrihoId', null)
                        && resource.data.status == 'pending'
                        && request.resource.data.status == 'rejected'
                        && request.resource.data.ownerId == resource.data.ownerId
                        && request.resource.data.tenantId == resource.data.tenantId
                        && request.resource.data.propertyId == resource.data.propertyId
                        && request.resource.data.unitId == resource.data.unitId
                        && request.resource.data.get('phone', null) == resource.data.get('phone', null)
                        && request.resource.data.token == resource.data.token
                        && request.resource.data.rentAmount == resource.data.rentAmount
                        && request.resource.data.createdAt == resource.data.createdAt
                        && request.resource.data.expiresAt == resource.data.expiresAt
                      )
                    );

      allow delete: if isAuthenticated()
                    && (
                      resource.data.ownerId == request.auth.uid
                      || isPropertyManager(resource.data.propertyId)
                      || (
                        isInvitationRecipient(resource.data)
                        && resource.data.status == 'pending'
                      )
                    );
    }

    // ============================================================
    // MANAGER INVITATIONS (HARDENED SECURITY)
    // ============================================================

    match /managerInvitations/{invitationId} {
      allow create: if isAuthenticated()
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.propertyId is string
                    && request.resource.data.propertyId != ''
                    && isPropertyOwner(request.resource.data.propertyId)
                    && request.resource.data.status == 'pending';

      allow get, list: if isAuthenticated()
                       && (
                         resource.data.ownerId == request.auth.uid
                         || isManagerInvitationRecipient(resource.data)
                       );

      allow update: if isAuthenticated()
                    && (
                      (
                        resource.data.ownerId == request.auth.uid
                        && isPropertyOwner(resource.data.propertyId)
                        && request.resource.data.ownerId == resource.data.ownerId
                        && request.resource.data.propertyId == resource.data.propertyId
                      )
                      ||
                      (
                        isManagerInvitationRecipient(resource.data)
                        && resource.data.status == 'pending'
                        && request.resource.data.status in ['accepted', 'rejected']
                        && request.resource.data.ownerId == resource.data.ownerId
                        && request.resource.data.propertyId == resource.data.propertyId
                        && request.resource.data.managerUserId == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly([
                               'status', 'accessStatus', 'managerUserId',
                               'managerName', 'managerGrihoId', 'managerPhone',
                               'respondedAt', 'updatedAt'
                             ])
                      )
                    );

      allow delete: if isAuthenticated()
                    && resource.data.ownerId == request.auth.uid
                    && isPropertyOwner(resource.data.propertyId);
    }

    // ============================================================
    // MANAGER ACCESS (CRITICAL SECURITY LOCKDOWN)
    // ============================================================

    match /managerAccess/{accessId} {
      allow get, list: if isAuthenticated()
                       && (
                         resource.data.ownerId == request.auth.uid
                         || resource.data.userId == request.auth.uid
                       );

      allow create: if isAuthenticated()
                    && accessId == (request.auth.uid + '_' + request.resource.data.propertyId)
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.propertyId is string
                    && request.resource.data.propertyId != ''
                    && request.resource.data.ownerId is string
                    && request.resource.data.invitationId is string
                    && request.resource.data.invitationId != ''
                    && request.resource.data.status == 'active'
                    && get(
                         /databases/$(database)/documents/properties/$(request.resource.data.propertyId)
                       ).data.ownerId == request.resource.data.ownerId
                    && get(
                         /databases/$(database)/documents/managerInvitations/$(request.resource.data.invitationId)
                       ).data.status == 'pending'
                    && get(
                         /databases/$(database)/documents/managerInvitations/$(request.resource.data.invitationId)
                       ).data.propertyId == request.resource.data.propertyId
                    && get(
                         /databases/$(database)/documents/managerInvitations/$(request.resource.data.invitationId)
                       ).data.ownerId == request.resource.data.ownerId
                    && isManagerInvitationRecipient(
                         get(/databases/$(database)/documents/managerInvitations/$(request.resource.data.invitationId)).data
                       )
                    && getAfter(
                         /databases/$(database)/documents/managerInvitations/$(request.resource.data.invitationId)
                       ).data.status == 'accepted'
                    && getAfter(
                         /databases/$(database)/documents/managerInvitations/$(request.resource.data.invitationId)
                       ).data.managerUserId == request.auth.uid;

      allow update: if isAuthenticated()
                    && (
                      (
                        resource.data.ownerId == request.auth.uid
                        && isPropertyOwner(resource.data.propertyId)
                        && request.resource.data.userId == resource.data.userId
                        && request.resource.data.ownerId == resource.data.ownerId
                        && request.resource.data.propertyId == resource.data.propertyId
                        && request.resource.data.status in ['active', 'suspended', 'revoked']
                      )
                      ||
                      // Re-assignment of a previously revoked manager via a NEW accepted invitation
                      (
                        resource.data.userId == request.auth.uid
                        && resource.data.status == 'revoked'
                        && request.resource.data.status == 'active'
                        && request.resource.data.userId == resource.data.userId
                        && request.resource.data.ownerId == resource.data.ownerId
                        && request.resource.data.propertyId == resource.data.propertyId
                        && request.resource.data.invitationId != resource.data.invitationId
                        && isValidManagerAccessGrant()
                      )
                    );

      allow delete: if isAuthenticated()
                    && resource.data.ownerId == request.auth.uid
                    && isPropertyOwner(resource.data.propertyId);
    }

    // ============================================================
    // ACTIVITY & AUDIT LOGS (IMMUTABLE, SCOPED, NON-FORGEABLE)
    // ============================================================

    match /activityLogs/{logId} {
      allow get, list: if isAuthenticated()
                       && (
                         resource.data.ownerId == request.auth.uid
                         || isPropertyManager(resource.data.propertyId)
                       );

      allow create: if isAuthenticated()
                    && request.resource.data.actorUid == request.auth.uid
                    && request.resource.data.propertyId is string
                    && request.resource.data.ownerId is string
                    && (
                      (
                        request.resource.data.actorRole == 'owner'
                        && request.resource.data.ownerId == request.auth.uid
                        && isPropertyOwner(request.resource.data.propertyId)
                      )
                      ||
                      (
                        request.resource.data.actorRole == 'manager'
                        && isPropertyManager(request.resource.data.propertyId)
                        && request.resource.data.ownerId == propertyOwnerId(request.resource.data.propertyId)
                      )
                      ||
                      (
                        request.resource.data.actorRole == 'caretaker'
                        && isPropertyStaffRole(request.resource.data.propertyId, 'caretaker')
                        && request.resource.data.ownerId == propertyOwnerId(request.resource.data.propertyId)
                      )
                      ||
                      (
                        request.resource.data.actorRole == 'electrician'
                        && isPropertyStaffRole(request.resource.data.propertyId, 'electrician')
                        && request.resource.data.ownerId == propertyOwnerId(request.resource.data.propertyId)
                      )
                    );

      allow update, delete: if false;
    }

    // ============================================================
    // STAFF INVITATIONS (CARETAKER & ELECTRICIAN)
    // ============================================================

    match /staffInvitations/{invitationId} {
      allow create: if isAuthenticated()
                    && request.resource.data.propertyId is string
                    && request.resource.data.ownerId is string
                    && request.resource.data.staffRole in ['caretaker', 'electrician']
                    && request.resource.data.status == 'pending'
                    && (
                      (
                        request.resource.data.ownerId == request.auth.uid
                        && isPropertyOwner(request.resource.data.propertyId)
                      )
                      ||
                      (
                        isPropertyManager(request.resource.data.propertyId)
                        && request.resource.data.ownerId == propertyOwnerId(request.resource.data.propertyId)
                      )
                    );

      allow get, list: if isAuthenticated()
                       && (
                         resource.data.ownerId == request.auth.uid
                         || isPropertyManager(resource.data.propertyId)
                         || isStaffInvitationRecipient(resource.data)
                       );

      allow update: if isAuthenticated()
                    && (
                      // OWNER / MANAGER — change access state or cancel; cannot fake an acceptance
                      (
                        (
                          (resource.data.ownerId == request.auth.uid && isPropertyOwner(resource.data.propertyId))
                          || isPropertyManager(resource.data.propertyId)
                        )
                        && request.resource.data.ownerId == resource.data.ownerId
                        && request.resource.data.propertyId == resource.data.propertyId
                        && request.resource.data.get('staffRole', null) == resource.data.get('staffRole', null)
                        && request.resource.data.get('staffUserId', null) == resource.data.get('staffUserId', null)
                        && (
                          request.resource.data.status == resource.data.status
                          || request.resource.data.status == 'revoked'
                        )
                      )
                      ||
                      // RECIPIENT — accept / reject, response fields only
                      (
                        isStaffInvitationRecipient(resource.data)
                        && resource.data.status == 'pending'
                        && request.resource.data.status in ['accepted', 'rejected']
                        && request.resource.data.ownerId == resource.data.ownerId
                        && request.resource.data.propertyId == resource.data.propertyId
                        && request.resource.data.get('staffRole', null) == resource.data.get('staffRole', null)
                        && request.resource.data.staffUserId == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly([
                               'status', 'accessStatus', 'staffUserId',
                               'staffName', 'staffGrihoId', 'staffPhone',
                               'respondedAt', 'updatedAt'
                             ])
                      )
                    );

      allow delete: if isAuthenticated()
                    && (
                      (resource.data.ownerId == request.auth.uid && isPropertyOwner(resource.data.propertyId))
                      || isPropertyManager(resource.data.propertyId)
                    );
    }

    // ============================================================
    // STAFF ACCESS (CRITICAL SECURITY LOCKDOWN)
    // ============================================================

    match /staffAccess/{accessId} {
      allow get, list: if isAuthenticated()
                       && (
                         resource.data.ownerId == request.auth.uid
                         || resource.data.userId == request.auth.uid
                         || isPropertyManager(resource.data.propertyId)
                       );

      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.staffRole in ['caretaker', 'electrician']
                    && request.resource.data.status == 'active'
                    && request.resource.data.propertyId is string
                    && accessId == (
                      request.auth.uid + '_'
                      + request.resource.data.propertyId + '_'
                      + request.resource.data.staffRole
                    )
                    && isValidStaffAccessGrant();

      allow update: if isAuthenticated()
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.ownerId == resource.data.ownerId
                    && request.resource.data.propertyId == resource.data.propertyId
                    && request.resource.data.staffRole == resource.data.staffRole
                    && (
                      // OWNER / MANAGER — suspend, restore, revoke
                      (
                        (
                          (resource.data.ownerId == request.auth.uid && isPropertyOwner(resource.data.propertyId))
                          || isPropertyManager(resource.data.propertyId)
                        )
                        && request.resource.data.status in ['active', 'suspended', 'revoked']
                      )
                      ||
                      // STAFF — re-assignment after revoke via a NEW accepted invitation
                      (
                        resource.data.userId == request.auth.uid
                        && resource.data.status == 'revoked'
                        && request.resource.data.status == 'active'
                        && request.resource.data.invitationId != resource.data.invitationId
                        && isValidStaffAccessGrant()
                      )
                    );

      allow delete: if false;
    }

    // ============================================================
    // MAINTENANCE / WORK ORDERS (ROLE-SCOPED)
    //   Electrician  -> category 'electrical' only
    //   Caretaker    -> every other category
    //   Owner/Manager-> full control of the property's tickets
    // ============================================================

    match /maintenanceRequests/{ticketId} {
      allow get, list: if isAuthenticated()
                       && (
                         resource.data.ownerId == request.auth.uid
                         || isPropertyManager(resource.data.propertyId)
                         || isPropertyStaff(resource.data.propertyId)
                         || resource.data.get('tenantUserId', null) == request.auth.uid
                       );

      allow create: if isAuthenticated()
                    && request.resource.data.propertyId is string
                    && request.resource.data.status == 'open'
                    && request.resource.data.ownerId == propertyOwnerId(request.resource.data.propertyId)
                    && (
                      isPropertyOwner(request.resource.data.propertyId)
                      || isPropertyManager(request.resource.data.propertyId)
                      || isPropertyStaff(request.resource.data.propertyId)
                      || (
                        request.resource.data.get('tenantUserId', null) == request.auth.uid
                        && request.auth.uid in get(
                             /databases/$(database)/documents/properties/$(request.resource.data.propertyId)
                           ).data.get('tenantUserIds', [])
                      )
                    );

      allow update: if isAuthenticated()
                    && request.resource.data.ownerId == resource.data.ownerId
                    && request.resource.data.propertyId == resource.data.propertyId
                    && request.resource.data.get('tenantUserId', null) == resource.data.get('tenantUserId', null)
                    && request.resource.data.status in ['open', 'assigned', 'in_progress', 'resolved', 'cancelled']
                    && (
                      isPropertyOwner(resource.data.propertyId)
                      || isPropertyManager(resource.data.propertyId)
                      || (
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly([
                            'status', 'handledByName', 'handledByRole',
                            'resolutionNote', 'updatedAt'
                          ])
                        && request.resource.data.status in ['in_progress', 'resolved']
                        && (
                          (
                            isPropertyStaffRole(resource.data.propertyId, 'electrician')
                            && resource.data.get('category', 'electrical') == 'electrical'
                            && request.resource.data.handledByRole == 'electrician'
                          )
                          ||
                          (
                            isPropertyStaffRole(resource.data.propertyId, 'caretaker')
                            && resource.data.get('category', 'general') != 'electrical'
                            && request.resource.data.handledByRole == 'caretaker'
                          )
                        )
                      )
                    );

      allow delete: if false;
    }

    // ============================================================
    // VISITOR LOGS (Owner / Manager / Caretaker)
    // ============================================================

    match /visitorLogs/{logId} {
      allow get, list: if isAuthenticated()
                       && (
                         isPropertyOwner(resource.data.propertyId)
                         || isPropertyManager(resource.data.propertyId)
                         || isPropertyStaffRole(resource.data.propertyId, 'caretaker')
                       );

      allow create: if isAuthenticated()
                    && request.resource.data.propertyId is string
                    && request.resource.data.loggedByUid == request.auth.uid
                    && request.resource.data.ownerId == propertyOwnerId(request.resource.data.propertyId)
                    && (
                      isPropertyOwner(request.resource.data.propertyId)
                      || isPropertyManager(request.resource.data.propertyId)
                      || isPropertyStaffRole(request.resource.data.propertyId, 'caretaker')
                    );

      allow update: if isAuthenticated()
                    && request.resource.data.propertyId == resource.data.propertyId
                    && request.resource.data.ownerId == resource.data.ownerId
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'checkOutAt'])
                    && (
                      isPropertyOwner(resource.data.propertyId)
                      || isPropertyManager(resource.data.propertyId)
                      || isPropertyStaffRole(resource.data.propertyId, 'caretaker')
                    );

      allow delete: if false;
    }

    // ============================================================
    // BUILDING NOTICES (post: Owner / Manager / Caretaker; read: + residents)
    // ============================================================

    match /buildingNotices/{noticeId} {
      allow get, list: if isAuthenticated()
                       && (
                         isPropertyOwner(resource.data.propertyId)
                         || isPropertyManager(resource.data.propertyId)
                         || isPropertyStaff(resource.data.propertyId)
                         || request.auth.uid in get(
                              /databases/$(database)/documents/properties/$(resource.data.propertyId)
                            ).data.get('tenantUserIds', [])
                       );

      allow create: if isAuthenticated()
                    && request.resource.data.propertyId is string
                    && request.resource.data.postedByUid == request.auth.uid
                    && request.resource.data.ownerId == propertyOwnerId(request.resource.data.propertyId)
                    && (
                      isPropertyOwner(request.resource.data.propertyId)
                      || isPropertyManager(request.resource.data.propertyId)
                      || isPropertyStaffRole(request.resource.data.propertyId, 'caretaker')
                    );

      allow update: if isAuthenticated()
                    && request.resource.data.propertyId == resource.data.propertyId
                    && request.resource.data.ownerId == resource.data.ownerId
                    && (
                      isPropertyOwner(resource.data.propertyId)
                      || isPropertyManager(resource.data.propertyId)
                    );

      allow delete: if isAuthenticated()
                    && (
                      isPropertyOwner(resource.data.propertyId)
                      || isPropertyManager(resource.data.propertyId)
                    );
    }

    // ============================================================
    // METER READINGS (Owner / Manager / Electrician)
    // ============================================================

    match /meterReadings/{readingId} {
      allow get, list: if isAuthenticated()
                       && (
                         isPropertyOwner(resource.data.propertyId)
                         || isPropertyManager(resource.data.propertyId)
                         || isPropertyStaffRole(resource.data.propertyId, 'electrician')
                       );

      allow create: if isAuthenticated()
                    && request.resource.data.propertyId is string
                    && request.resource.data.recordedByUid == request.auth.uid
                    && request.resource.data.ownerId == propertyOwnerId(request.resource.data.propertyId)
                    && (
                      isPropertyOwner(request.resource.data.propertyId)
                      || isPropertyManager(request.resource.data.propertyId)
                      || isPropertyStaffRole(request.resource.data.propertyId, 'electrician')
                    );

      allow update, delete: if false;
    }

    // ============================================================
    // MONTHLY BILLS (SCOPED READ + GUARDRAILED UPDATE)
    // ============================================================

    match /monthlyBills/{monthlyBillId} {
      allow get, list: if isAuthenticated()
                       && (
                         resource.data.ownerId == request.auth.uid
                         || isPropertyManager(resource.data.propertyId)
                         || resource.data.get('tenantUserId', null) == request.auth.uid
                       );

      allow create: if isAuthenticated()
                    && isValidMonthlyBillCreate();

      allow update: if isAuthenticated()
                    && (
                      isValidMonthlyBillCancellation()
                      || isValidMonthlyBillPaymentReservation()
                      || isValidMonthlyBillOwnerPaymentReview()
                    );

      allow delete: if false;
    }

    // ============================================================
    // PAYMENT TRANSACTIONS (STRICT BILL OWNERSHIP VALIDATION)
    // ============================================================

    match /paymentTransactions/{paymentId} {
      allow get, list: if isAuthenticated()
                       && (
                         resource.data.ownerId == request.auth.uid
                         || resource.data.tenantUserId == request.auth.uid
                         || isPropertyManager(resource.data.propertyId)
                       );

      allow create: if isAuthenticated()
                    && request.resource.data.tenantUserId == request.auth.uid
                    && request.resource.data.amount is number
                    && request.resource.data.amount > 0
                    && request.resource.data.status == 'pending'
                    && request.resource.data.billId is string
                    && request.resource.data.billId != ''
                    && isValidTenantPaymentTarget(
                      request.resource.data.billId,
                      request.resource.data.get('billCollection', 'monthlyBills'),
                      request.resource.data.ownerId,
                      request.resource.data.propertyId
                    );

      allow update: if isAuthenticated()
                    && (
                      resource.data.ownerId == request.auth.uid
                      || isPropertyManager(resource.data.propertyId)
                    );

      allow delete: if false;
    }

    // ============================================================
    // BILLING RULES (SCOPED READ)
    // ============================================================

    match /billingRules/{ruleId} {
      allow get, list: if isAuthenticated()
                       && (
                         resource.data.ownerId == request.auth.uid
                         || isPropertyManager(resource.data.propertyId)
                       );

      allow create: if isAuthenticated()
                    && isValidBillingRuleCreate();

      allow update: if isAuthenticated()
                    && isValidBillingRuleUpdate();

      allow delete: if false;
    }

    // ============================================================
    // BILLING RULE — CREATE & UPDATE VALIDATIONS
    // ============================================================

    function isValidBillingRuleCreate() {
      let property = get(
        /databases/$(database)/documents/properties/$(request.resource.data.propertyId)
      ).data;

      return
        (
          (
            request.resource.data.ownerId == request.auth.uid
            && property.ownerId == request.auth.uid
          )
          ||
          (
            isPropertyManager(request.resource.data.propertyId)
            && property.ownerId == request.resource.data.ownerId
          )
        )
        && request.resource.data.ownerId is string
        && request.resource.data.ownerId != ''
        && request.resource.data.propertyId is string
        && request.resource.data.propertyId != ''
        && request.resource.data.scopeId is string
        && request.resource.data.scopeId != ''
        && request.resource.data.scopeType is string
        && request.resource.data.scopeType in [
          'property',
          'floor',
          'unit',
          'tenant'
        ]
        && (
          request.resource.data.scopeType != 'property'
          || request.resource.data.scopeId == request.resource.data.propertyId
        )
        && request.resource.data.chargeType is string
        && request.resource.data.chargeType in [
          'water',
          'gas',
          'garbage',
          'serviceCharge',
          'electricity',
          'other'
        ]
        && request.resource.data.valueType is string
        && request.resource.data.valueType in [
          'fixed',
          'variable'
        ]
        && request.resource.data.amount is number
        && request.resource.data.amount >= 0
        && request.resource.data.effectiveFrom is timestamp
        && (
          request.resource.data.effectiveTo == null
          || (
            request.resource.data.effectiveTo is timestamp
            && request.resource.data.effectiveTo > request.resource.data.effectiveFrom
          )
        )
        && request.resource.data.isActive is bool
        && (
          !request.resource.data.keys().hasAny(['title'])
          || request.resource.data.title == null
          || request.resource.data.title is string
        )
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.createdAt <= request.time
        && request.resource.data.updatedAt <= request.time
        && request.resource.data.updatedAt >= request.resource.data.createdAt
        && (
          request.resource.data.valueType == 'fixed'
          || (
            request.resource.data.valueType == 'variable'
            && request.resource.data.effectiveTo is timestamp
          )
        );
    }

    function isValidBillingRuleUpdate() {
      return
        (
          (
            resource.data.ownerId == request.auth.uid
            && isPropertyOwner(resource.data.propertyId)
          )
          || isPropertyManager(resource.data.propertyId)
        )
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.propertyId == resource.data.propertyId
        && request.resource.data.scopeType == resource.data.scopeType
        && request.resource.data.scopeId == resource.data.scopeId
        && request.resource.data.chargeType == resource.data.chargeType
        && (
          request.resource.data.scopeType != 'property'
          || request.resource.data.scopeId == resource.data.propertyId
        )
        && request.resource.data.valueType == resource.data.valueType
        && request.resource.data.amount is number
        && request.resource.data.amount >= 0
        && request.resource.data.effectiveFrom is timestamp
        && (
          request.resource.data.effectiveTo == null
          || (
            request.resource.data.effectiveTo is timestamp
            && request.resource.data.effectiveTo > request.resource.data.effectiveFrom
          )
        )
        && (
          request.resource.data.valueType == 'fixed'
          || (
            request.resource.data.valueType == 'variable'
            && request.resource.data.effectiveTo is timestamp
          )
        )
        && request.resource.data.isActive is bool
        && (
          !request.resource.data.keys().hasAny(['title'])
          || request.resource.data.title == null
          || request.resource.data.title is string
        )
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt >= resource.data.updatedAt
        && request.resource.data.updatedAt <= request.time;
    }

    // ============================================================
    // MONTHLY BILL — CREATE VALIDATION
    // ============================================================

    function isValidMonthlyBillCreate() {
      let property = get(
        /databases/$(database)/documents/properties/$(request.resource.data.propertyId)
      ).data;

      let tenant = get(
        /databases/$(database)/documents/tenants/$(request.resource.data.tenantId)
      ).data;

      let billingRule = get(
        /databases/$(database)/documents/billingRules/$(request.resource.data.sourceRuleId)
      ).data;

      return
        (
          request.resource.data.ownerId == request.auth.uid
          || isPropertyManager(request.resource.data.propertyId)
        )
        && property.ownerId == request.resource.data.ownerId
        && tenant.ownerId == request.resource.data.ownerId
        && billingRule.ownerId == request.resource.data.ownerId
        && tenant.propertyId == request.resource.data.propertyId
        && tenant.unitId == request.resource.data.unitId
        && (
          (
            tenant.userId is string
            && tenant.userId != ''
            && request.resource.data.tenantUserId == tenant.userId
          )
          ||
          (
            (
              !tenant.keys().hasAny(['userId'])
              || tenant.userId == null
              || (tenant.userId is string && tenant.userId == '')
            )
            && request.resource.data.tenantUserId == null
          )
        )
        && billingRule.propertyId == request.resource.data.propertyId
        && request.resource.data.type != 'rent'
        && billingRule.valueType == request.resource.data.valueType
        && isMatchingMonthlyBillType(
          billingRule.chargeType,
          request.resource.data.type
        )
        && billingRule.effectiveFrom <= request.resource.data.billingPeriodStart
        && (
          billingRule.effectiveTo == null
          || request.resource.data.billingPeriodStart < billingRule.effectiveTo
        )
        && (
          billingRule.isActive == true
          || (
            billingRule.valueType == 'fixed'
            && billingRule.effectiveTo is timestamp
            && request.resource.data.billingPeriodStart < billingRule.effectiveTo
          )
        )
        && isBillingRuleApplicableToMonthlyBill(
          billingRule,
          request.resource.data
        )
        && request.resource.data.propertyId is string
        && request.resource.data.propertyId != ''
        && request.resource.data.floorId is string
        && request.resource.data.floorId != ''
        && request.resource.data.unitId is string
        && request.resource.data.unitId != ''
        && request.resource.data.tenantId is string
        && request.resource.data.tenantId != ''
        && request.resource.data.sourceRuleId is string
        && request.resource.data.sourceRuleId != ''
        && request.resource.data.type is string
        && request.resource.data.type != ''
        && request.resource.data.valueType is string
        && request.resource.data.valueType != ''
        && request.resource.data.billingPeriodStart is timestamp
        && request.resource.data.billingPeriodEnd is timestamp
        && request.resource.data.billingPeriodEnd > request.resource.data.billingPeriodStart
        && request.resource.data.dueDate is timestamp
        && request.resource.data.dueDate >= request.resource.data.billingPeriodStart
        && request.resource.data.amount is number
        && request.resource.data.amount >= 0
        && request.resource.data.paidAmount is number
        && request.resource.data.paidAmount == 0
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && billingRule.amount is number
        && billingRule.amount >= 0
        && request.resource.data.amount == billingRule.amount
        && request.resource.data.status == 'unpaid';
    }

    // ============================================================
    // SECURITY HELPERS
    // ============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function hasVerifiedEmail() {
      return request.auth != null
             && request.auth.token.email is string
             && request.auth.token.email != ''
             && request.auth.token.email_verified == true;
    }

    function isManagerInvitationRecipient(invitation) {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isAuthenticated()
             && (
               invitation.get('managerUserId', null) == request.auth.uid
               || invitation.get('targetUserId', null) == request.auth.uid
               || (
                 invitation.get('phone', null) is string
                 && invitation.get('phone', null) != ''
                 && userDoc.get('phoneNumber', null) == invitation.get('phone', null)
               )
               || (
                 invitation.get('identifier', null) is string
                 && invitation.get('identifier', null) != ''
                 && (
                   userDoc.get('phoneNumber', null) == invitation.get('identifier', null)
                   || userDoc.get('publicId', null) == invitation.get('identifier', null)
                   || (hasVerifiedEmail() && request.auth.token.email == invitation.get('identifier', null))
                 )
               )
               || (
                 invitation.get('targetGrihoId', null) is string
                 && invitation.get('targetGrihoId', null) != ''
                 && userDoc.get('publicId', null) == invitation.get('targetGrihoId', null)
               )
               || (
                 hasVerifiedEmail()
                 && invitation.get('targetEmail', null) is string
                 && invitation.get('targetEmail', null) == request.auth.token.email
               )
             );
    }

    function isValidTenantPaymentTarget(billId, collectionName, ownerId, propertyId) {
      let targetPath = collectionName == 'monthlyRents'
        ? /databases/$(database)/documents/monthlyRents/$(billId)
        : /databases/$(database)/documents/monthlyBills/$(billId);
      let billData = get(targetPath).data;

      return exists(targetPath)
             && billData.get('tenantUserId', null) == request.auth.uid
             && billData.ownerId == ownerId
             && billData.propertyId == propertyId
             && billData.status != 'paid'
             && billData.status != 'cancelled';
    }

    function isUnitTenant(unitId) {
      return isAuthenticated()
             && exists(/databases/$(database)/documents/units/$(unitId))
             && get(/databases/$(database)/documents/units/$(unitId)).data.get('tenantUserId', null) == request.auth.uid;
    }

    function propertyOwnerId(propertyId) {
      return get(/databases/$(database)/documents/properties/$(propertyId)).data.ownerId;
    }

    // Active staff access for ONE specific role on a property.
    // staffAccess document id format: {uid}_{propertyId}_{role}
    function isPropertyStaffRole(propertyId, role) {
      return isAuthenticated()
             && exists(/databases/$(database)/documents/staffAccess/$(request.auth.uid + '_' + propertyId + '_' + role))
             && get(/databases/$(database)/documents/staffAccess/$(request.auth.uid + '_' + propertyId + '_' + role)).data.status == 'active';
    }

    function isPropertyStaff(propertyId) {
      return isPropertyStaffRole(propertyId, 'caretaker')
             || isPropertyStaffRole(propertyId, 'electrician');
    }

    function isStaffInvitationRecipient(invitation) {
      return isAuthenticated()
             && (
               invitation.get('staffUserId', null) == request.auth.uid
               || isManagerInvitationRecipient(invitation)
             );
    }

    // Used when a (previously revoked) manager is assigned again.
    function isValidManagerAccessGrant() {
      let invPath = /databases/$(database)/documents/managerInvitations/$(request.resource.data.invitationId);
      return request.resource.data.invitationId is string
             && get(invPath).data.status == 'pending'
             && get(invPath).data.propertyId == request.resource.data.propertyId
             && get(invPath).data.ownerId == request.resource.data.ownerId
             && isManagerInvitationRecipient(get(invPath).data)
             && getAfter(invPath).data.status == 'accepted'
             && getAfter(invPath).data.managerUserId == request.auth.uid;
    }

    // staffAccess create / re-grant must be bound to a pending invitation
    // addressed to this user that is accepted in the SAME batch.
    function isValidStaffAccessGrant() {
      let invPath = /databases/$(database)/documents/staffInvitations/$(request.resource.data.invitationId);
      return request.resource.data.invitationId is string
             && request.resource.data.ownerId == propertyOwnerId(request.resource.data.propertyId)
             && get(invPath).data.status == 'pending'
             && get(invPath).data.propertyId == request.resource.data.propertyId
             && get(invPath).data.ownerId == request.resource.data.ownerId
             && get(invPath).data.get('staffRole', get(invPath).data.get('role', 'caretaker')) == request.resource.data.staffRole
             && isStaffInvitationRecipient(get(invPath).data)
             && getAfter(invPath).data.status == 'accepted'
             && getAfter(invPath).data.staffUserId == request.auth.uid;
    }

    function isInvitationRecipient(invitation) {
      return isAuthenticated()
             && hasVerifiedEmail()
             && (
               (
                 invitation.get('phone', null) is string
                 && invitation.get('phone', null) != ''
                 && exists(/databases/$(database)/documents/users/$(request.auth.uid))
                 && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('phoneNumber', null)
                    == invitation.get('phone', null)
               )
               ||
               (
                 invitation.get('targetEmail', null) is string
                 && invitation.get('targetEmail', null) != ''
                 && invitation.get('targetEmail', null) == request.auth.token.email
               )
               ||
               (
                 invitation.get('targetGrihoId', null) is string
                 && invitation.get('targetGrihoId', null) != ''
                 && exists(/databases/$(database)/documents/users/$(request.auth.uid))
                 && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('publicId', null)
                    == invitation.get('targetGrihoId', null)
               )
               ||
               (
                 invitation.get('tenantId', null) is string
                 && exists(/databases/$(database)/documents/tenants/$(invitation.tenantId))
                 && get(/databases/$(database)/documents/tenants/$(invitation.tenantId)).data.get('userId', null)
                    == request.auth.uid
               )
             );
    }

    function isPropertyManager(propertyId) {
      return isAuthenticated()
             && exists(/databases/$(database)/documents/managerAccess/$(request.auth.uid + '_' + propertyId))
             && get(/databases/$(database)/documents/managerAccess/$(request.auth.uid + '_' + propertyId)).data.status == 'active';
    }

    function isPropertyOwner(propertyId) {
      return exists(/databases/$(database)/documents/properties/$(propertyId))
             && get(/databases/$(database)/documents/properties/$(propertyId)).data.ownerId == request.auth.uid;
    }

    function isMatchingMonthlyBillType(chargeType, billType) {
      return
        (chargeType == 'water' && billType == 'water')
        || (chargeType == 'gas' && billType == 'gas')
        || (chargeType == 'garbage' && billType == 'garbage')
        || (chargeType == 'serviceCharge' && billType == 'serviceCharge')
        || (chargeType == 'electricity' && billType == 'electricity')
        || (chargeType == 'other' && billType == 'other');
    }

    function isBillingRuleApplicableToMonthlyBill(rule, bill) {
      return
        (rule.scopeType == 'property' && rule.scopeId == bill.propertyId)
        || (rule.scopeType == 'floor' && rule.scopeId == bill.floorId)
        || (rule.scopeType == 'unit' && rule.scopeId == bill.unitId)
        || (rule.scopeType == 'tenant' && rule.scopeId == bill.tenantId);
    }

    function isValidMonthlyBillCancellation() {
      return isAuthenticated()
        && (
          (
            resource.data.ownerId == request.auth.uid
            && isPropertyOwner(resource.data.propertyId)
          )
          || isPropertyManager(resource.data.propertyId)
        )
        && resource.data.status != 'paid'
        && resource.data.status != 'cancelled'
        && resource.data.paidAmount is number
        && resource.data.paidAmount == 0
        && resource.data.get('pendingPaymentAmount', 0) == 0
        && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly(['status', 'updatedAt'])
        && request.resource.data.status == 'cancelled'
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt >= resource.data.updatedAt
        && request.resource.data.updatedAt <= request.time;
    }

    function isValidMonthlyBillPaymentReservation() {
      let diff = request.resource.data.diff(resource.data);
      return resource.data.tenantUserId == request.auth.uid
             && resource.data.status != 'paid'
             && resource.data.status != 'cancelled'
             && diff.affectedKeys().hasOnly(['pendingPaymentAmount', 'updatedAt'])
             && request.resource.data.pendingPaymentAmount > resource.data.get('pendingPaymentAmount', 0)
             && request.resource.data.updatedAt is timestamp
             && request.resource.data.updatedAt <= request.time;
    }

    function isValidMonthlyBillOwnerPaymentReview() {
      let diff = request.resource.data.diff(resource.data);
      return (
               resource.data.ownerId == request.auth.uid
               || isPropertyManager(resource.data.propertyId)
             )
             && resource.data.status != 'cancelled'
             && diff.affectedKeys().hasOnly([
               'paidAmount',
               'pendingPaymentAmount',
               'status',
               'updatedAt',
               'lastPaymentId'
             ])
             && request.resource.data.get('paidAmount', 0) >= resource.data.get('paidAmount', 0)
             && request.resource.data.get('pendingPaymentAmount', 0) >= 0
             && request.resource.data.status in ['unpaid', 'partiallyPaid', 'paid']
             && request.resource.data.updatedAt is timestamp;
    }

    // ============================================================
    // TENANCY LIFECYCLE & RENT VALIDATION HELPERS
    // ============================================================

    function isValidTenantAcceptance(ownerId, propertyId, unitId) {
      let access = getAfter(
        /databases/$(database)/documents/tenantAccess/$(request.auth.uid)
      ).data;

      return access.userId == request.auth.uid
             && access.ownerId == (ownerId == null ? access.ownerId : ownerId)
             && (propertyId == null || access.propertyId == propertyId)
             && (unitId == null || access.unitId == unitId);
    }

    function isValidInvitationTenantAccess() {
      let tenantAfter = getAfter(
        /databases/$(database)/documents/tenants/$(request.resource.data.tenantId)
      ).data;

      let invitationAfter = getAfter(
        /databases/$(database)/documents/tenantInvitations/$(request.resource.data.invitationId)
      ).data;

      return tenantAfter.userId == request.auth.uid
             && tenantAfter.ownerId == request.resource.data.ownerId
             && tenantAfter.propertyId == request.resource.data.propertyId
             && tenantAfter.unitId == request.resource.data.unitId
             && invitationAfter.status == 'accepted'
             && invitationAfter.tenantId == request.resource.data.tenantId
             && invitationAfter.propertyId == request.resource.data.propertyId
             && invitationAfter.unitId == request.resource.data.unitId
             && invitationAfter.ownerId == request.resource.data.ownerId;
    }

    function isValidLinkedTenantInvitationAcceptance(tenantId) {
      let accessAfter = getAfter(
        /databases/$(database)/documents/tenantAccess/$(request.auth.uid)
      ).data;

      let invitationAfter = getAfter(
        /databases/$(database)/documents/tenantInvitations/$(accessAfter.invitationId)
      ).data;

      let tenantAfter = getAfter(
        /databases/$(database)/documents/tenants/$(tenantId)
      ).data;

      return accessAfter.userId == request.auth.uid
        && accessAfter.tenantId == tenantId
        && accessAfter.ownerId == resource.data.ownerId
        && accessAfter.propertyId == resource.data.propertyId
        && accessAfter.unitId == resource.data.unitId
        && accessAfter.invitationId is string
        && accessAfter.invitationId != ''
        && invitationAfter.status == 'accepted'
        && invitationAfter.tenantId == tenantId
        && invitationAfter.ownerId == resource.data.ownerId
        && invitationAfter.propertyId == resource.data.propertyId
        && invitationAfter.unitId == resource.data.unitId
        && tenantAfter.userId == request.auth.uid
        && tenantAfter.ownerId == resource.data.ownerId
        && tenantAfter.propertyId == resource.data.propertyId
        && tenantAfter.unitId == resource.data.unitId
        && tenantAfter.status == 'active'
        && tenantAfter.accountStatus == resource.data.accountStatus
        && tenantAfter.confirmationStatus == 'confirmed'
        && tenantAfter.tenancyStartedAt is timestamp;
    }

    function isUnitUnassigned(unitData) {
      return !unitData.keys().hasAny(['tenantUserId'])
             || unitData.tenantUserId == null
             || (unitData.tenantUserId is string && unitData.tenantUserId == '');
    }

    function isValidOwnerStartNewTenancyAccess() {
      let tenantBefore = get(
        /databases/$(database)/documents/tenants/$(request.resource.data.tenantId)
      ).data;

      let tenantAfter = getAfter(
        /databases/$(database)/documents/tenants/$(request.resource.data.tenantId)
      ).data;

      let propertyAfter = getAfter(
        /databases/$(database)/documents/properties/$(request.resource.data.propertyId)
      ).data;

      let unitBefore = get(
        /databases/$(database)/documents/units/$(request.resource.data.unitId)
      ).data;

      let unitAfter = getAfter(
        /databases/$(database)/documents/units/$(request.resource.data.unitId)
      ).data;

      return request.resource.data.invitationId == null
             && request.resource.data.userId is string
             && request.resource.data.userId != ''
             && tenantBefore.ownerId == request.auth.uid
             && tenantBefore.status == 'inactive'
             && tenantBefore.accountStatus == 'registered'
             && tenantBefore.userId is string
             && tenantBefore.userId == request.resource.data.userId
             && tenantAfter.userId == request.resource.data.userId
             && tenantAfter.ownerId == request.auth.uid
             && tenantAfter.status == 'active'
             && tenantAfter.accountStatus == 'registered'
             && tenantAfter.propertyId == request.resource.data.propertyId
             && tenantAfter.unitId == request.resource.data.unitId
             && unitBefore.propertyId == request.resource.data.propertyId
             && unitBefore.status == 'available'
             && isUnitUnassigned(unitBefore)
             && propertyAfter.ownerId == request.auth.uid
             && propertyAfter.tenantUserIds is list
             && request.resource.data.userId in propertyAfter.tenantUserIds
             && unitAfter.propertyId == request.resource.data.propertyId
             && unitAfter.status == 'occupied'
             && unitAfter.tenantUserId == request.resource.data.userId;
    }

    function isValidOwnerStartNewTenancyTenant(tenantId) {
      let tenantBefore = get(
        /databases/$(database)/documents/tenants/$(tenantId)
      ).data;

      let propertyAfter = getAfter(
        /databases/$(database)/documents/properties/$(request.resource.data.propertyId)
      ).data;

      let unitAfter = getAfter(
        /databases/$(database)/documents/units/$(request.resource.data.unitId)
      ).data;

      let accessAfter = getAfter(
        /databases/$(database)/documents/tenantAccess/$(request.resource.data.userId)
      ).data;

      return tenantBefore.ownerId == request.auth.uid
             && tenantBefore.status == 'inactive'
             && tenantBefore.accountStatus == 'registered'
             && tenantBefore.userId is string
             && tenantBefore.userId == request.resource.data.userId
             && propertyAfter.ownerId == request.auth.uid
             && propertyAfter.tenantUserIds is list
             && request.resource.data.userId in propertyAfter.tenantUserIds
             && unitAfter.propertyId == request.resource.data.propertyId
             && unitAfter.status == 'occupied'
             && unitAfter.tenantUserId == request.resource.data.userId
             && accessAfter.userId == request.resource.data.userId
             && accessAfter.tenantId == tenantId
             && accessAfter.ownerId == request.auth.uid
             && accessAfter.propertyId == request.resource.data.propertyId
             && accessAfter.unitId == request.resource.data.unitId
             && accessAfter.invitationId == null;
    }

    function isValidOwnerEndTenancy() {
      let propertyAfter = getAfter(
        /databases/$(database)/documents/properties/$(request.resource.data.propertyId)
      ).data;

      let unitAfter = getAfter(
        /databases/$(database)/documents/units/$(request.resource.data.unitId)
      ).data;

      return (
               propertyAfter.ownerId == request.auth.uid
               || isPropertyManager(request.resource.data.propertyId)
             )
             && propertyAfter.tenantUserIds is list
             && !(request.resource.data.userId in propertyAfter.tenantUserIds)
             && unitAfter.propertyId == request.resource.data.propertyId
             && unitAfter.status == 'available'
             && isUnitUnassigned(unitAfter)
             && !existsAfter(
                  /databases/$(database)/documents/tenantAccess/$(request.resource.data.userId)
                );
    }

    function isValidOwnerEndTenancyAccessDelete() {
      let tenantAfter = getAfter(
        /databases/$(database)/documents/tenants/$(resource.data.tenantId)
      ).data;

      return (
               tenantAfter.ownerId == request.auth.uid
               || isPropertyManager(resource.data.propertyId)
             )
             && tenantAfter.userId == resource.data.userId
             && tenantAfter.propertyId == resource.data.propertyId
             && tenantAfter.unitId == resource.data.unitId
             && tenantAfter.status == 'inactive';
    }

    function isValidOwnerEndTenancyHistory() {
      let tenantAfter = getAfter(
        /databases/$(database)/documents/tenants/$(request.resource.data.tenantId)
      ).data;

      let propertyAfter = getAfter(
        /databases/$(database)/documents/properties/$(request.resource.data.propertyId)
      ).data;

      let unitAfter = getAfter(
        /databases/$(database)/documents/units/$(request.resource.data.unitId)
      ).data;

      return isAuthenticated()
        && request.resource.data.tenantId is string
        && request.resource.data.tenantId != ''
        && (
          request.resource.data.ownerId == request.auth.uid
          || isPropertyManager(request.resource.data.propertyId)
        )
        && tenantAfter.ownerId == request.resource.data.ownerId
        && tenantAfter.status == 'inactive'
        && tenantAfter.propertyId == request.resource.data.propertyId
        && tenantAfter.unitId == request.resource.data.unitId
        && request.resource.data.tenantName == tenantAfter.name
        && tenantAfter.tenancyStartedAt != null
        && request.resource.data.startedAt == tenantAfter.tenancyStartedAt
        && request.resource.data.endedAt is timestamp
        && request.resource.data.startedAt is timestamp
        && request.resource.data.endedAt >= request.resource.data.startedAt
        && request.resource.data.endedAt <= request.time
        && request.resource.data.status == 'ended'
        && request.resource.data.monthlyRent is number
        && request.resource.data.monthlyRent > 0
        && propertyAfter.ownerId == request.resource.data.ownerId
        && request.resource.data.propertyName == propertyAfter.name
        && request.resource.data.propertyCode == propertyAfter.propertyCode
        && unitAfter.propertyId == request.resource.data.propertyId
        && request.resource.data.unitNumber == unitAfter.unitNumber
        && request.resource.data.floorNumber == unitAfter.floorNumber
        && unitAfter.status == 'available'
        && isUnitUnassigned(unitAfter)
        && request.resource.data.createdAt == request.time;
    }

    function isValidInitialRentRateCreate() {
      return isValidOwnerInitialRentRateCreate()
             || isValidInvitationInitialRentRateCreate();
    }

    function isValidOwnerInitialRentRateCreate() {
      let unitAfter = getAfter(
        /databases/$(database)/documents/units/$(request.resource.data.unitId)
      ).data;

      let accessAfter = getAfter(
        /databases/$(database)/documents/tenantAccess/$(unitAfter.tenantUserId)
      ).data;

      let tenantAfter = getAfter(
        /databases/$(database)/documents/tenants/$(accessAfter.tenantId)
      ).data;

      let propertyAfter = getAfter(
        /databases/$(database)/documents/properties/$(request.resource.data.propertyId)
      ).data;

      return request.auth.uid == request.resource.data.ownerId
        && request.resource.data.source == 'initial'
        && unitAfter.propertyId == request.resource.data.propertyId
        && unitAfter.status == 'occupied'
        && unitAfter.tenantUserId is string
        && unitAfter.tenantUserId != ''
        && accessAfter.userId == unitAfter.tenantUserId
        && accessAfter.ownerId == request.auth.uid
        && accessAfter.propertyId == request.resource.data.propertyId
        && accessAfter.unitId == request.resource.data.unitId
        && accessAfter.invitationId == null
        && tenantAfter.ownerId == request.auth.uid
        && tenantAfter.userId == unitAfter.tenantUserId
        && tenantAfter.status == 'active'
        && tenantAfter.propertyId == request.resource.data.propertyId
        && tenantAfter.unitId == request.resource.data.unitId
        && tenantAfter.tenancyStartedAt is timestamp
        && request.resource.data.effectiveFrom == tenantAfter.tenancyStartedAt
        && propertyAfter.ownerId == request.auth.uid
        && propertyAfter.tenantUserIds is list
        && unitAfter.tenantUserId in propertyAfter.tenantUserIds;
    }

    function isValidInvitationInitialRentRateCreate() {
      let unitAfter = getAfter(
        /databases/$(database)/documents/units/$(request.resource.data.unitId)
      ).data;

      let accessAfter = getAfter(
        /databases/$(database)/documents/tenantAccess/$(request.auth.uid)
      ).data;

      let tenantAfter = getAfter(
        /databases/$(database)/documents/tenants/$(accessAfter.tenantId)
      ).data;

      let invitationAfter = getAfter(
        /databases/$(database)/documents/tenantInvitations/$(accessAfter.invitationId)
      ).data;

      let propertyAfter = getAfter(
        /databases/$(database)/documents/properties/$(request.resource.data.propertyId)
      ).data;

      return request.auth.uid == unitAfter.tenantUserId
        && request.auth.uid != request.resource.data.ownerId
        && request.resource.data.source in ['initial', 'unit']
        && unitAfter.propertyId == request.resource.data.propertyId
        && unitAfter.status == 'occupied'
        && unitAfter.tenantUserId == request.auth.uid
        && accessAfter.userId == request.auth.uid
        && accessAfter.ownerId == request.resource.data.ownerId
        && accessAfter.propertyId == request.resource.data.propertyId
        && accessAfter.unitId == request.resource.data.unitId
        && accessAfter.invitationId is string
        && accessAfter.invitationId != ''
        && tenantAfter.userId == request.auth.uid
        && tenantAfter.ownerId == request.resource.data.ownerId
        && tenantAfter.status == 'active'
        && tenantAfter.propertyId == request.resource.data.propertyId
        && tenantAfter.unitId == request.resource.data.unitId
        && tenantAfter.tenancyStartedAt is timestamp
        && request.resource.data.effectiveFrom == tenantAfter.tenancyStartedAt
        && invitationAfter.status == 'accepted'
        && invitationAfter.ownerId == request.resource.data.ownerId
        && invitationAfter.tenantId == accessAfter.tenantId
        && invitationAfter.propertyId == request.resource.data.propertyId
        && invitationAfter.unitId == request.resource.data.unitId
        && invitationAfter.rentAmount is number
        && invitationAfter.rentAmount > 0
        && request.resource.data.amount == invitationAfter.rentAmount
        && propertyAfter.ownerId == request.resource.data.ownerId;
    }

    function isValidChangedRentRateCreate() {
      let previousRateBefore = get(
        /databases/$(database)/documents/rentRates/$(request.resource.data.previousRentRateId)
      ).data;

      let previousRateAfter = getAfter(
        /databases/$(database)/documents/rentRates/$(request.resource.data.previousRentRateId)
      ).data;

      let unitAfter = getAfter(
        /databases/$(database)/documents/units/$(request.resource.data.unitId)
      ).data;

      let propertyAfter = getAfter(
        /databases/$(database)/documents/properties/$(request.resource.data.propertyId)
      ).data;

      return
        (
          request.auth.uid == request.resource.data.ownerId
          || isPropertyManager(request.resource.data.propertyId)
        )
        && request.resource.data.source in [
          'property',
          'floor',
          'unit'
        ]
        && request.resource.data.previousRentRateId is string
        && request.resource.data.previousRentRateId != ''
        && request.resource.data.previousRentRateId != request.resource.id
        && previousRateBefore.ownerId == request.resource.data.ownerId
        && previousRateBefore.propertyId == request.resource.data.propertyId
        && previousRateBefore.unitId == request.resource.data.unitId
        && previousRateBefore.effectiveTo == null
        && previousRateAfter.ownerId == request.resource.data.ownerId
        && previousRateAfter.propertyId == request.resource.data.propertyId
        && previousRateAfter.unitId == request.resource.data.unitId
        && previousRateAfter.effectiveTo is timestamp
        && previousRateAfter.effectiveTo >= previousRateAfter.effectiveFrom
        && previousRateAfter.effectiveTo <= request.resource.data.effectiveFrom
        && previousRateAfter.nextRentRateId == request.resource.id
        && request.resource.data.ownerId == previousRateBefore.ownerId
        && request.resource.data.propertyId == previousRateBefore.propertyId
        && request.resource.data.unitId == previousRateBefore.unitId
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.effectiveFrom is timestamp
        && request.resource.data.effectiveFrom > previousRateBefore.effectiveFrom
        && request.resource.data.effectiveTo == null
        && unitAfter.propertyId == request.resource.data.propertyId
        && propertyAfter.ownerId == request.resource.data.ownerId
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.createdAt <= request.time
        && request.resource.data.updatedAt <= request.time;
    }

    function isValidEndTenancyRentRateClose() {
      let unitBefore = get(
        /databases/$(database)/documents/units/$(resource.data.unitId)
      ).data;

      let unitAfter = getAfter(
        /databases/$(database)/documents/units/$(resource.data.unitId)
      ).data;

      let propertyAfter = getAfter(
        /databases/$(database)/documents/properties/$(resource.data.propertyId)
      ).data;

      return
        (
          resource.data.ownerId == request.auth.uid
          || isPropertyManager(resource.data.propertyId)
        )
        && unitBefore.propertyId == resource.data.propertyId
        && unitBefore.status == 'occupied'
        && unitBefore.tenantUserId is string
        && unitBefore.tenantUserId != ''
        && propertyAfter.ownerId == resource.data.ownerId
        && propertyAfter.tenantUserIds is list
        && !(unitBefore.tenantUserId in propertyAfter.tenantUserIds)
        && unitAfter.propertyId == resource.data.propertyId
        && unitAfter.status == 'available'
        && isUnitUnassigned(unitAfter)
        && !existsAfter(
          /databases/$(database)/documents/tenantAccess/$(unitBefore.tenantUserId)
        )
        && request.resource.data.effectiveTo <= request.time
        && request.resource.data.effectiveTo >= resource.data.effectiveFrom;
    }

    function isValidChangedRentRateClose() {
      let unit = get(
        /databases/$(database)/documents/units/$(resource.data.unitId)
      ).data;

      let property = get(
        /databases/$(database)/documents/properties/$(resource.data.propertyId)
      ).data;

      let nextRate = getAfter(
        /databases/$(database)/documents/rentRates/$(request.resource.data.nextRentRateId)
      ).data;

      return
        (
          property.ownerId == request.auth.uid
          || isPropertyManager(resource.data.propertyId)
        )
        && property.ownerId == resource.data.ownerId
        && unit.propertyId == resource.data.propertyId
        && request.resource.data.nextRentRateId is string
        && request.resource.data.nextRentRateId != ''
        && request.resource.data.nextRentRateId != resource.id
        && request.resource.data.effectiveTo is timestamp
        && request.resource.data.effectiveTo >= resource.data.effectiveFrom
        && request.resource.data.effectiveTo <= nextRate.effectiveFrom
        && nextRate.previousRentRateId == resource.id
        && nextRate.ownerId == resource.data.ownerId
        && nextRate.propertyId == resource.data.propertyId
        && nextRate.unitId == resource.data.unitId
        && nextRate.effectiveFrom is timestamp
        && nextRate.effectiveFrom > resource.data.effectiveFrom
        && nextRate.effectiveTo == null
        && (
          !nextRate.keys().hasAny(['nextRentRateId'])
          || nextRate.nextRentRateId == null
        )
        && nextRate.amount is number
        && nextRate.amount > 0
        && nextRate.createdAt is timestamp
        && nextRate.updatedAt is timestamp
        && nextRate.createdAt <= request.time
        && nextRate.updatedAt <= request.time;
    }

    function isValidMonthlyRentCreate() {
      let property = get(
        /databases/$(database)/documents/properties/$(request.resource.data.propertyId)
      ).data;

      let unit = get(
        /databases/$(database)/documents/units/$(request.resource.data.unitId)
      ).data;

      let tenant = get(
        /databases/$(database)/documents/tenants/$(request.resource.data.tenantId)
      ).data;

      let rentRate = get(
        /databases/$(database)/documents/rentRates/$(request.resource.data.rentRateId)
      ).data;

      return
        (
          request.resource.data.ownerId == request.auth.uid
          || isPropertyManager(request.resource.data.propertyId)
        )
        && property.ownerId == request.resource.data.ownerId
        && tenant.ownerId == request.resource.data.ownerId
        && rentRate.ownerId == request.resource.data.ownerId
        && tenant.propertyId == request.resource.data.propertyId
        && unit.propertyId == request.resource.data.propertyId
        && rentRate.propertyId == request.resource.data.propertyId
        && tenant.unitId == request.resource.data.unitId
        && rentRate.unitId == request.resource.data.unitId
        && unit.status == 'occupied'
        && tenant.status == 'active'
        && (
          (
            tenant.userId is string
            && tenant.userId != ''
            && unit.tenantUserId == tenant.userId
            && request.resource.data.tenantUserId == tenant.userId
          )
          ||
          (
            (!tenant.keys().hasAny(['userId']) || tenant.userId == null || tenant.userId == '')
            && request.resource.data.tenantUserId == null
          )
        )
        && rentRate.effectiveFrom <= request.resource.data.billingPeriodStart
        && (
          rentRate.effectiveTo == null
          || request.resource.data.billingPeriodStart < rentRate.effectiveTo
        )
        && request.resource.data.rentRateId is string
        && request.resource.data.rentRateId != ''
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount <= rentRate.amount
        && request.resource.data.billingPeriodStart is timestamp
        && request.resource.data.billingPeriodEnd is timestamp
        && request.resource.data.billingPeriodEnd > request.resource.data.billingPeriodStart
        && request.resource.data.dueDate is timestamp
        && request.resource.data.dueDate >= request.resource.data.billingPeriodStart
        && request.resource.data.status == 'unpaid'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function isValidOwnerCreateRent() {
      let property = get(
        /databases/$(database)/documents/properties/$(request.resource.data.propertyId)
      ).data;

      let unit = get(
        /databases/$(database)/documents/units/$(request.resource.data.unitId)
      ).data;

      let tenant = get(
        /databases/$(database)/documents/tenants/$(request.resource.data.tenantId)
      ).data;

      return
        (
          request.resource.data.ownerId == request.auth.uid
          || isPropertyManager(request.resource.data.propertyId)
        )
        && property.ownerId == request.resource.data.ownerId
        && tenant.ownerId == request.resource.data.ownerId
        && tenant.propertyId == request.resource.data.propertyId
        && unit.propertyId == request.resource.data.propertyId
        && unit.status == 'occupied'
        && tenant.status == 'active'
        && tenant.unitId == request.resource.data.unitId
        && (
          (
            tenant.userId is string
            && tenant.userId != ''
            && request.resource.data.tenantUserId == tenant.userId
            && unit.tenantUserId == tenant.userId
          )
          ||
          (
            (
              !tenant.keys().hasAny(['userId'])
              || tenant.userId == null
              || (tenant.userId is string && tenant.userId == '')
            )
            && request.resource.data.tenantUserId == null
            && isUnitUnassigned(unit)
          )
        )
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.billingPeriodStart is timestamp
        && request.resource.data.billingPropertyId is string
        && request.resource.data.billingPeriodEnd is timestamp
        && request.resource.data.billingPeriodStart <= request.resource.data.billingPeriodEnd
        && request.resource.data.dueDate is timestamp
        && request.resource.data.dueDate >= request.resource.data.billingPeriodStart
        && request.resource.data.status == 'unpaid'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt == request.resource.data.createdAt;
    }
  }
}
