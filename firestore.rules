rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // USER PROFILE
    // ============================================================

    match /users/{userId} {

      allow get: if isAuthenticated()
                 && request.auth.uid == userId;

      allow create: if isAuthenticated()
                    && request.auth.uid == userId
                    && request.resource.data.uid == request.auth.uid;

      allow update: if isAuthenticated()
                    && request.auth.uid == userId
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.publicId == resource.data.publicId
                    && request.resource.data.role == resource.data.role
                    && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if false;
    }


    // ============================================================
    // GRIHO PUBLIC ID RESERVATIONS
    // ============================================================

    match /public_ids/{publicId} {

      allow get: if isAuthenticated();

      allow create: if isAuthenticated()
                    && request.resource.data.publicId == publicId
                    && request.resource.data.createdBy == request.auth.uid;

      allow update: if false;

      allow delete: if isAuthenticated()
                    && resource.data.createdBy == request.auth.uid;
    }


    // ============================================================
    // PROPERTIES
    // ============================================================

    match /properties/{propertyId} {

      allow read: if isAuthenticated()
                  && resource.data.ownerId == request.auth.uid;

      allow create: if isAuthenticated()
                    && request.resource.data.ownerId == request.auth.uid;

      allow update: if isAuthenticated()
                    && resource.data.ownerId == request.auth.uid
                    && request.resource.data.ownerId
                       == resource.data.ownerId;

      allow delete: if isAuthenticated()
                    && resource.data.ownerId == request.auth.uid;
    }


    // ============================================================
    // UNITS
    // ============================================================

    match /units/{unitId} {

      allow read: if isAuthenticated()
                  && isPropertyOwner(
                    resource.data.propertyId
                  );

      allow create: if isAuthenticated()
                    && isPropertyOwner(
                      request.resource.data.propertyId
                    );

      allow update: if isAuthenticated()
                    && isPropertyOwner(
                      resource.data.propertyId
                    )
                    && isPropertyOwner(
                      request.resource.data.propertyId
                    );

      allow delete: if isAuthenticated()
                    && isPropertyOwner(
                      resource.data.propertyId
                    );
    }


    // ============================================================
    // TENANTS
    // ============================================================

    match /tenants/{tenantId} {

      // Owner can read tenants from their own properties.
      allow read: if isAuthenticated()
                  && isPropertyOwner(
                    resource.data.propertyId
                  );

      // Owner can add tenants to their own properties.
      allow create: if isAuthenticated()
                    && isPropertyOwner(
                      request.resource.data.propertyId
                    );

      // Owner can update tenants belonging to their own property.
      allow update: if isAuthenticated()
                    && isPropertyOwner(
                      resource.data.propertyId
                    )
                    && isPropertyOwner(
                      request.resource.data.propertyId
                    );

      // Owner can delete tenants from their own property.
      allow delete: if isAuthenticated()
                    && isPropertyOwner(
                      resource.data.propertyId
                    );
    }


    // ============================================================
    // SECURITY HELPERS
    // ============================================================

    function isAuthenticated() {
      return request.auth != null;
    }


    function isPropertyOwner(propertyId) {
      return exists(
        /databases/$(database)/documents/properties/$(propertyId)
      )
      && get(
        /databases/$(database)/documents/properties/$(propertyId)
      ).data.ownerId == request.auth.uid;
    }
  }
}