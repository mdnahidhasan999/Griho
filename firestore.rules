rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // USERS
    match /users/{userId} {

      allow get: if isAuthenticated()
                 && request.auth.uid == userId;

      allow create: if isAuthenticated()
                    && request.auth.uid == userId
                    && request.resource.data.uid == request.auth.uid;

      allow update: if isAuthenticated()
                    && request.auth.uid == userId
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.publicId == resource.data.publicId
                    && request.resource.data.role == resource.data.role
                    && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if false;
    }


  // ============================================================
  // PHONE LOOKUPS
  // ============================================================

  match /phone_lookups/{phoneNumber} {

    // Any authenticated user can search a phone number.
    allow get: if isAuthenticated();

    // Phone lookup documents are created together with user
    // profile creation.
    allow create: if isAuthenticated()
                  && request.resource.data.uid == request.auth.uid
                  && request.resource.data.phoneNumber == phoneNumber;

    // User can update their own lookup.
    allow update: if isAuthenticated()
                  && resource.data.uid == request.auth.uid
                  && request.resource.data.uid == request.auth.uid
                  && request.resource.data.phoneNumber == phoneNumber;

    // User can delete their own lookup.
    allow delete: if isAuthenticated()
                  && resource.data.uid == request.auth.uid;
  }

    // PUBLIC IDS
    match /public_ids/{publicId} {

      allow get: if isAuthenticated();

      allow create: if isAuthenticated()
                    && request.resource.data.publicId == publicId
                    && request.resource.data.createdBy == request.auth.uid;

      allow update: if false;

      allow delete: if isAuthenticated()
                    && resource.data.createdBy == request.auth.uid;
    }


    // PROPERTIES
    match /properties/{propertyId} {

      allow read: if isAuthenticated()
                  && resource.data.ownerId == request.auth.uid;

      allow create: if isAuthenticated()
                    && request.resource.data.ownerId == request.auth.uid;

      allow update: if isAuthenticated()
                    && resource.data.ownerId == request.auth.uid
                    && request.resource.data.ownerId
                       == resource.data.ownerId;

      allow delete: if isAuthenticated()
                    && resource.data.ownerId == request.auth.uid;
    }


    // UNITS
    match /units/{unitId} {

      allow read: if isAuthenticated()
                  && isPropertyOwner(
                    resource.data.propertyId
                  );

      allow create: if isAuthenticated()
                    && isPropertyOwner(
                      request.resource.data.propertyId
                    );

      allow update: if isAuthenticated()
                    && isPropertyOwner(
                      resource.data.propertyId
                    )
                    && isPropertyOwner(
                      request.resource.data.propertyId
                    );

      allow delete: if isAuthenticated()
                    && isPropertyOwner(
                      resource.data.propertyId
                    );
    }


// TENANTS
match /tenants/{tenantId} {

  // ------------------------------------------------------------
  // READ
  //
  // Owner can read tenants that belong to their ownership.
  // This also allows searching a previously added tenant
  // by ownerId + phone.
  // ------------------------------------------------------------
  allow read: if isAuthenticated()
              && resource.data.ownerId == request.auth.uid;

  // ------------------------------------------------------------
  // CREATE
  //
  // Tenant must be created by the owner of the property.
  // ownerId must also match the authenticated user.
  // ------------------------------------------------------------
  allow create: if isAuthenticated()
                && request.resource.data.ownerId == request.auth.uid
                && isPropertyOwner(
                  request.resource.data.propertyId
                );

  // ------------------------------------------------------------
  // UPDATE
  //
  // Existing tenant must belong to current owner.
  // New ownerId cannot be changed.
  // New property must also belong to current owner.
  // ------------------------------------------------------------
  allow update: if isAuthenticated()
                && resource.data.ownerId == request.auth.uid
                && request.resource.data.ownerId == resource.data.ownerId
                && isPropertyOwner(
                  request.resource.data.propertyId
                );

  // ------------------------------------------------------------
  // DELETE
  // ------------------------------------------------------------
  allow delete: if isAuthenticated()
                && resource.data.ownerId == request.auth.uid;
}


    // SECURITY HELPERS

    function isAuthenticated() {
      return request.auth != null;
    }

    function isPropertyOwner(propertyId) {
      return exists(
        /databases/$(database)/documents/properties/$(propertyId)
      )
      && get(
        /databases/$(database)/documents/properties/$(propertyId)
      ).data.ownerId == request.auth.uid;
    }
  }
}