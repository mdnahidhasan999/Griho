rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // USERS
    // ============================================================

    match /users/{userId} {

      allow get: if isAuthenticated()
                 && request.auth.uid == userId;

      allow create: if isAuthenticated()
                    && request.auth.uid == userId
                    && request.resource.data.uid
                       == request.auth.uid;

      allow update: if isAuthenticated()
                    && request.auth.uid == userId
                    && request.resource.data.uid
                       == resource.data.uid
                    && request.resource.data.publicId
                       == resource.data.publicId
                    && request.resource.data.role
                       == resource.data.role
                    && request.resource.data.createdAt
                       == resource.data.createdAt;

      allow delete: if false;
    }


    // ============================================================
    // PHONE LOOKUPS
    // ============================================================

    match /phone_lookups/{phoneNumber} {

      allow get: if isAuthenticated();

      allow create: if isAuthenticated()
                    && request.resource.data.uid
                       == request.auth.uid
                    && request.resource.data.phoneNumber
                       == phoneNumber;

      allow update: if isAuthenticated()
                    && resource.data.uid
                       == request.auth.uid
                    && request.resource.data.uid
                       == resource.data.uid
                    && request.resource.data.phoneNumber
                       == resource.data.phoneNumber
                    && request.resource.data.publicId
                       == resource.data.publicId;

      allow delete: if isAuthenticated()
                    && resource.data.uid
                       == request.auth.uid;
    }


    // ============================================================
    // PUBLIC IDS
    // ============================================================

    match /public_ids/{publicId} {

      allow get: if isAuthenticated();

      allow create: if isAuthenticated()
                    && request.resource.data.publicId
                       == publicId
                    && request.resource.data.uid
                       == request.auth.uid
                    && request.resource.data.createdBy
                       == request.auth.uid;

      allow update: if isAuthenticated()
                    && resource.data.uid
                       == request.auth.uid
                    && resource.data.createdBy
                       == request.auth.uid
                    && request.resource.data.publicId
                       == resource.data.publicId
                    && request.resource.data.uid
                       == resource.data.uid
                    && request.resource.data.createdBy
                       == resource.data.createdBy;

      allow delete: if isAuthenticated()
                    && resource.data.createdBy
                       == request.auth.uid;
    }


    // ============================================================
    // PROPERTIES
    // ============================================================

    match /properties/{propertyId} {

      // ----------------------------------------------------------
      // READ
      // Owner OR assigned tenant
      // ----------------------------------------------------------

      allow read: if isAuthenticated()
                  && (
                    resource.data.ownerId
                       == request.auth.uid

                    ||

                    (
                      resource.data.tenantUserIds is list
                      &&
                      request.auth.uid
                         in resource.data.tenantUserIds
                    )
                  );


      // ----------------------------------------------------------
      // CREATE
      // ----------------------------------------------------------

      allow create: if isAuthenticated()
                    && request.resource.data.ownerId
                       == request.auth.uid;


      // ----------------------------------------------------------
      // UPDATE
      // ----------------------------------------------------------

      allow update: if isAuthenticated()
                    && (

                      // ==========================================
                      // OWNER
                      // ==========================================

                      (
                        resource.data.ownerId
                           == request.auth.uid

                        &&
                        request.resource.data.ownerId
                           == resource.data.ownerId
                      )

                      ||

                      // ==========================================
                      // TENANT ACCEPTANCE — FIRST ACCESS
                      // ==========================================

                      (
                        !resource.data.keys()
                          .hasAny(['tenantUserIds'])

                        &&
                        request.resource.data.tenantUserIds is list

                        &&
                        request.resource.data.tenantUserIds.size()
                           == 1

                        &&
                        request.auth.uid
                           in request.resource.data.tenantUserIds

                        &&
                        request.resource.data.ownerId
                           == resource.data.ownerId

                        &&
                        request.resource.data.name
                           == resource.data.name

                        &&
                        request.resource.data.propertyCode
                           == resource.data.propertyCode

                        &&
                        request.resource.data.address
                           == resource.data.address

                        &&
                        request.resource.data.description
                           == resource.data.description

                        &&
                        request.resource.data.type
                           == resource.data.type

                        &&
                        request.resource.data.status
                           == resource.data.status

                        &&
                        request.resource.data.numberOfFloors
                           == resource.data.numberOfFloors

                        &&
                        request.resource.data.createdAt
                           == resource.data.createdAt

                        &&

                        isValidTenantAcceptance(
                          request.resource.data.ownerId,
                          request.resource.data.propertyId,
                          null
                        )
                      )

                      ||

                      // ==========================================
                      // TENANT ACCEPTANCE — ADD ACCESS
                      // ==========================================

                      (
                        resource.data.keys()
                          .hasAny(['tenantUserIds'])

                        &&
                        resource.data.tenantUserIds is list

                        &&
                        request.resource.data.tenantUserIds is list

                        &&
                        request.auth.uid
                           in request.resource.data.tenantUserIds

                        &&
                        !(request.auth.uid
                           in resource.data.tenantUserIds)

                        &&
                        request.resource.data.tenantUserIds.size()
                           == resource.data.tenantUserIds.size() + 1

                        &&
                        request.resource.data.tenantUserIds
                           .hasAll(resource.data.tenantUserIds)

                        &&
                        request.resource.data.ownerId
                           == resource.data.ownerId

                        &&
                        request.resource.data.name
                           == resource.data.name

                        &&
                        request.resource.data.propertyCode
                           == resource.data.propertyCode

                        &&
                        request.resource.data.address
                           == resource.data.address

                        &&
                        request.resource.data.description
                           == resource.data.description

                        &&
                        request.resource.data.type
                           == resource.data.type

                        &&
                        request.resource.data.status
                           == resource.data.status

                        &&
                        request.resource.data.numberOfFloors
                           == resource.data.numberOfFloors

                        &&
                        request.resource.data.createdAt
                           == resource.data.createdAt

                        &&

                        isValidTenantAcceptance(
                          request.resource.data.ownerId,
                          propertyId,
                          null
                        )
                      )
                    );


      // ----------------------------------------------------------
      // DELETE
      // ----------------------------------------------------------

      allow delete: if isAuthenticated()
                    && resource.data.ownerId
                       == request.auth.uid;
    }


    // ============================================================
    // UNITS
    // ============================================================

    match /units/{unitId} {

      // ----------------------------------------------------------
      // READ
      // Owner OR assigned tenant
      // ----------------------------------------------------------

      allow read: if isAuthenticated()
                  && (
                    isPropertyOwner(
                      resource.data.propertyId
                    )

                    ||

                    (
                      resource.data.tenantUserId
                         == request.auth.uid

                      &&
                      isActiveTenantAccessForUnit(
                        resource.data.propertyId,
                        unitId
                      )
                    )
                  );


      // ----------------------------------------------------------
      // CREATE
      // ----------------------------------------------------------

      allow create: if isAuthenticated()
                    && isPropertyOwner(
                      request.resource.data.propertyId
                    );


      // ----------------------------------------------------------
      // UPDATE
      // ----------------------------------------------------------

      allow update: if isAuthenticated()
                    && (

                      // ==========================================
                      // PROPERTY OWNER
                      // ==========================================

                      (
                        isPropertyOwner(
                          resource.data.propertyId
                        )

                        &&
                        isPropertyOwner(
                          request.resource.data.propertyId
                        )
                      )

                      ||

                      // ==========================================
                      // TENANT ACCEPTANCE
                      // ==========================================

                      (
                        (
                          !resource.data.keys()
                            .hasAny(['tenantUserId'])
                          ||
                          resource.data.tenantUserId == null
                        )

                        &&
                        request.resource.data.tenantUserId
                           == request.auth.uid

                        &&
                        request.resource.data.propertyId
                           == resource.data.propertyId

                        &&
                        request.resource.data.floorNumber
                           == resource.data.floorNumber

                        &&
                        request.resource.data.unitNumber
                           == resource.data.unitNumber

                        &&
                        request.resource.data.name
                           == resource.data.name

                        &&
                        request.resource.data.monthlyRent
                           == resource.data.monthlyRent

                        &&
                        request.resource.data.createdAt
                           == resource.data.createdAt

                        &&
                        request.resource.data.status
                           == 'occupied'

                        &&

                        isValidTenantAcceptance(
                          null,
                          resource.data.propertyId,
                          unitId
                        )
                      )
                    );


      // ----------------------------------------------------------
      // DELETE
      // ----------------------------------------------------------

      allow delete: if isAuthenticated()
                    && isPropertyOwner(
                      resource.data.propertyId
                    );
    }


    // ============================================================
    // TENANT ACCESS
    // ============================================================

    match /tenantAccess/{userId} {

      // ----------------------------------------------------------
      // READ
      // ----------------------------------------------------------

      allow get: if isAuthenticated()
                 && request.auth.uid == userId;


      // ----------------------------------------------------------
      // CREATE
      // ----------------------------------------------------------

      allow create: if isAuthenticated()

                    && request.resource.data.userId
                       == userId

                    && request.resource.data.tenantId is string

                    && request.resource.data.ownerId is string

                    && request.resource.data.propertyId is string

                    && request.resource.data.unitId is string

                    && (

                      // ==========================================
                      // TENANT — INVITATION ACCEPTANCE
                      // ==========================================

                      (
                        request.auth.uid == userId

                        &&

                        request.resource.data.userId
                           == request.auth.uid

                        &&

                        request.resource.data.invitationId is string

                        &&

                        request.resource.data.invitationId != ''

                        &&

                        isValidInvitationTenantAccess()
                      )

                      ||

                      // ==========================================
                      // OWNER — START NEW TENANCY
                      // ==========================================

                      (
                        request.resource.data.invitationId == null

                        &&

                        isValidOwnerStartNewTenancyAccess()
                      )
                    );


      // ----------------------------------------------------------
      // UPDATE
      // ----------------------------------------------------------

      allow update: if isAuthenticated()
                    && request.auth.uid == userId

                    && request.resource.data.userId
                       == resource.data.userId

                    && request.resource.data.tenantId
                       == resource.data.tenantId

                    && request.resource.data.ownerId
                       == resource.data.ownerId

                    && request.resource.data.propertyId
                       == resource.data.propertyId

                    && request.resource.data.unitId
                       == resource.data.unitId

                    && request.resource.data.invitationId
                       == resource.data.invitationId

                    && request.resource.data.createdAt
                       == resource.data.createdAt;


      // ----------------------------------------------------------
      // DELETE
      // ----------------------------------------------------------

      allow delete: if isAuthenticated()
                    && (

                      // ==========================================
                      // TENANT
                      // ==========================================

                      (
                        request.auth.uid
                           == resource.data.userId
                      )

                      ||

                      // ==========================================
                      // OWNER — END TENANCY
                      // ==========================================

                      (
                        resource.data.ownerId
                           == request.auth.uid

                        &&

                        isValidOwnerEndTenancyAccessDelete()
                      )
                    );
    }


    // ============================================================
    // TENANTS
    // ============================================================

    match /tenants/{tenantId} {

      // ----------------------------------------------------------
      // READ
      // ----------------------------------------------------------

      allow read: if isAuthenticated()
                  && (
                    // OWNER
                    resource.data.ownerId
                       == request.auth.uid

                    ||

                    // ALREADY LINKED TENANT
                    resource.data.userId
                       == request.auth.uid

                    ||

                    // FIRST-TIME TENANT
                    (
                      (
                        !resource.data.keys()
                          .hasAny(['userId'])
                        ||
                        resource.data.userId == null
                      )

                      &&

                      request.auth.token.phone_number
                         != null

                      &&

                      resource.data.phone
                         == request.auth.token.phone_number
                    )
                  );


      // ----------------------------------------------------------
      // CREATE
      // ----------------------------------------------------------

      allow create: if isAuthenticated()
                    && request.resource.data.ownerId
                       == request.auth.uid

                    && isPropertyOwner(
                      request.resource.data.propertyId
                    );


      // ----------------------------------------------------------
      // UPDATE
      // ----------------------------------------------------------

      allow update: if isAuthenticated()
                    && (

                      // ==========================================
                      // OWNER — NORMAL UPDATE
                      // ==========================================

                      (
                        resource.data.ownerId
                           == request.auth.uid

                        &&

                        request.resource.data.ownerId
                           == resource.data.ownerId

                        &&

                        request.resource.data.propertyId
                           == resource.data.propertyId

                        &&

                        request.resource.data.unitId
                           == resource.data.unitId

                        &&

                        request.resource.data.status
                           == resource.data.status

                        &&

                        isPropertyOwner(
                          request.resource.data.propertyId
                        )
                      )

                      ||

                      // ==========================================
                      // OWNER — START NEW TENANCY
                      // ==========================================

                      (
                        resource.data.ownerId
                           == request.auth.uid

                        &&

                        resource.data.status
                           == 'inactive'

                        &&

                        request.resource.data.ownerId
                           == resource.data.ownerId

                        &&

                        request.resource.data.status
                           == 'active'

                        &&

                        request.resource.data.userId is string

                        &&

                        request.resource.data.userId
                           == resource.data.userId

                        &&

                        request.resource.data.accountStatus
                           == resource.data.accountStatus

                        &&

                        request.resource.data.confirmationStatus
                           == resource.data.confirmationStatus

                        &&

                        isValidOwnerStartNewTenancyTenant(
                          tenantId
                        )
                      )

                      ||

                      // ==========================================
                      // OWNER — END TENANCY
                      // ==========================================

                      (
                        resource.data.ownerId
                           == request.auth.uid

                        &&

                        resource.data.status
                           == 'active'

                        &&

                        request.resource.data.ownerId
                           == resource.data.ownerId

                        &&

                        request.resource.data.status
                           == 'inactive'

                        &&

                        request.resource.data.userId
                           == resource.data.userId

                        &&

                        request.resource.data.propertyId
                           == resource.data.propertyId

                        &&

                        request.resource.data.unitId
                           == resource.data.unitId

                        &&

                        request.resource.data.accountStatus
                           == resource.data.accountStatus

                        &&

                        request.resource.data.confirmationStatus
                           == resource.data.confirmationStatus

                        &&

                        isValidOwnerEndTenancy(
                        )
                      )

                      ||

                      // ==========================================
                      // ALREADY LINKED TENANT
                      // ==========================================

                      (
                        resource.data.userId
                           == request.auth.uid

                        &&

                        request.resource.data.userId
                           == resource.data.userId

                        &&

                        request.resource.data.ownerId
                           == resource.data.ownerId

                        &&

                        request.resource.data.propertyId
                           == resource.data.propertyId

                        &&

                        request.resource.data.unitId
                           == resource.data.unitId

                        &&

                        request.resource.data.phone
                           == resource.data.phone

                        &&

                        request.resource.data.status
                           == resource.data.status

                        &&

                        request.resource.data.accountStatus
                           == resource.data.accountStatus

                        &&

                        request.resource.data.confirmationStatus
                           == resource.data.confirmationStatus

                        &&

                        request.resource.data.createdAt
                           == resource.data.createdAt
                      )

                      ||

                      // ==========================================
                      // FIRST-TIME TENANT LINK
                      // ==========================================

                      (
                        (
                          !resource.data.keys()
                            .hasAny(['userId'])
                          ||
                          resource.data.userId == null
                        )

                        &&

                        request.auth.token.phone_number
                           != null

                        &&

                        resource.data.phone
                           == request.auth.token.phone_number

                        &&

                        request.resource.data.userId
                           == request.auth.uid

                        &&

                        request.resource.data.ownerId
                           == resource.data.ownerId

                        &&

                        request.resource.data.propertyId
                           == resource.data.propertyId

                        &&

                        request.resource.data.unitId
                           == resource.data.unitId

                        &&

                        request.resource.data.phone
                           == resource.data.phone

                        &&

                        getAfter(
                          /databases/$(database)/documents/tenantAccess/$(request.auth.uid)
                        ).data.tenantId
                           == tenantId

                        &&

                        getAfter(
                          /databases/$(database)/documents/tenantAccess/$(request.auth.uid)
                        ).data.ownerId
                           == resource.data.ownerId

                        &&

                        getAfter(
                          /databases/$(database)/documents/tenantAccess/$(request.auth.uid)
                        ).data.propertyId
                           == resource.data.propertyId

                        &&

                        getAfter(
                          /databases/$(database)/documents/tenantAccess/$(request.auth.uid)
                        ).data.unitId
                           == resource.data.unitId
                      )
                    );


      // ----------------------------------------------------------
      // DELETE
      // ----------------------------------------------------------

      allow delete: if isAuthenticated()
                    && resource.data.ownerId
                       == request.auth.uid;
    }


    // ============================================================
    // TENANT INVITATIONS
    // ============================================================

    match /tenantInvitations/{invitationId} {

      // ----------------------------------------------------------
      // CREATE
      // ----------------------------------------------------------

      allow create: if isAuthenticated()
                    && request.resource.data.ownerId
                       == request.auth.uid

                    && exists(
                      /databases/$(database)/documents/tenants/$(request.resource.data.tenantId)
                    )

                    && get(
                      /databases/$(database)/documents/tenants/$(request.resource.data.tenantId)
                    ).data.ownerId
                       == request.auth.uid

                    && get(
                      /databases/$(database)/documents/tenants/$(request.resource.data.tenantId)
                    ).data.propertyId
                       == request.resource.data.propertyId

                    && get(
                      /databases/$(database)/documents/tenants/$(request.resource.data.tenantId)
                    ).data.unitId
                       == request.resource.data.unitId;


      // ----------------------------------------------------------
      // READ
      // ----------------------------------------------------------

      allow read: if isAuthenticated()
                  && (
                    resource.data.ownerId
                       == request.auth.uid

                    ||

                    (
                      request.auth.token.phone_number != null

                      &&

                      resource.data.phone
                         == request.auth.token.phone_number

                      &&

                      resource.data.status
                         == 'pending'
                    )
                  );


      // ----------------------------------------------------------
      // UPDATE
      // ----------------------------------------------------------

      allow update: if isAuthenticated()
                    && (

                      // ==========================================
                      // OWNER
                      // ==========================================

                      (
                        resource.data.ownerId
                           == request.auth.uid

                        &&

                        request.resource.data.ownerId
                           == resource.data.ownerId

                        &&

                        request.resource.data.tenantId
                           == resource.data.tenantId

                        &&

                        request.resource.data.propertyId
                           == resource.data.propertyId

                        &&

                        request.resource.data.unitId
                           == resource.data.unitId

                        &&

                        request.resource.data.phone
                           == resource.data.phone

                        &&

                        request.resource.data.token
                           == resource.data.token

                        &&

                        request.resource.data.createdAt
                           == resource.data.createdAt

                        &&

                        request.resource.data.expiresAt
                           == resource.data.expiresAt
                      )

                      ||

                      // ==========================================
                      // TENANT ACCEPTANCE
                      // ==========================================

                      (
                        request.auth.token.phone_number
                           != null

                        &&

                        resource.data.phone
                           == request.auth.token.phone_number

                        &&

                        resource.data.status
                           == 'pending'

                        &&

                        request.resource.data.status
                           == 'accepted'

                        &&

                        request.resource.data.ownerId
                           == resource.data.ownerId

                        &&

                        request.resource.data.tenantId
                           == resource.data.tenantId

                        &&

                        request.resource.data.propertyId
                           == resource.data.propertyId

                        &&

                        request.resource.data.unitId
                           == resource.data.unitId

                        &&

                        request.resource.data.phone
                           == resource.data.phone

                        &&

                        request.resource.data.token
                           == resource.data.token

                        &&

                        request.resource.data.createdAt
                           == resource.data.createdAt

                        &&

                        request.resource.data.expiresAt
                           == resource.data.expiresAt

                        &&

                        getAfter(
                          /databases/$(database)/documents/tenants/$(resource.data.tenantId)
                        ).data.userId
                           == request.auth.uid

                        &&

                        getAfter(
                          /databases/$(database)/documents/tenantAccess/$(request.auth.uid)
                        ).data.tenantId
                           == resource.data.tenantId

                        &&

                        getAfter(
                          /databases/$(database)/documents/tenantAccess/$(request.auth.uid)
                        ).data.propertyId
                           == resource.data.propertyId

                        &&

                        getAfter(
                          /databases/$(database)/documents/tenantAccess/$(request.auth.uid)
                        ).data.unitId
                           == resource.data.unitId

                        &&

                        getAfter(
                          /databases/$(database)/documents/tenantAccess/$(request.auth.uid)
                        ).data.invitationId
                           == invitationId
                      )

                      ||

                      // ==========================================
                      // TENANT REJECTION
                      // ==========================================

                      (
                        request.auth.token.phone_number
                           != null

                        &&

                        resource.data.phone
                           == request.auth.token.phone_number

                        &&

                        resource.data.status
                           == 'pending'

                        &&

                        request.resource.data.status
                           == 'rejected'

                        &&

                        request.resource.data.ownerId
                           == resource.data.ownerId

                        &&

                        request.resource.data.tenantId
                           == resource.data.tenantId

                        &&

                        request.resource.data.propertyId
                           == resource.data.propertyId

                        &&

                        request.resource.data.unitId
                           == resource.data.unitId

                        &&

                        request.resource.data.phone
                           == resource.data.phone

                        &&

                        request.resource.data.token
                           == resource.data.token

                        &&

                        request.resource.data.createdAt
                           == resource.data.createdAt

                        &&

                        request.resource.data.expiresAt
                           == resource.data.expiresAt
                      )
                    );


      // ----------------------------------------------------------
      // DELETE
      // ----------------------------------------------------------

      allow delete: if isAuthenticated()
                    && (
                      resource.data.ownerId
                         == request.auth.uid

                      ||

                      (
                        request.auth.token.phone_number
                           != null

                        &&

                        resource.data.phone
                           == request.auth.token.phone_number
                      )
                    );
    }


    // ============================================================
    // SECURITY HELPERS
    // ============================================================

    function isAuthenticated() {
      return request.auth != null;
    }


    // ============================================================
    // PROPERTY OWNER
    // ============================================================

    function isPropertyOwner(propertyId) {
      return exists(
        /databases/$(database)/documents/properties/$(propertyId)
      )
      &&
      get(
        /databases/$(database)/documents/properties/$(propertyId)
      ).data.ownerId == request.auth.uid;
    }


    // ============================================================
    // VALIDATE TENANT ACCEPTANCE
    // ============================================================

    function isValidTenantAcceptance(
      ownerId,
      propertyId,
      unitId
    ) {

      let access =
        getAfter(
          /databases/$(database)/documents/tenantAccess/$(request.auth.uid)
        ).data;

      return access.userId
             == request.auth.uid

             && access.ownerId
                == (
                  ownerId == null
                  ? access.ownerId
                  : ownerId
                )

             && (
               propertyId == null
               ||
               access.propertyId == propertyId
             )

             && (
               unitId == null
               ||
               access.unitId == unitId
             );
    }


    // ============================================================
    // TENANT UNIT/PROPERTY ACCESS
    // ============================================================

    function isActiveTenantAccessForUnit(
      propertyId,
      unitId
    ) {

      let access =
        get(
          /databases/$(database)/documents/tenantAccess/$(request.auth.uid)
        ).data;

      return access.userId
             == request.auth.uid

             && access.propertyId
                == propertyId

             && access.unitId
                == unitId;
    }


    // ============================================================
    // INVITATION TENANT ACCESS
    // ============================================================

    function isValidInvitationTenantAccess() {

      let tenantAfter =
        getAfter(
          /databases/$(database)/documents/tenants/$(request.resource.data.tenantId)
        ).data;

      let invitationAfter =
        getAfter(
          /databases/$(database)/documents/tenantInvitations/$(request.resource.data.invitationId)
        ).data;

      return tenantAfter.userId
                == request.auth.uid

             && tenantAfter.ownerId
                == request.resource.data.ownerId

             && tenantAfter.propertyId
                == request.resource.data.propertyId

             && tenantAfter.unitId
                == request.resource.data.unitId

             && invitationAfter.status
                == 'accepted'

             && invitationAfter.tenantId
                == request.resource.data.tenantId

             && invitationAfter.propertyId
                == request.resource.data.propertyId

             && invitationAfter.unitId
                == request.resource.data.unitId

             && invitationAfter.ownerId
                == request.resource.data.ownerId;
    }


    // ============================================================
    // UNIT ASSIGNMENT STATE
    // ============================================================

    function isUnitUnassigned(unitData) {

      return !unitData.keys()
                .hasAny(['tenantUserId'])

             ||

             unitData.tenantUserId == null

             ||

             (
               unitData.tenantUserId is string
               &&
               unitData.tenantUserId == ''
             );
    }


    // ============================================================
    // OWNER — START NEW TENANCY
    // TENANT ACCESS VALIDATION
    // ============================================================

    function isValidOwnerStartNewTenancyAccess() {

      let tenantBefore =
        get(
          /databases/$(database)/documents/tenants/$(request.resource.data.tenantId)
        ).data;

      let tenantAfter =
        getAfter(
          /databases/$(database)/documents/tenants/$(request.resource.data.tenantId)
        ).data;

      let propertyAfter =
        getAfter(
          /databases/$(database)/documents/properties/$(request.resource.data.propertyId)
        ).data;

      let unitBefore =
        get(
          /databases/$(database)/documents/units/$(request.resource.data.unitId)
        ).data;

      let unitAfter =
        getAfter(
          /databases/$(database)/documents/units/$(request.resource.data.unitId)
        ).data;

      return request.resource.data.invitationId == null

             // --------------------------------------------------
             // Tenant identity
             // --------------------------------------------------

             && request.resource.data.userId is string

             && request.resource.data.userId != ''

             // --------------------------------------------------
             // Tenant belongs to current owner
             // --------------------------------------------------

             && tenantBefore.ownerId
                == request.auth.uid

             // --------------------------------------------------
             // Tenant was inactive
             // --------------------------------------------------

             && tenantBefore.status
                == 'inactive'

             // --------------------------------------------------
             // Tenant account is registered
             // --------------------------------------------------

             && tenantBefore.accountStatus
                == 'registered'

             // --------------------------------------------------
             // Existing tenant account is linked
             // --------------------------------------------------

             && tenantBefore.userId is string

             && tenantBefore.userId
                == request.resource.data.userId

             // --------------------------------------------------
             // Tenant final state
             // --------------------------------------------------

             && tenantAfter.userId
                == request.resource.data.userId

             && tenantAfter.ownerId
                == request.auth.uid

             && tenantAfter.status
                == 'active'

             && tenantAfter.accountStatus
                == 'registered'

             && tenantAfter.propertyId
                == request.resource.data.propertyId

             && tenantAfter.unitId
                == request.resource.data.unitId

             // --------------------------------------------------
             // Unit BEFORE transaction
             // --------------------------------------------------

             && unitBefore.propertyId
                == request.resource.data.propertyId

             && unitBefore.status
                == 'available'

             && isUnitUnassigned(unitBefore)

             // --------------------------------------------------
             // Property AFTER transaction
             // --------------------------------------------------

             && propertyAfter.ownerId
                == request.auth.uid

             && propertyAfter.tenantUserIds is list

             && request.resource.data.userId
                in propertyAfter.tenantUserIds

             // --------------------------------------------------
             // Unit AFTER transaction
             // --------------------------------------------------

             && unitAfter.propertyId
                == request.resource.data.propertyId

             && unitAfter.status
                == 'occupied'

             && unitAfter.tenantUserId
                == request.resource.data.userId;
    }


    // ============================================================
    // OWNER — START NEW TENANCY
    // TENANT DOCUMENT VALIDATION
    // ============================================================

    function isValidOwnerStartNewTenancyTenant(tenantId) {

      let tenantBefore =
        get(
          /databases/$(database)/documents/tenants/$(tenantId)
        ).data;

      let propertyAfter =
        getAfter(
          /databases/$(database)/documents/properties/$(request.resource.data.propertyId)
        ).data;

      let unitAfter =
        getAfter(
          /databases/$(database)/documents/units/$(request.resource.data.unitId)
        ).data;

      let accessAfter =
        getAfter(
          /databases/$(database)/documents/tenantAccess/$(request.resource.data.userId)
        ).data;

      return tenantBefore.ownerId
                == request.auth.uid

             && tenantBefore.status
                == 'inactive'

             && tenantBefore.accountStatus
                == 'registered'

             && tenantBefore.userId is string

             && tenantBefore.userId
                == request.resource.data.userId

             && propertyAfter.ownerId
                == request.auth.uid

             && propertyAfter.tenantUserIds is list

             && request.resource.data.userId
                in propertyAfter.tenantUserIds

             && unitAfter.propertyId
                == request.resource.data.propertyId

             && unitAfter.status
                == 'occupied'

             && unitAfter.tenantUserId
                == request.resource.data.userId

             && accessAfter.userId
                == request.resource.data.userId

             && accessAfter.tenantId
                == tenantId

             && accessAfter.ownerId
                == request.auth.uid

             && accessAfter.propertyId
                == request.resource.data.propertyId

             && accessAfter.unitId
                == request.resource.data.unitId

             && accessAfter.invitationId
                == null;
    }


    // ============================================================
    // OWNER — END TENANCY
    // TENANT DOCUMENT VALIDATION
    // ============================================================

   function isValidOwnerEndTenancy() {

      let propertyAfter =
        getAfter(
          /databases/$(database)/documents/properties/$(request.resource.data.propertyId)
        ).data;

      let unitAfter =
        getAfter(
          /databases/$(database)/documents/units/$(request.resource.data.unitId)
        ).data;

      return propertyAfter.ownerId
                == request.auth.uid

             && propertyAfter.tenantUserIds is list

             && !(request.resource.data.userId
                  in propertyAfter.tenantUserIds)

             && unitAfter.propertyId
                == request.resource.data.propertyId

             && unitAfter.status
                == 'available'

             && isUnitUnassigned(unitAfter)

             && !existsAfter(
                  /databases/$(database)/documents/tenantAccess/$(request.resource.data.userId)
                );
    }


    // ============================================================
    // OWNER — END TENANCY
    // TENANT ACCESS DELETE VALIDATION
    // ============================================================

    function isValidOwnerEndTenancyAccessDelete() {

      let tenantAfter =
        getAfter(
          /databases/$(database)/documents/tenants/$(resource.data.tenantId)
        ).data;

      return tenantAfter.ownerId
                == request.auth.uid

             && tenantAfter.userId
                == resource.data.userId

             && tenantAfter.propertyId
                == resource.data.propertyId

             && tenantAfter.unitId
                == resource.data.unitId

             && tenantAfter.status
                == 'inactive';
    }
  }
}