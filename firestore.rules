rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // USERS
    // ============================================================

    match /users/{userId} {

      allow get: if isAuthenticated()
                 && request.auth.uid == userId;

      allow create: if isAuthenticated()
                    && request.auth.uid == userId
                    && request.resource.data.uid
                       == request.auth.uid;

      allow update: if isAuthenticated()
                    && request.auth.uid == userId
                    && request.resource.data.uid
                       == resource.data.uid
                    && request.resource.data.publicId
                       == resource.data.publicId
                    && request.resource.data.role
                       == resource.data.role
                    && request.resource.data.createdAt
                       == resource.data.createdAt;

      allow delete: if false;
    }


    // ============================================================
    // PHONE LOOKUPS
    // ============================================================

    match /phone_lookups/{phoneNumber} {

      allow get: if isAuthenticated();

      allow create: if isAuthenticated()
                    && request.resource.data.uid
                       == request.auth.uid
                    && request.resource.data.phoneNumber
                       == phoneNumber;

      allow update: if isAuthenticated()
                    && resource.data.uid
                       == request.auth.uid
                    && request.resource.data.uid
                       == request.auth.uid
                    && request.resource.data.phoneNumber
                       == phoneNumber;

      allow delete: if isAuthenticated()
                    && resource.data.uid
                       == request.auth.uid;
    }


    // ============================================================
    // PUBLIC IDS
    // ============================================================

    match /public_ids/{publicId} {

      allow get: if isAuthenticated();

      allow create: if isAuthenticated()
                    && request.resource.data.publicId
                       == publicId
                    && request.resource.data.createdBy
                       == request.auth.uid;

      allow update: if false;

      allow delete: if isAuthenticated()
                    && resource.data.createdBy
                       == request.auth.uid;
    }


    // ============================================================
    // PROPERTIES
    // ============================================================

    match /properties/{propertyId} {

      allow read: if isAuthenticated()
                  && resource.data.ownerId
                     == request.auth.uid;

      allow create: if isAuthenticated()
                    && request.resource.data.ownerId
                       == request.auth.uid;

      allow update: if isAuthenticated()
                    && resource.data.ownerId
                       == request.auth.uid
                    && request.resource.data.ownerId
                       == resource.data.ownerId;

      allow delete: if isAuthenticated()
                    && resource.data.ownerId
                       == request.auth.uid;
    }


    // ============================================================
    // UNITS
    // ============================================================

    match /units/{unitId} {

      allow read: if isAuthenticated()
                  && isPropertyOwner(
                    resource.data.propertyId
                  );

      allow create: if isAuthenticated()
                    && isPropertyOwner(
                      request.resource.data.propertyId
                    );

      allow update: if isAuthenticated()
                    && isPropertyOwner(
                      resource.data.propertyId
                    )
                    && isPropertyOwner(
                      request.resource.data.propertyId
                    );

      allow delete: if isAuthenticated()
                    && isPropertyOwner(
                      resource.data.propertyId
                    );
    }


    // ============================================================
    // TENANTS
    // ============================================================

    match /tenants/{tenantId} {

      // ----------------------------------------------------------
      // READ
      // ----------------------------------------------------------

      allow read: if isAuthenticated()
                  && (
                    resource.data.ownerId
                       == request.auth.uid
                    ||
                    resource.data.userId
                       == request.auth.uid
                  );


      // ----------------------------------------------------------
      // CREATE
      // ----------------------------------------------------------

      allow create: if isAuthenticated()
                    && request.resource.data.ownerId
                       == request.auth.uid
                    && isPropertyOwner(
                      request.resource.data.propertyId
                    );


      // ----------------------------------------------------------
      // UPDATE
      // ----------------------------------------------------------

      allow update: if isAuthenticated()
                    && (

                      // ==========================================
                      // OWNER UPDATE
                      // ==========================================

                      (
                        resource.data.ownerId
                           == request.auth.uid
                        &&
                        request.resource.data.ownerId
                           == resource.data.ownerId
                        &&
                        request.resource.data.propertyId
                           == resource.data.propertyId
                        &&
                        request.resource.data.unitId
                           == resource.data.unitId
                        &&
                        isPropertyOwner(
                          request.resource.data.propertyId
                        )
                      )

                      ||

                      // ==========================================
                      // ALREADY LINKED TENANT
                      // ==========================================

                      (
                        resource.data.userId
                           == request.auth.uid
                        &&
                        request.resource.data.userId
                           == resource.data.userId
                        &&
                        request.resource.data.ownerId
                           == resource.data.ownerId
                        &&
                        request.resource.data.propertyId
                           == resource.data.propertyId
                        &&
                        request.resource.data.unitId
                           == resource.data.unitId
                        &&
                        request.resource.data.phone
                           == resource.data.phone
                      )

                      ||

                      // ==========================================
                      // FIRST-TIME TENANT LINK
                      // ==========================================

                      (
                        (
                          !resource.data.keys()
                            .hasAny(['userId'])
                          ||
                          resource.data.userId == null
                        )
                        &&
                        request.auth.token.phone_number
                           != null
                        &&
                        resource.data.phone
                           == request.auth.token.phone_number
                        &&
                        request.resource.data.userId
                           == request.auth.uid
                        &&
                        request.resource.data.ownerId
                           == resource.data.ownerId
                        &&
                        request.resource.data.propertyId
                           == resource.data.propertyId
                        &&
                        request.resource.data.unitId
                           == resource.data.unitId
                        &&
                        request.resource.data.phone
                           == resource.data.phone
                      )
                    );


      // ----------------------------------------------------------
      // DELETE
      // ----------------------------------------------------------

      allow delete: if isAuthenticated()
                    && resource.data.ownerId
                       == request.auth.uid;
    }


    // ============================================================
    // TENANT INVITATIONS
    // ============================================================

    match /tenantInvitations/{invitationId} {

      // ----------------------------------------------------------
      // CREATE
      // ----------------------------------------------------------

      allow create: if isAuthenticated()
                    && request.resource.data.ownerId
                       == request.auth.uid

                    && exists(
                      /databases/$(database)/documents/tenants/$(request.resource.data.tenantId)
                    )

                    && get(
                      /databases/$(database)/documents/tenants/$(request.resource.data.tenantId)
                    ).data.ownerId
                       == request.auth.uid

                    && get(
                      /databases/$(database)/documents/tenants/$(request.resource.data.tenantId)
                    ).data.propertyId
                       == request.resource.data.propertyId

                    && get(
                      /databases/$(database)/documents/tenants/$(request.resource.data.tenantId)
                    ).data.unitId
                       == request.resource.data.unitId;


      // ----------------------------------------------------------
      // READ
      //
      // OWNER:
      // নিজের invitation দেখতে পারবে.
      //
      // TENANT:
      // Firebase Auth verified phone
      // invitation phone-এর সাথে match করলে দেখতে পারবে.
      //
      // IMPORTANT:
      // Unauthenticated users cannot directly read
      // tenantInvitations.
      // ----------------------------------------------------------

    allow read: if isAuthenticated()
                && (
                  resource.data.ownerId == request.auth.uid
                  ||
                  resource.data.userId == request.auth.uid
                  ||
                  (
                    (
                      !resource.data.keys().hasAny(['userId'])
                      ||
                      resource.data.userId == null
                    )
                    &&
                    request.auth.token.phone_number != null
                    &&
                    resource.data.phone == request.auth.token.phone_number
                  )
                );


      // ----------------------------------------------------------
      // UPDATE
      // ----------------------------------------------------------

      allow update: if isAuthenticated()
                    && (

                      // ==========================================
                      // OWNER
                      // ==========================================

                      resource.data.ownerId
                         == request.auth.uid

                      ||

                      // ==========================================
                      // VERIFIED PHONE-MATCHING TENANT
                      // ==========================================

                      (
                        request.auth.token.phone_number
                           != null
                        &&
                        resource.data.phone
                           == request.auth.token.phone_number
                      )
                    )

                    // --------------------------------------------
                    // IMMUTABLE FIELDS
                    // --------------------------------------------

                    &&
                    request.resource.data.ownerId
                       == resource.data.ownerId

                    &&
                    request.resource.data.tenantId
                       == resource.data.tenantId

                    &&
                    request.resource.data.propertyId
                       == resource.data.propertyId

                    &&
                    request.resource.data.unitId
                       == resource.data.unitId

                    &&
                    request.resource.data.phone
                       == resource.data.phone

                    &&
                    request.resource.data.token
                       == resource.data.token

                    &&
                    request.resource.data.createdAt
                       == resource.data.createdAt

                    &&
                    request.resource.data.expiresAt
                       == resource.data.expiresAt;


      // ----------------------------------------------------------
      // DELETE
      // ----------------------------------------------------------

      allow delete: if isAuthenticated()
                    && (
                      resource.data.ownerId
                         == request.auth.uid

                      ||

                      (
                        request.auth.token.phone_number
                           != null
                        &&
                        resource.data.phone
                           == request.auth.token.phone_number
                      )
                    );
    }


    // ============================================================
    // SECURITY HELPERS
    // ============================================================

    function isAuthenticated() {
      return request.auth != null;
    }


    function isPropertyOwner(propertyId) {
      return exists(
        /databases/$(database)/documents/properties/$(propertyId)
      )
      &&
      get(
        /databases/$(database)/documents/properties/$(propertyId)
      ).data.ownerId == request.auth.uid;
    }
  }
}