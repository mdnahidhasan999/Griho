rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // USERS
    // ============================================================

    match /users/{userId} {

      allow get: if isAuthenticated()
                 && request.auth.uid == userId;

      allow create: if isAuthenticated()
                    && request.auth.uid == userId
                    && request.resource.data.uid
                       == request.auth.uid;

      allow update: if isAuthenticated()
                    && request.auth.uid == userId
                    && request.resource.data.uid
                       == resource.data.uid
                    && request.resource.data.publicId
                       == resource.data.publicId
                    && request.resource.data.role
                       == resource.data.role
                    && request.resource.data.createdAt
                       == resource.data.createdAt;

      allow delete: if false;
    }


    // ============================================================
    // PHONE LOOKUPS
    // ============================================================

    match /phone_lookups/{phoneNumber} {

      allow get: if isAuthenticated();

      allow create: if isAuthenticated()
                    && request.resource.data.uid
                       == request.auth.uid
                    && request.resource.data.phoneNumber
                       == phoneNumber;

      allow update: if isAuthenticated()
                    && resource.data.uid
                       == request.auth.uid
                    && request.resource.data.uid
                       == resource.data.uid
                    && request.resource.data.phoneNumber
                       == resource.data.phoneNumber
                    && request.resource.data.publicId
                       == resource.data.publicId;

      allow delete: if isAuthenticated()
                    && resource.data.uid
                       == request.auth.uid;
    }


    // ============================================================
    // PUBLIC IDS
    // ============================================================

    match /public_ids/{publicId} {

      allow get: if isAuthenticated();

      allow create: if isAuthenticated()
                    && request.resource.data.publicId
                       == publicId
                    && request.resource.data.uid
                       == request.auth.uid
                    && request.resource.data.createdBy
                       == request.auth.uid;

      allow update: if isAuthenticated()
                    && resource.data.uid
                       == request.auth.uid
                    && resource.data.createdBy
                       == request.auth.uid
                    && request.resource.data.publicId
                       == resource.data.publicId
                    && request.resource.data.uid
                       == resource.data.uid
                    && request.resource.data.createdBy
                       == resource.data.createdBy;

      allow delete: if isAuthenticated()
                    && resource.data.createdBy
                       == request.auth.uid;
    }


    // ============================================================
    // PROPERTIES
    // ============================================================

    match /properties/{propertyId} {

      // ----------------------------------------------------------
      // READ
      // Owner OR assigned tenant
      // ----------------------------------------------------------

      allow read: if isAuthenticated()
                  && (
                    resource.data.ownerId
                       == request.auth.uid

                    ||

                    (
                      resource.data.tenantUserIds is list
                      &&
                      request.auth.uid
                         in resource.data.tenantUserIds
                    )
                  );


      // ----------------------------------------------------------
      // CREATE
      // ----------------------------------------------------------

      allow create: if isAuthenticated()
                    && request.resource.data.ownerId
                       == request.auth.uid;


      // ----------------------------------------------------------
      // UPDATE
      // ----------------------------------------------------------

      allow update: if isAuthenticated()
                    && (

                      // ==========================================
                      // OWNER
                      // ==========================================

                      (
                        resource.data.ownerId
                           == request.auth.uid

                        &&
                        request.resource.data.ownerId
                           == resource.data.ownerId
                      )

                      ||

                      // ==========================================
                      // TENANT ACCEPTANCE
                      // ==========================================

                      (
                        !resource.data.keys()
                          .hasAny(['tenantUserIds'])

                        &&
                        request.resource.data.tenantUserIds is list

                        &&
                        request.resource.data.tenantUserIds.size()
                           == 1

                        &&
                        request.auth.uid
                           in request.resource.data.tenantUserIds

                        &&
                        request.resource.data.ownerId
                           == resource.data.ownerId

                        &&
                        request.resource.data.name
                           == resource.data.name

                        &&
                        request.resource.data.propertyCode
                           == resource.data.propertyCode

                        &&
                        request.resource.data.address
                           == resource.data.address

                        &&
                        request.resource.data.description
                           == resource.data.description

                        &&
                        request.resource.data.type
                           == resource.data.type

                        &&
                        request.resource.data.status
                           == resource.data.status

                        &&
                        request.resource.data.numberOfFloors
                           == resource.data.numberOfFloors

                        &&
                        request.resource.data.createdAt
                           == resource.data.createdAt

                        &&

                        isValidTenantAcceptance(
                          request.resource.data.ownerId,
                          request.resource.data.propertyId,
                          null
                        )
                      )

                      ||

                      (
                        resource.data.keys()
                          .hasAny(['tenantUserIds'])

                        &&
                        resource.data.tenantUserIds is list

                        &&
                        request.resource.data.tenantUserIds is list

                        &&
                        request.auth.uid
                           in request.resource.data.tenantUserIds

                        &&
                        !(request.auth.uid
                           in resource.data.tenantUserIds)

                        &&
                        request.resource.data.tenantUserIds.size()
                           == resource.data.tenantUserIds.size() + 1

                        &&
                        request.resource.data.tenantUserIds
                           .hasAll(resource.data.tenantUserIds)

                        &&
                        request.resource.data.ownerId
                           == resource.data.ownerId

                        &&
                        request.resource.data.name
                           == resource.data.name

                        &&
                        request.resource.data.propertyCode
                           == resource.data.propertyCode

                        &&
                        request.resource.data.address
                           == resource.data.address

                        &&
                        request.resource.data.description
                           == resource.data.description

                        &&
                        request.resource.data.type
                           == resource.data.type

                        &&
                        request.resource.data.status
                           == resource.data.status

                        &&
                        request.resource.data.numberOfFloors
                           == resource.data.numberOfFloors

                        &&
                        request.resource.data.createdAt
                           == resource.data.createdAt

                        &&

                        isValidTenantAcceptance(
                          request.resource.data.ownerId,
                          propertyId,
                          null
                        )
                      )
                    );


      // ----------------------------------------------------------
      // DELETE
      // ----------------------------------------------------------

      allow delete: if isAuthenticated()
                    && resource.data.ownerId
                       == request.auth.uid;
    }


    // ============================================================
    // UNITS
    // ============================================================

    match /units/{unitId} {

      // ----------------------------------------------------------
      // READ
      // Owner OR assigned tenant
      // ----------------------------------------------------------

      allow read: if isAuthenticated()
                  && (
                    isPropertyOwner(
                      resource.data.propertyId
                    )

                    ||

                    (
                      resource.data.tenantUserId
                         == request.auth.uid

                      &&
                      isActiveTenantAccessForUnit(
                        resource.data.propertyId,
                        unitId
                      )
                    )
                  );


      // ----------------------------------------------------------
      // CREATE
      // ----------------------------------------------------------

      allow create: if isAuthenticated()
                    && isPropertyOwner(
                      request.resource.data.propertyId
                    );


      // ----------------------------------------------------------
      // UPDATE
      // ----------------------------------------------------------

      allow update: if isAuthenticated()
                    && (

                      // ==========================================
                      // PROPERTY OWNER
                      // ==========================================

                      (
                        isPropertyOwner(
                          resource.data.propertyId
                        )

                        &&
                        isPropertyOwner(
                          request.resource.data.propertyId
                        )
                      )

                      ||

                      // ==========================================
                      // TENANT ACCEPTANCE
                      // ==========================================

                      (
                        (
                          !resource.data.keys()
                            .hasAny(['tenantUserId'])
                          ||
                          resource.data.tenantUserId == null
                        )

                        &&
                        request.resource.data.tenantUserId
                           == request.auth.uid

                        &&
                        request.resource.data.propertyId
                           == resource.data.propertyId

                        &&
                        request.resource.data.floorNumber
                           == resource.data.floorNumber

                        &&
                        request.resource.data.unitNumber
                           == resource.data.unitNumber

                        &&
                        request.resource.data.name
                           == resource.data.name

                        &&
                        request.resource.data.monthlyRent
                           == resource.data.monthlyRent

                        &&
                        request.resource.data.createdAt
                           == resource.data.createdAt

                        &&
                        request.resource.data.status
                           == 'occupied'

                        &&

                        isValidTenantAcceptance(
                          null,
                          resource.data.propertyId,
                          unitId
                        )
                      )
                    );


      // ----------------------------------------------------------
      // DELETE
      // ----------------------------------------------------------

      allow delete: if isAuthenticated()
                    && isPropertyOwner(
                      resource.data.propertyId
                    );
    }


    // ============================================================
    // TENANT ACCESS
    // ============================================================

    match /tenantAccess/{userId} {

      // ----------------------------------------------------------
      // READ
      // ----------------------------------------------------------

      allow get: if isAuthenticated()
                 && request.auth.uid == userId;


      // ----------------------------------------------------------
      // CREATE
      // ----------------------------------------------------------

      allow create: if isAuthenticated()
                    && request.auth.uid == userId

                    && request.resource.data.userId
                       == request.auth.uid

                    && request.resource.data.tenantId is string

                    && request.resource.data.ownerId is string

                    && request.resource.data.propertyId is string

                    && request.resource.data.unitId is string

                    && request.resource.data.invitationId is string

                    && getAfter(
                      /databases/$(database)/documents/tenants/$(request.resource.data.tenantId)
                    ).data.userId
                       == request.auth.uid

                    && getAfter(
                      /databases/$(database)/documents/tenants/$(request.resource.data.tenantId)
                    ).data.ownerId
                       == request.resource.data.ownerId

                    && getAfter(
                      /databases/$(database)/documents/tenants/$(request.resource.data.tenantId)
                    ).data.propertyId
                       == request.resource.data.propertyId

                    && getAfter(
                      /databases/$(database)/documents/tenants/$(request.resource.data.tenantId)
                    ).data.unitId
                       == request.resource.data.unitId

                    && getAfter(
                      /databases/$(database)/documents/tenantInvitations/$(request.resource.data.invitationId)
                    ).data.status
                       == 'accepted'

                    && getAfter(
                      /databases/$(database)/documents/tenantInvitations/$(request.resource.data.invitationId)
                    ).data.tenantId
                       == request.resource.data.tenantId

                    && getAfter(
                      /databases/$(database)/documents/tenantInvitations/$(request.resource.data.invitationId)
                    ).data.propertyId
                       == request.resource.data.propertyId

                    && getAfter(
                      /databases/$(database)/documents/tenantInvitations/$(request.resource.data.invitationId)
                    ).data.unitId
                       == request.resource.data.unitId

                    && getAfter(
                      /databases/$(database)/documents/tenantInvitations/$(request.resource.data.invitationId)
                    ).data.ownerId
                       == request.resource.data.ownerId;


      // ----------------------------------------------------------
      // UPDATE
      // ----------------------------------------------------------

      allow update: if isAuthenticated()
                    && request.auth.uid == userId

                    && request.resource.data.userId
                       == resource.data.userId

                    && request.resource.data.tenantId
                       == resource.data.tenantId

                    && request.resource.data.ownerId
                       == resource.data.ownerId

                    && request.resource.data.propertyId
                       == resource.data.propertyId

                    && request.resource.data.unitId
                       == resource.data.unitId

                    && request.resource.data.invitationId
                       == resource.data.invitationId

                    && request.resource.data.createdAt
                       == resource.data.createdAt;


      // ----------------------------------------------------------
      // DELETE
      // ----------------------------------------------------------
      //
      // Tenant can delete their own access.
      //
      // Owner can delete tenant access ONLY as part of a valid
      // End Tenancy transaction.
      //
      // ----------------------------------------------------------

      allow delete: if isAuthenticated()
                    && (

                      // ==========================================================
                      // TENANT
                      // ==========================================================

                      (
                        request.auth.uid
                           == resource.data.userId
                      )

                      ||

                      // ==========================================================
                      // OWNER — END TENANCY
                      // ==========================================================

                      (
                        resource.data.ownerId
                           == request.auth.uid

                        &&

                        getAfter(
                          /databases/$(database)/documents/tenants/$(resource.data.tenantId)
                        ).data.ownerId
                           == request.auth.uid

                        &&

                        getAfter(
                          /databases/$(database)/documents/tenants/$(resource.data.tenantId)
                        ).data.userId
                           == resource.data.userId

                        &&

                        getAfter(
                          /databases/$(database)/documents/tenants/$(resource.data.tenantId)
                        ).data.propertyId
                           == resource.data.propertyId

                        &&

                        getAfter(
                          /databases/$(database)/documents/tenants/$(resource.data.tenantId)
                        ).data.unitId
                           == resource.data.unitId

                        &&

                        getAfter(
                          /databases/$(database)/documents/tenants/$(resource.data.tenantId)
                        ).data.status
                           == 'inactive'
                      )
                    );
    }


    // ============================================================
    // TENANTS
    // ============================================================

    match /tenants/{tenantId} {

      // ----------------------------------------------------------
      // READ
      // ----------------------------------------------------------

      allow read: if isAuthenticated()
                  && (
                    // OWNER
                    resource.data.ownerId
                       == request.auth.uid

                    ||

                    // ALREADY LINKED TENANT
                    resource.data.userId
                       == request.auth.uid

                    ||

                    // FIRST-TIME TENANT
                    (
                      (
                        !resource.data.keys()
                          .hasAny(['userId'])
                        ||
                        resource.data.userId == null
                      )
                      &&
                      request.auth.token.phone_number
                         != null
                      &&
                      resource.data.phone
                         == request.auth.token.phone_number
                    )
                  );


      // ----------------------------------------------------------
      // CREATE
      // ----------------------------------------------------------

      allow create: if isAuthenticated()
                    && request.resource.data.ownerId
                       == request.auth.uid
                    && isPropertyOwner(
                      request.resource.data.propertyId
                    );


      // ----------------------------------------------------------
      // UPDATE
      // ----------------------------------------------------------

      allow update: if isAuthenticated()
                    && (

                      // ==========================================
                      // OWNER UPDATE
                      // ==========================================

                      (
                        resource.data.ownerId
                           == request.auth.uid

                        &&
                        request.resource.data.ownerId
                           == resource.data.ownerId

                        &&
                        request.resource.data.propertyId
                           == resource.data.propertyId

                        &&
                        request.resource.data.unitId
                           == resource.data.unitId

                        &&
                        isPropertyOwner(
                          request.resource.data.propertyId
                        )
                      )

                      ||

                      // ==========================================
                      // ALREADY LINKED TENANT
                      // ==========================================

                      (
                        resource.data.userId
                           == request.auth.uid

                        &&
                        request.resource.data.userId
                           == resource.data.userId

                        &&
                        request.resource.data.ownerId
                           == resource.data.ownerId

                        &&
                        request.resource.data.propertyId
                           == resource.data.propertyId

                        &&
                        request.resource.data.unitId
                           == resource.data.unitId

                        &&
                        request.resource.data.phone
                           == resource.data.phone

                        &&
                        request.resource.data.status
                           == resource.data.status

                        &&
                        request.resource.data.accountStatus
                           == resource.data.accountStatus

                        &&
                        request.resource.data.confirmationStatus
                           == resource.data.confirmationStatus

                        &&
                        request.resource.data.createdAt
                           == resource.data.createdAt
                      )

                      ||

                      // ==========================================
                      // FIRST-TIME TENANT LINK
                      // ==========================================

                      (
                        (
                          !resource.data.keys()
                            .hasAny(['userId'])
                          ||
                          resource.data.userId == null
                        )

                        &&
                        request.auth.token.phone_number
                           != null

                        &&
                        resource.data.phone
                           == request.auth.token.phone_number

                        &&
                        request.resource.data.userId
                           == request.auth.uid

                        &&
                        request.resource.data.ownerId
                           == resource.data.ownerId

                        &&
                        request.resource.data.propertyId
                           == resource.data.propertyId

                        &&
                        request.resource.data.unitId
                           == resource.data.unitId

                        &&
                        request.resource.data.phone
                           == resource.data.phone

                        &&

                        getAfter(
                          /databases/$(database)/documents/tenantAccess/$(request.auth.uid)
                        ).data.tenantId
                           == tenantId

                        &&

                        getAfter(
                          /databases/$(database)/documents/tenantAccess/$(request.auth.uid)
                        ).data.ownerId
                           == resource.data.ownerId

                        &&

                        getAfter(
                          /databases/$(database)/documents/tenantAccess/$(request.auth.uid)
                        ).data.propertyId
                           == resource.data.propertyId

                        &&

                        getAfter(
                          /databases/$(database)/documents/tenantAccess/$(request.auth.uid)
                        ).data.unitId
                           == resource.data.unitId
                      )
                    );


      // ----------------------------------------------------------
      // DELETE
      // ----------------------------------------------------------

      allow delete: if isAuthenticated()
                    && resource.data.ownerId
                       == request.auth.uid;
    }


    // ============================================================
    // TENANT INVITATIONS
    // ============================================================

    match /tenantInvitations/{invitationId} {

      // ----------------------------------------------------------
      // CREATE
      // ----------------------------------------------------------

      allow create: if isAuthenticated()
                    && request.resource.data.ownerId
                       == request.auth.uid

                    && exists(
                      /databases/$(database)/documents/tenants/$(request.resource.data.tenantId)
                    )

                    && get(
                      /databases/$(database)/documents/tenants/$(request.resource.data.tenantId)
                    ).data.ownerId
                       == request.auth.uid

                    && get(
                      /databases/$(database)/documents/tenants/$(request.resource.data.tenantId)
                    ).data.propertyId
                       == request.resource.data.propertyId

                    && get(
                      /databases/$(database)/documents/tenants/$(request.resource.data.tenantId)
                    ).data.unitId
                       == request.resource.data.unitId;


      // ----------------------------------------------------------
      // READ
      // ----------------------------------------------------------

      allow read: if isAuthenticated()
                  && (
                    resource.data.ownerId
                       == request.auth.uid

                    ||

                    (
                      request.auth.token.phone_number != null
                      &&
                      resource.data.phone
                         == request.auth.token.phone_number
                      &&
                      resource.data.status
                         == 'pending'
                    )
                  );


      // ----------------------------------------------------------
      // UPDATE
      // ----------------------------------------------------------

      allow update: if isAuthenticated()
                    && (

                      // ==========================================
                      // OWNER
                      // ==========================================

                      (
                        resource.data.ownerId
                           == request.auth.uid

                        &&
                        request.resource.data.ownerId
                           == resource.data.ownerId

                        &&
                        request.resource.data.tenantId
                           == resource.data.tenantId

                        &&
                        request.resource.data.propertyId
                           == resource.data.propertyId

                        &&
                        request.resource.data.unitId
                           == resource.data.unitId

                        &&
                        request.resource.data.phone
                           == resource.data.phone

                        &&
                        request.resource.data.token
                           == resource.data.token

                        &&
                        request.resource.data.createdAt
                           == resource.data.createdAt

                        &&
                        request.resource.data.expiresAt
                           == resource.data.expiresAt
                      )

                      ||

                      // ==========================================
                      // TENANT ACCEPTANCE
                      // ==========================================

                      (
                        request.auth.token.phone_number
                           != null

                        &&
                        resource.data.phone
                           == request.auth.token.phone_number

                        &&
                        resource.data.status
                           == 'pending'

                        &&
                        request.resource.data.status
                           == 'accepted'

                        &&
                        request.resource.data.ownerId
                           == resource.data.ownerId

                        &&
                        request.resource.data.tenantId
                           == resource.data.tenantId

                        &&
                        request.resource.data.propertyId
                           == resource.data.propertyId

                        &&
                        request.resource.data.unitId
                           == resource.data.unitId

                        &&
                        request.resource.data.phone
                           == resource.data.phone

                        &&
                        request.resource.data.token
                           == resource.data.token

                        &&
                        request.resource.data.createdAt
                           == resource.data.createdAt

                        &&
                        request.resource.data.expiresAt
                           == resource.data.expiresAt

                        // Tenant must be linked in the same
                        // transaction.
                        &&

                        getAfter(
                          /databases/$(database)/documents/tenants/$(resource.data.tenantId)
                        ).data.userId
                           == request.auth.uid

                        // tenantAccess must also exist in the
                        // same transaction.
                        &&

                        getAfter(
                          /databases/$(database)/documents/tenantAccess/$(request.auth.uid)
                        ).data.tenantId
                           == resource.data.tenantId

                        &&

                        getAfter(
                          /databases/$(database)/documents/tenantAccess/$(request.auth.uid)
                        ).data.propertyId
                           == resource.data.propertyId

                        &&

                        getAfter(
                          /databases/$(database)/documents/tenantAccess/$(request.auth.uid)
                        ).data.unitId
                           == resource.data.unitId

                        &&

                        getAfter(
                          /databases/$(database)/documents/tenantAccess/$(request.auth.uid)
                        ).data.invitationId
                           == invitationId
                      )

                      ||

                      // ==========================================
                      // TENANT REJECTION
                      //
                      // Tenant can reject ONLY their own pending
                      // invitation.
                      //
                      // No other invitation fields may be changed.
                      // ==========================================

                      (
                        request.auth.token.phone_number
                           != null

                        &&
                        resource.data.phone
                           == request.auth.token.phone_number

                        &&
                        resource.data.status
                           == 'pending'

                        &&
                        request.resource.data.status
                           == 'rejected'

                        &&
                        request.resource.data.ownerId
                           == resource.data.ownerId

                        &&
                        request.resource.data.tenantId
                           == resource.data.tenantId

                        &&
                        request.resource.data.propertyId
                           == resource.data.propertyId

                        &&
                        request.resource.data.unitId
                           == resource.data.unitId

                        &&
                        request.resource.data.phone
                           == resource.data.phone

                        &&
                        request.resource.data.token
                           == resource.data.token

                        &&
                        request.resource.data.createdAt
                           == resource.data.createdAt

                        &&
                        request.resource.data.expiresAt
                           == resource.data.expiresAt
                      )
                    );


      // ----------------------------------------------------------
      // DELETE
      // ----------------------------------------------------------

      allow delete: if isAuthenticated()
                    && (
                      resource.data.ownerId
                         == request.auth.uid

                      ||

                      (
                        request.auth.token.phone_number
                           != null

                        &&
                        resource.data.phone
                           == request.auth.token.phone_number
                      )
                    );
    }


    // ============================================================
    // SECURITY HELPERS
    // ============================================================

    function isAuthenticated() {
      return request.auth != null;
    }


    function isPropertyOwner(propertyId) {
      return exists(
        /databases/$(database)/documents/properties/$(propertyId)
      )
      &&
      get(
        /databases/$(database)/documents/properties/$(propertyId)
      ).data.ownerId == request.auth.uid;
    }


    // ------------------------------------------------------------
    // VALIDATE TENANT ACCEPTANCE
    // ------------------------------------------------------------

    function isValidTenantAcceptance(
      ownerId,
      propertyId,
      unitId
    ) {

      let access =
        getAfter(
          /databases/$(database)/documents/tenantAccess/$(request.auth.uid)
        ).data;

      return access.userId
             == request.auth.uid

             && access.ownerId
                == (
                  ownerId == null
                  ? access.ownerId
                  : ownerId
                )

             && (
               propertyId == null
               ||
               access.propertyId == propertyId
             )

             && (
               unitId == null
               ||
               access.unitId == unitId
             );
    }


    // ------------------------------------------------------------
    // TENANT UNIT/PROPERTY ACCESS
    // ------------------------------------------------------------

    function isActiveTenantAccessForUnit(
      propertyId,
      unitId
    ) {

      let access =
        get(
          /databases/$(database)/documents/tenantAccess/$(request.auth.uid)
        ).data;

      return access.userId
             == request.auth.uid

             && access.propertyId
                == propertyId

             && access.unitId
                == unitId;
    }
  }
}