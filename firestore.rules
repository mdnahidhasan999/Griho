rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // USER PROFILE
    // ============================================================

    match /users/{userId} {

      allow get: if isAuthenticated()
                 && request.auth.uid == userId;

      allow create: if isAuthenticated()
                    && request.auth.uid == userId
                    && request.resource.data.uid == request.auth.uid;

      allow update: if isAuthenticated()
                    && request.auth.uid == userId
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.publicId == resource.data.publicId
                    && request.resource.data.role == resource.data.role
                    && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if false;
    }


    // ============================================================
    // GRIHO PUBLIC ID RESERVATIONS
    // ============================================================

    match /public_ids/{publicId} {

      allow get: if isAuthenticated();

      allow create: if isAuthenticated()
                    && request.resource.data.publicId == publicId
                    && request.resource.data.createdBy == request.auth.uid;

      allow update: if false;

      allow delete: if isAuthenticated()
                    && resource.data.createdBy == request.auth.uid;
    }


    // ============================================================
    // PROPERTIES
    // ============================================================

    match /properties/{propertyId} {

      // Owner can read their own properties.
      allow read: if isAuthenticated()
                  && resource.data.ownerId == request.auth.uid;

      // User can create only their own property.
      allow create: if isAuthenticated()
                    && request.resource.data.ownerId == request.auth.uid;

      // Owner can update their own property.
      // Ownership cannot be transferred.
      allow update: if isAuthenticated()
                    && resource.data.ownerId == request.auth.uid
                    && request.resource.data.ownerId
                       == resource.data.ownerId;

      // Only owner can delete property.
      allow delete: if isAuthenticated()
                    && resource.data.ownerId == request.auth.uid;
    }


    // ============================================================
    // UNITS
    // ============================================================

    match /units/{unitId} {

      // ----------------------------------------------------------
      // READ
      // ----------------------------------------------------------
      // User can read a unit only when the unit belongs to a
      // property owned by the currently authenticated user.
      allow read: if isAuthenticated()
                  && isPropertyOwner(
                    resource.data.propertyId
                  );


      // ----------------------------------------------------------
      // CREATE
      // ----------------------------------------------------------
      // User can create a unit only under their own property.
      allow create: if isAuthenticated()
                    && isPropertyOwner(
                      request.resource.data.propertyId
                    );


      // ----------------------------------------------------------
      // UPDATE
      // ----------------------------------------------------------
      // User must own both the old and new property reference.
      allow update: if isAuthenticated()
                    && isPropertyOwner(
                      resource.data.propertyId
                    )
                    && isPropertyOwner(
                      request.resource.data.propertyId
                    );


      // ----------------------------------------------------------
      // DELETE
      // ----------------------------------------------------------
      // Only the property owner can delete the unit.
      allow delete: if isAuthenticated()
                    && isPropertyOwner(
                      resource.data.propertyId
                    );
    }


    // ============================================================
    // SECURITY HELPERS
    // ============================================================

    function isAuthenticated() {
      return request.auth != null;
    }


    function isPropertyOwner(propertyId) {
      return exists(
        /databases/$(database)/documents/properties/$(propertyId)
      )
      && get(
        /databases/$(database)/documents/properties/$(propertyId)
      ).data.ownerId == request.auth.uid;
    }
  }
}