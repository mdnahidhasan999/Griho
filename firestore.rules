rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // USERS
    // ============================================================

    match /users/{userId} {

      allow get: if isAuthenticated()
                 && request.auth.uid == userId;

      allow create: if isAuthenticated()
                    && request.auth.uid == userId
                    && request.resource.data.uid == request.auth.uid;

      allow update: if isAuthenticated()
                    && request.auth.uid == userId
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.publicId == resource.data.publicId
                    && request.resource.data.role == resource.data.role
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.phoneNumber == resource.data.phoneNumber
                    && request.resource.data.isActive == resource.data.isActive
                    && request.resource.data.updatedAt is timestamp
                    && request.resource.data.updatedAt <= request.time;

      allow delete: if false;
    }


    // ============================================================
    // PHONE LOOKUPS
    // ============================================================

    match /phone_lookups/{phoneNumber} {

      allow get: if isAuthenticated();

      allow create: if isAuthenticated()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.phoneNumber == phoneNumber;

      allow update: if isAuthenticated()
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.phoneNumber == resource.data.phoneNumber
                    && request.resource.data.publicId == resource.data.publicId;

      allow delete: if isAuthenticated()
                    && resource.data.uid == request.auth.uid;
    }


    // ============================================================
    // PUBLIC IDS
    // ============================================================

    match /public_ids/{publicId} {

      allow get: if isAuthenticated();

      allow create: if isAuthenticated()
                    && request.resource.data.publicId == publicId
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.createdBy == request.auth.uid;

      allow update: if isAuthenticated()
                    && resource.data.uid == request.auth.uid
                    && resource.data.createdBy == request.auth.uid
                    && request.resource.data.publicId == resource.data.publicId
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.createdBy == resource.data.createdBy;

      allow delete: if isAuthenticated()
                    && resource.data.createdBy == request.auth.uid;
    }


    // ============================================================
    // PROPERTIES
    // ============================================================

    match /properties/{propertyId} {

      allow read: if isAuthenticated()
                  && (
                    resource.data.ownerId == request.auth.uid

                    ||

                    (
                      resource.data.tenantUserIds is list
                      && request.auth.uid in resource.data.tenantUserIds
                      && isValidPropertyTenantAccess(propertyId)
                    )
                  );


      allow create: if isAuthenticated()
                    && request.resource.data.ownerId == request.auth.uid;


      allow update: if isAuthenticated()
                    && (

                      // ------------------------------------------------
                      // OWNER
                      // ------------------------------------------------

                      (
                        resource.data.ownerId == request.auth.uid
                        &&
                        request.resource.data.ownerId == resource.data.ownerId
                      )

                      ||

                      // ------------------------------------------------
                      // TENANT ACCEPTANCE — FIRST ACCESS
                      // ------------------------------------------------

                      (
                        resource.data.tenantUserIds is list
                        &&
                        resource.data.tenantUserIds.size() == 0

                        &&

                        request.resource.data.tenantUserIds is list
                        &&
                        request.resource.data.tenantUserIds.size() == 1

                        &&

                        request.auth.uid in request.resource.data.tenantUserIds

                        &&

                        request.resource.data.ownerId == resource.data.ownerId
                        &&
                        request.resource.data.name == resource.data.name
                        &&
                        request.resource.data.propertyCode == resource.data.propertyCode
                        &&
                        request.resource.data.address == resource.data.address
                        &&
                        request.resource.data.description == resource.data.description
                        &&
                        request.resource.data.type == resource.data.type
                        &&
                        request.resource.data.status == resource.data.status
                        &&
                        request.resource.data.numberOfFloors == resource.data.numberOfFloors
                        &&
                        request.resource.data.createdAt == resource.data.createdAt

                        &&

                        isValidTenantAcceptance(
                          request.resource.data.ownerId,
                          request.resource.data.propertyId,
                          null
                        )
                      )

                      ||

                      // ------------------------------------------------
                      // TENANT ACCEPTANCE — ADD ACCESS
                      // ------------------------------------------------

                      (
                        resource.data.tenantUserIds is list

                        &&

                        request.resource.data.tenantUserIds is list

                        &&

                        request.auth.uid in request.resource.data.tenantUserIds

                        &&

                        !(request.auth.uid in resource.data.tenantUserIds)

                        &&

                        request.resource.data.tenantUserIds.size()
                           == resource.data.tenantUserIds.size() + 1

                        &&

                        request.resource.data.tenantUserIds.hasAll(
                          resource.data.tenantUserIds
                        )

                        &&

                        request.resource.data.ownerId == resource.data.ownerId
                        &&
                        request.resource.data.name == resource.data.name
                        &&
                        request.resource.data.propertyCode == resource.data.propertyCode
                        &&
                        request.resource.data.address == resource.data.address
                        &&
                        request.resource.data.description == resource.data.description
                        &&
                        request.resource.data.type == resource.data.type
                        &&
                        request.resource.data.status == resource.data.status
                        &&
                        request.resource.data.numberOfFloors == resource.data.numberOfFloors

                        &&

                        isValidTenantAcceptance(
                          request.resource.data.ownerId,
                          propertyId,
                          null
                        )
                      )
                    );


      allow delete: if isAuthenticated()
                    && resource.data.ownerId == request.auth.uid;
    }


    // ============================================================
    // UNITS
    // ============================================================

    match /units/{unitId} {

      allow read: if isAuthenticated()
                  && (
                    isPropertyOwner(resource.data.propertyId)

                    ||

                    (
                      resource.data.tenantUserId == request.auth.uid
                      &&
                      isActiveTenantAccessForUnit(
                        resource.data.propertyId,
                        unitId
                      )
                    )
                  );


      allow create: if isAuthenticated()
                    && isPropertyOwner(
                      request.resource.data.propertyId
                    );


      allow update: if isAuthenticated()
                    && (

                      (
                        isPropertyOwner(
                          resource.data.propertyId
                        )

                        &&

                        isPropertyOwner(
                          request.resource.data.propertyId
                        )
                      )

                      ||

                      (
                        (
                          !resource.data.keys().hasAny(['tenantUserId'])
                          ||
                          resource.data.tenantUserId == null
                        )

                        &&

                        request.resource.data.tenantUserId == request.auth.uid

                        &&

                        request.resource.data.propertyId
                           == resource.data.propertyId

                        &&

                        request.resource.data.floorNumber
                           == resource.data.floorNumber

                        &&

                        request.resource.data.unitNumber
                           == resource.data.unitNumber

                        &&

                        request.resource.data.name
                           == resource.data.name

                        &&

                        request.resource.data.createdAt
                           == resource.data.createdAt

                        &&

                        request.resource.data.status == 'occupied'

                        &&

                        isValidTenantAcceptance(
                          null,
                          resource.data.propertyId,
                          unitId
                        )
                      )
                    );


      allow delete: if isAuthenticated()
                    && isPropertyOwner(
                      resource.data.propertyId
                    );
    }


    // ============================================================
    // TENANT ACCESS
    // ============================================================

    match /tenantAccess/{userId} {

      allow get: if isAuthenticated()
                 && request.auth.uid == userId;


      allow create: if isAuthenticated()

                    && request.resource.data.userId == userId

                    && request.resource.data.tenantId is string
                    && request.resource.data.ownerId is string
                    && request.resource.data.propertyId is string
                    && request.resource.data.unitId is string

                    && (

                      (
                        request.auth.uid == userId

                        &&

                        request.resource.data.userId == request.auth.uid

                        &&

                        request.resource.data.invitationId is string

                        &&

                        request.resource.data.invitationId != ''

                        &&

                        isValidInvitationTenantAccess()
                      )

                      ||

                      (
                        request.resource.data.invitationId == null

                        &&

                        isValidOwnerStartNewTenancyAccess()
                      )
                    );


      allow update: if isAuthenticated()
                    && request.auth.uid == userId

                    && request.resource.data.userId
                       == resource.data.userId

                    && request.resource.data.tenantId
                       == resource.data.tenantId

                    && request.resource.data.ownerId
                       == resource.data.ownerId

                    && request.resource.data.propertyId
                       == resource.data.propertyId

                    && request.resource.data.unitId
                       == resource.data.unitId

                    && request.resource.data.invitationId
                       == resource.data.invitationId

                    && request.resource.data.createdAt
                       == resource.data.createdAt

                    && request.resource.data.diff(resource.data)
                       .affectedKeys()
                       .hasOnly([
                         'updatedAt'
                       ])

                    && request.resource.data.updatedAt is timestamp
                    && request.resource.data.updatedAt <= request.time;


      allow delete: if isAuthenticated()
                    && (
                      request.auth.uid == resource.data.userId

                      ||

                      (
                        resource.data.ownerId == request.auth.uid
                        &&
                        isValidOwnerEndTenancyAccessDelete()
                      )
                    );
    }


    // ============================================================
    // TENANTS
    // ============================================================

    match /tenants/{tenantId} {

      allow read: if isAuthenticated()
                  && (
                    resource.data.ownerId == request.auth.uid

                    ||

                    resource.data.userId == request.auth.uid

                    ||

                    (
                      (
                        !resource.data.keys().hasAny(['userId'])
                        ||
                        resource.data.userId == null
                      )

                      &&

                      request.auth.token.phone_number != null

                      &&

                      resource.data.phone
                         == request.auth.token.phone_number
                    )
                  );


      allow create: if isAuthenticated()
                    && request.resource.data.ownerId == request.auth.uid
                    && isPropertyOwner(
                      request.resource.data.propertyId
                    );


      allow update: if isAuthenticated()
                    && (

                      // OWNER — NORMAL UPDATE
                      (
                        resource.data.ownerId == request.auth.uid

                        &&

                        request.resource.data.ownerId
                           == resource.data.ownerId

                        &&

                        request.resource.data.propertyId
                           == resource.data.propertyId

                        &&

                        request.resource.data.unitId
                           == resource.data.unitId

                        &&

                        request.resource.data.status
                           == resource.data.status

                        &&

                        isPropertyOwner(
                          request.resource.data.propertyId
                        )
                      )

                      ||

                      // OWNER — START NEW TENANCY
                      (
                        resource.data.ownerId == request.auth.uid

                        &&

                        resource.data.status == 'inactive'

                        &&

                        request.resource.data.ownerId
                           == resource.data.ownerId

                        &&

                        request.resource.data.status == 'active'

                        &&

                        request.resource.data.userId is string

                        &&

                        request.resource.data.userId
                           == resource.data.userId

                        &&

                        request.resource.data.accountStatus
                           == resource.data.accountStatus

                        &&

                        request.resource.data.confirmationStatus
                           == resource.data.confirmationStatus

                        &&

                        isValidOwnerStartNewTenancyTenant(
                          tenantId
                        )
                      )

                      ||

                      // OWNER — END TENANCY
                      (
                        resource.data.ownerId == request.auth.uid

                        &&

                        resource.data.status == 'active'

                        &&

                        request.resource.data.ownerId
                           == resource.data.ownerId

                        &&

                        request.resource.data.status == 'inactive'

                        &&

                        request.resource.data.userId
                           == resource.data.userId

                        &&

                        request.resource.data.propertyId
                           == resource.data.propertyId

                        &&

                        request.resource.data.unitId
                           == resource.data.unitId

                        &&

                        request.resource.data.accountStatus
                           == resource.data.accountStatus

                        &&

                        request.resource.data.confirmationStatus
                           == resource.data.confirmationStatus

                        &&

                        isValidOwnerEndTenancy()
                      )

                      ||

                      // ALREADY LINKED TENANT — NORMAL UPDATE
                      (
                        resource.data.userId == request.auth.uid

                        &&

                        request.resource.data.userId
                           == resource.data.userId

                        &&

                        request.resource.data.ownerId
                           == resource.data.ownerId

                        &&

                        request.resource.data.propertyId
                           == resource.data.propertyId

                        &&

                        request.resource.data.unitId
                           == resource.data.unitId

                        &&

                        request.resource.data.phone
                           == resource.data.phone

                        &&

                        request.resource.data.status
                           == resource.data.status

                        &&

                        request.resource.data.accountStatus
                           == resource.data.accountStatus

                        &&

                        request.resource.data.confirmationStatus
                           == resource.data.confirmationStatus

                        &&

                        request.resource.data.createdAt
                           == resource.data.createdAt
                      )

                      ||

                      // ALREADY LINKED INACTIVE TENANT — INVITATION
                      (
                        resource.data.userId == request.auth.uid

                        &&

                        resource.data.status == 'inactive'

                        &&

                        request.resource.data.userId
                           == resource.data.userId

                        &&

                        request.resource.data.ownerId
                           == resource.data.ownerId

                        &&

                        request.resource.data.propertyId
                           == resource.data.propertyId

                        &&

                        request.resource.data.unitId
                           == resource.data.unitId

                        &&

                        request.resource.data.phone
                           == resource.data.phone

                        &&

                        request.resource.data.accountStatus
                           == resource.data.accountStatus

                        &&

                        request.resource.data.status == 'active'

                        &&

                        request.resource.data.confirmationStatus
                           == 'confirmed'

                        &&

                        request.resource.data.tenancyStartedAt is timestamp

                        &&

                        request.resource.data.createdAt
                           == resource.data.createdAt

                        &&

                        isValidLinkedTenantInvitationAcceptance(
                          tenantId
                        )
                      )

                      ||

                      // FIRST-TIME TENANT LINK
                      (
                        (
                          !resource.data.keys().hasAny(['userId'])
                          ||
                          resource.data.userId == null
                        )

                        &&

                        request.auth.token.phone_number != null

                        &&

                        resource.data.phone
                           == request.auth.token.phone_number

                        &&

                        request.resource.data.userId
                           == request.auth.uid

                        &&

                        request.resource.data.ownerId
                           == resource.data.ownerId

                        &&

                        request.resource.data.propertyId
                           == resource.data.propertyId

                        &&

                        request.resource.data.unitId
                           == resource.data.unitId

                        &&

                        request.resource.data.phone
                           == resource.data.phone

                        &&

                        getAfter(
                          /databases/$(database)/documents/tenantAccess/$(request.auth.uid)
                        ).data.tenantId == tenantId

                        &&

                        getAfter(
                          /databases/$(database)/documents/tenantAccess/$(request.auth.uid)
                        ).data.ownerId
                           == resource.data.ownerId

                        &&

                        getAfter(
                          /databases/$(database)/documents/tenantAccess/$(request.auth.uid)
                        ).data.propertyId
                           == resource.data.propertyId

                        &&

                        getAfter(
                          /databases/$(database)/documents/tenantAccess/$(request.auth.uid)
                        ).data.unitId
                           == resource.data.unitId
                      )
                    );


      allow delete: if isAuthenticated()
                    && resource.data.ownerId == request.auth.uid;
    }


    // ============================================================
    // TENANCY HISTORIES
    // ============================================================

    match /tenancyHistories/{historyId} {

      allow read: if isAuthenticated()
                  && (
                    resource.data.ownerId == request.auth.uid

                    ||

                    (
                      resource.data.tenantUserId is string
                      &&
                      resource.data.tenantUserId == request.auth.uid
                    )
                  );


      allow create: if isAuthenticated()
                    && isValidOwnerEndTenancyHistory();

      allow update: if false;

      allow delete: if false;
    }


    // ============================================================
    // RENT RATES
    // ============================================================

    match /rentRates/{rentRateId} {

      allow read: if isAuthenticated()
                  && (
                    resource.data.ownerId == request.auth.uid

                    ||

                    isTenantRentRateAccess(
                      resource.data.ownerId,
                      resource.data.unitId
                    )
                  );


      allow create: if isAuthenticated()

                    && request.resource.data.ownerId is string
                    && request.resource.data.ownerId != ''

                    && request.resource.data.propertyId is string
                    && request.resource.data.propertyId != ''

                    && request.resource.data.unitId is string
                    && request.resource.data.unitId != ''

                    && request.resource.data.amount is number
                    && request.resource.data.amount > 0

                    && request.resource.data.effectiveFrom is timestamp

                    && request.resource.data.effectiveTo == null

                    && request.resource.data.source is string

                    && request.resource.data.source
                       in [
                         'initial',
                         'property',
                         'floor',
                         'unit'
                       ]

                    && (
                      !request.resource.data.keys()
                        .hasAny(['nextRentRateId'])

                      ||

                      request.resource.data.nextRentRateId == null
                    )

                    && (
                      !request.resource.data.keys()
                        .hasAny(['previousRentRateId'])

                      ||

                      request.resource.data.previousRentRateId == null

                      ||

                      (
                        request.resource.data.previousRentRateId is string
                        &&
                        request.resource.data.previousRentRateId != ''
                      )
                    )

                    && request.resource.data.createdAt is timestamp
                    && request.resource.data.updatedAt is timestamp

                    && (
                      isValidInitialRentRateCreate()

                      ||

                      isValidChangedRentRateCreate()
                    );


      allow update: if isAuthenticated()

                    && resource.data.ownerId == request.auth.uid

                    && request.resource.data.ownerId
                       == resource.data.ownerId

                    && request.resource.data.propertyId
                       == resource.data.propertyId

                    && request.resource.data.unitId
                       == resource.data.unitId

                    && request.resource.data.amount
                       == resource.data.amount

                    && request.resource.data.effectiveFrom
                       == resource.data.effectiveFrom

                    && request.resource.data.source
                       == resource.data.source

                    && (
                      (
                        !resource.data.keys()
                          .hasAny(['previousRentRateId'])

                        &&

                        (
                          !request.resource.data.keys()
                            .hasAny(['previousRentRateId'])

                          ||

                          request.resource.data.previousRentRateId == null
                        )
                      )

                      ||

                      (
                        resource.data.keys()
                          .hasAny(['previousRentRateId'])

                        &&

                        request.resource.data.keys()
                          .hasAny(['previousRentRateId'])

                        &&

                        request.resource.data.previousRentRateId
                           == resource.data.previousRentRateId
                      )
                    )

                    && request.resource.data.createdAt
                       == resource.data.createdAt

                    && resource.data.effectiveTo == null

                    && request.resource.data.effectiveTo is timestamp

                    && request.resource.data.effectiveTo
                       >= resource.data.effectiveFrom

                    && request.resource.data.updatedAt is timestamp

                    && request.resource.data.updatedAt <= request.time

                    && (
                      (
                        isValidEndTenancyRentRateClose()

                        &&

                        (
                          !request.resource.data.keys()
                            .hasAny(['nextRentRateId'])

                          ||

                          request.resource.data.nextRentRateId == null
                        )
                      )

                      ||

                      (
                        request.resource.data.nextRentRateId is string

                        &&

                        request.resource.data.nextRentRateId != ''

                        &&

                        isValidChangedRentRateClose()
                      )
                    );


      allow delete: if false;
    }


    // ============================================================
    // MONTHLY RENTS
    // ============================================================

    match /monthlyRents/{monthlyRentId} {

      allow read: if isAuthenticated()
                  && (
                    resource.data.ownerId == request.auth.uid

                    ||

                    (
                      resource.data.tenantUserId is string
                      &&
                      resource.data.tenantUserId == request.auth.uid
                    )
                  );


      allow create: if isAuthenticated()
                    && isValidMonthlyRentCreate();


      allow update: if isAuthenticated()

                    && resource.data.ownerId == request.auth.uid

                    && request.resource.data.ownerId
                       == resource.data.ownerId

                    && request.resource.data.propertyId
                       == resource.data.propertyId

                    && request.resource.data.unitId
                       == resource.data.unitId

                    && request.resource.data.tenantId
                       == resource.data.tenantId

                    && request.resource.data.tenantUserId
                       == resource.data.tenantUserId

                    && request.resource.data.rentRateId
                       == resource.data.rentRateId

                    && request.resource.data.amount
                       == resource.data.amount

                    && request.resource.data.billingPeriodStart
                       == resource.data.billingPeriodStart

                    && request.resource.data.billingPeriodEnd
                       == resource.data.billingPeriodEnd

                    && request.resource.data.dueDate
                       == resource.data.dueDate

                    && request.resource.data.createdAt
                       == resource.data.createdAt

                    && request.resource.data.status is string

                    && request.resource.data.status
                       in [
                         'unpaid',
                         'partiallyPaid',
                         'paid',
                         'overdue',
                         'cancelled'
                       ]

                    && request.resource.data.updatedAt is timestamp

                    && request.resource.data.updatedAt
                       >= resource.data.updatedAt

                    && request.resource.data.updatedAt
                       <= request.time;


      allow delete: if false;
    }


    // ============================================================
    // RENTS
    // ============================================================

    match /rents/{rentId} {

      allow read: if isAuthenticated()
                  && (
                    resource.data.ownerId == request.auth.uid

                    ||

                    (
                      resource.data.tenantUserId is string
                      &&
                      resource.data.tenantUserId == request.auth.uid
                    )
                  );


      allow create: if isAuthenticated()
                    && isValidOwnerCreateRent();

      allow update: if false;

      allow delete: if false;
    }


    // ============================================================
    // TENANT INVITATIONS
    // ============================================================

    match /tenantInvitations/{invitationId} {

      allow create: if isAuthenticated()

                    && request.resource.data.ownerId
                       == request.auth.uid

                    && request.resource.data.rentAmount
                       is number

                    && request.resource.data.rentAmount > 0

                    && exists(
                      /databases/$(database)/documents/tenants/$(request.resource.data.tenantId)
                    )

                    && get(
                      /databases/$(database)/documents/tenants/$(request.resource.data.tenantId)
                    ).data.ownerId == request.auth.uid

                    && get(
                      /databases/$(database)/documents/tenants/$(request.resource.data.tenantId)
                    ).data.propertyId
                       == request.resource.data.propertyId

                    && get(
                      /databases/$(database)/documents/tenants/$(request.resource.data.tenantId)
                    ).data.unitId
                       == request.resource.data.unitId;


      allow read: if isAuthenticated()
                  && (
                    resource.data.ownerId == request.auth.uid

                    ||

                    (
                      resource.data.tenantId is string
                      &&
                      resource.data.tenantId != ''

                      &&

                      exists(
                        /databases/$(database)/documents/tenants/$(resource.data.tenantId)
                      )

                      &&

                      get(
                        /databases/$(database)/documents/tenants/$(resource.data.tenantId)
                      ).data.userId == request.auth.uid
                    )
                  );


      allow update: if isAuthenticated()
                    && (

                      // OWNER
                      (
                        resource.data.ownerId == request.auth.uid

                        &&

                        request.resource.data.ownerId
                           == resource.data.ownerId

                        &&

                        request.resource.data.tenantId
                           == resource.data.tenantId

                        &&

                        request.resource.data.propertyId
                           == resource.data.propertyId

                        &&

                        request.resource.data.unitId
                           == resource.data.unitId

                        &&

                        request.resource.data.phone
                           == resource.data.phone

                        &&

                        request.resource.data.token
                           == resource.data.token

                        &&

                        request.resource.data.rentAmount
                           == resource.data.rentAmount

                        &&

                        request.resource.data.createdAt
                           == resource.data.createdAt

                        &&

                        request.resource.data.expiresAt
                           == resource.data.expiresAt
                      )

                      ||

                      // TENANT ACCEPTANCE
                      (
                        request.auth.token.phone_number != null

                        &&

                        resource.data.phone
                           == request.auth.token.phone_number

                        &&

                        resource.data.status == 'pending'

                        &&

                        request.resource.data.status == 'accepted'

                        &&

                        request.resource.data.ownerId
                           == resource.data.ownerId

                        &&

                        request.resource.data.tenantId
                           == resource.data.tenantId

                        &&

                        request.resource.data.propertyId
                           == resource.data.propertyId

                        &&

                        request.resource.data.unitId
                           == resource.data.unitId

                        &&

                        request.resource.data.phone
                           == resource.data.phone

                        &&

                        request.resource.data.token
                           == resource.data.token

                        &&

                        request.resource.data.rentAmount
                           == resource.data.rentAmount

                        &&

                        request.resource.data.createdAt
                           == resource.data.createdAt

                        &&

                        request.resource.data.expiresAt
                           == resource.data.expiresAt

                        &&

                        getAfter(
                          /databases/$(database)/documents/tenants/$(resource.data.tenantId)
                        ).data.userId == request.auth.uid

                        &&

                        getAfter(
                          /databases/$(database)/documents/tenantAccess/$(request.auth.uid)
                        ).data.tenantId
                           == resource.data.tenantId

                        &&

                        getAfter(
                          /databases/$(database)/documents/tenantAccess/$(request.auth.uid)
                        ).data.ownerId
                           == resource.data.ownerId

                        &&

                        getAfter(
                          /databases/$(database)/documents/tenantAccess/$(request.auth.uid)
                        ).data.propertyId
                           == resource.data.propertyId

                        &&

                        getAfter(
                          /databases/$(database)/documents/tenantAccess/$(request.auth.uid)
                        ).data.unitId
                           == resource.data.unitId

                        &&

                        getAfter(
                          /databases/$(database)/documents/tenantAccess/$(request.auth.uid)
                        ).data.invitationId
                           == invitationId
                      )

                      ||

                      // TENANT REJECTION
                      (
                        request.auth.token.phone_number != null

                        &&

                        resource.data.phone
                           == request.auth.token.phone_number

                        &&

                        resource.data.status == 'pending'

                        &&

                        request.resource.data.status == 'rejected'

                        &&

                        request.resource.data.ownerId
                           == resource.data.ownerId

                        &&

                        request.resource.data.tenantId
                           == resource.data.tenantId

                        &&

                        request.resource.data.propertyId
                           == resource.data.propertyId

                        &&

                        request.resource.data.unitId
                           == resource.data.unitId

                        &&

                        request.resource.data.phone
                           == resource.data.phone

                        &&

                        request.resource.data.token
                           == resource.data.token

                        &&

                        request.resource.data.rentAmount
                           == resource.data.rentAmount

                        &&

                        request.resource.data.createdAt
                           == resource.data.createdAt

                        &&

                        request.resource.data.expiresAt
                           == resource.data.expiresAt
                      )
                    );


      allow delete: if isAuthenticated()
                    && (
                      resource.data.ownerId == request.auth.uid

                      ||

                      (
                        request.auth.token.phone_number != null

                        &&

                        resource.data.phone
                           == request.auth.token.phone_number

                        &&

                        resource.data.status == 'pending'
                      )
                    );
    }


    // ============================================================
    // MONTHLY BILLS
    // ============================================================

    match /monthlyBills/{monthlyBillId} {

      allow read: if isAuthenticated()
                  && (
                    resource.data.ownerId == request.auth.uid

                    ||

                    (
                      resource.data.tenantUserId is string
                      &&
                      resource.data.tenantUserId == request.auth.uid
                    )
                  );


      allow create: if isAuthenticated()
                    && isValidMonthlyBillCreate();


      allow update: if isAuthenticated()
                    && isValidMonthlyBillUpdate();


      allow delete: if false;
    }


    // ============================================================
    // BILLING RULES
    // ============================================================

    match /billingRules/{ruleId} {

      // ----------------------------------------------------------
      // READ
      // ----------------------------------------------------------

      allow read: if isAuthenticated()
                  && resource.data.ownerId
                     == request.auth.uid;


      // ----------------------------------------------------------
      // CREATE
      // ----------------------------------------------------------

      allow create: if isAuthenticated()
                    && isValidBillingRuleCreate();


      // ----------------------------------------------------------
      // UPDATE
      // ----------------------------------------------------------

      allow update: if isAuthenticated()
                    && isValidBillingRuleUpdate();


      // ----------------------------------------------------------
      // DELETE
      // ----------------------------------------------------------

      allow delete: if false;
    }


    // ============================================================
    // BILLING RULE — CREATE VALIDATION
    // ============================================================

    function isValidBillingRuleCreate() {

      return

        // ==========================================================
        // OWNER
        // ==========================================================

        request.resource.data.ownerId
           == request.auth.uid


        // ==========================================================
        // REQUIRED IDS
        // ==========================================================

        && request.resource.data.ownerId is string
        && request.resource.data.ownerId != ''

        && request.resource.data.propertyId is string
        && request.resource.data.propertyId != ''

        && request.resource.data.scopeId is string
        && request.resource.data.scopeId != ''


        // ==========================================================
        // PROPERTY OWNERSHIP
        // ==========================================================

        && isPropertyOwner(
          request.resource.data.propertyId
        )


        // ==========================================================
        // SCOPE
        // ==========================================================

        && request.resource.data.scopeType is string

        && request.resource.data.scopeType
           in [
             'property',
             'floor',
             'unit',
             'tenant'
           ]
        // A property-level rule must reference the actual property ID.
        && (
          request.resource.data.scopeType != 'property'
          ||
          request.resource.data.scopeId
             == request.resource.data.propertyId
        )

        // ==========================================================
        // CHARGE TYPE
        // ==========================================================

        && request.resource.data.chargeType is string

        && request.resource.data.chargeType
           in [
             'water',
             'gas',
             'garbage',
             'serviceCharge',
             'electricity',
             'other'
           ]


        // ==========================================================
        // VALUE TYPE
        // ==========================================================

        && request.resource.data.valueType is string

        && request.resource.data.valueType
           in [
             'fixed',
             'variable'
           ]


        // ==========================================================
        // AMOUNT
        //
        // Both Fixed and Variable rules have an amount.
        // ==========================================================

        && request.resource.data.amount is number

        && request.resource.data.amount >= 0


        // ==========================================================
        // EFFECTIVE DATES
        // ==========================================================

        && request.resource.data.effectiveFrom is timestamp

        && (
          request.resource.data.effectiveTo == null

          ||

          (
            request.resource.data.effectiveTo is timestamp

            &&

            request.resource.data.effectiveTo
               > request.resource.data.effectiveFrom
          )
        )


        // ==========================================================
        // ACTIVE STATE
        // ==========================================================

        && request.resource.data.isActive is bool


        // ==========================================================
        // TITLE
        // ==========================================================

        && (
          !request.resource.data.keys().hasAny(['title'])

          ||

          request.resource.data.title == null

          ||

          request.resource.data.title is string
        )


        // ==========================================================
        // CREATED / UPDATED
        // ==========================================================

        && request.resource.data.createdAt is timestamp

        && request.resource.data.updatedAt is timestamp

        && request.resource.data.createdAt
           <= request.time

        && request.resource.data.updatedAt
           <= request.time

        && request.resource.data.updatedAt
           >= request.resource.data.createdAt


        // ==========================================================
        // VARIABLE RULE
        //
        // Variable is a month-specific override.
        //
        // The DataSource sets:
        // effectiveTo = next month start.
        //
        // This prevents an open-ended variable rule.
        // ==========================================================

        && (
          (
            request.resource.data.valueType == 'fixed'
          )

          ||

          (
            request.resource.data.valueType == 'variable'

            &&

            request.resource.data.effectiveTo is timestamp
          )
        );
    }


    // ============================================================
    // BILLING RULE — UPDATE VALIDATION
    // ============================================================

    function isValidBillingRuleUpdate() {

      return

        // ==========================================================
        // OWNER
        // ==========================================================

        resource.data.ownerId
           == request.auth.uid

        && request.resource.data.ownerId
           == resource.data.ownerId


        // ==========================================================
        // PROPERTY CANNOT CHANGE
        // ==========================================================

        && request.resource.data.propertyId
           == resource.data.propertyId

        && isPropertyOwner(
          resource.data.propertyId
        )


        // ==========================================================
        // RULE ID / SCOPE / TYPE
        // ==========================================================

        && request.resource.data.scopeType
           == resource.data.scopeType

        && request.resource.data.scopeId
           == resource.data.scopeId

        && request.resource.data.chargeType
           == resource.data.chargeType
        // A property-level rule must reference the actual property ID.
        && (
          request.resource.data.scopeType != 'property'
          ||
          request.resource.data.scopeId
             == request.resource.data.propertyId
        )

        // ==========================================================
        // VALUE TYPE
        //
        // Do not convert Fixed <-> Variable by editing an existing
        // rule. Create the appropriate version instead.
        // ==========================================================

        && request.resource.data.valueType
           == resource.data.valueType


        // ==========================================================
        // AMOUNT
        //
        // Amount is editable because the Edit Billing Rule screen
        // allows changing the configured amount.
        //
        // Generated MonthlyBills keep their own snapshot amount.
        // ==========================================================

        && request.resource.data.amount is number

        && request.resource.data.amount >= 0


        // ==========================================================
        // EFFECTIVE FROM
        // ==========================================================

        && request.resource.data.effectiveFrom is timestamp


        // ==========================================================
        // EFFECTIVE TO
        // ==========================================================

        && (
          request.resource.data.effectiveTo == null

          ||

          (
            request.resource.data.effectiveTo is timestamp

            &&

            request.resource.data.effectiveTo
               > request.resource.data.effectiveFrom
          )
        )


        // ==========================================================
        // VARIABLE RULE MUST HAVE A BOUNDED PERIOD
        // ==========================================================

        && (
          request.resource.data.valueType == 'fixed'

          ||

          (
            request.resource.data.valueType == 'variable'

            &&

            request.resource.data.effectiveTo is timestamp
          )
        )


        // ==========================================================
        // ACTIVE
        // ==========================================================

        && request.resource.data.isActive is bool


        // ==========================================================
        // TITLE
        // ==========================================================

        && (
          !request.resource.data.keys().hasAny(['title'])

          ||

          request.resource.data.title == null

          ||

          request.resource.data.title is string
        )


        // ==========================================================
        // CREATED AT IMMUTABLE
        // ==========================================================

        && request.resource.data.createdAt
           == resource.data.createdAt


        // ==========================================================
        // UPDATED AT
        // ==========================================================

        && request.resource.data.updatedAt is timestamp

        && request.resource.data.updatedAt
           >= resource.data.updatedAt

        && request.resource.data.updatedAt
           <= request.time;
    }


    // ============================================================
    // MONTHLY BILL — CREATE VALIDATION
    // ============================================================

    function isValidMonthlyBillCreate() {

      let property =
        get(
          /databases/$(database)/documents/properties/$(request.resource.data.propertyId)
        ).data;

      let tenant =
        get(
          /databases/$(database)/documents/tenants/$(request.resource.data.tenantId)
        ).data;

      let billingRule =
        get(
          /databases/$(database)/documents/billingRules/$(request.resource.data.sourceRuleId)
        ).data;


      return

        // ==========================================================
        // AUTHENTICATED OWNER
        // ==========================================================

        request.resource.data.ownerId
           == request.auth.uid

        && property.ownerId
           == request.auth.uid

        && tenant.ownerId
           == request.auth.uid


        // ==========================================================
        // TENANT BELONGS TO PROPERTY / UNIT
        // ==========================================================

        && tenant.propertyId
           == request.resource.data.propertyId

        && tenant.unitId
           == request.resource.data.unitId


        // ==========================================================
        // TENANT USER LINK
        // ==========================================================

        && (
          (
            tenant.userId is string

            &&

            tenant.userId != ''

            &&

            request.resource.data.tenantUserId
               == tenant.userId
          )

          ||

          (
            (
              !tenant.keys().hasAny(['userId'])

              ||

              tenant.userId == null

              ||

              (
                tenant.userId is string
                &&
                tenant.userId == ''
              )
            )

            &&

            request.resource.data.tenantUserId == null
          )
        )


        // ==========================================================
        // BILLING RULE OWNERSHIP
        // ==========================================================

        && billingRule.ownerId
           == request.auth.uid

        && billingRule.propertyId
           == request.resource.data.propertyId


        // ==========================================================
        // BILLING RULE TYPE
        // ==========================================================

        && request.resource.data.type != 'rent'

        && billingRule.valueType
           == request.resource.data.valueType

        && isMatchingMonthlyBillType(
          billingRule.chargeType,
          request.resource.data.type
        )


        // ==========================================================
        // BILLING RULE EFFECTIVE PERIOD
        //
        // effectiveTo is EXCLUSIVE.
        //
        // Example:
        //
        // Fixed:
        //   Sep 1 -> null
        //
        // Variable:
        //   Oct 1 -> Nov 1
        //
        // October uses Variable.
        // November falls back to Fixed.
        // ==========================================================

        && billingRule.effectiveFrom
           <= request.resource.data.billingPeriodStart

        && (
          billingRule.effectiveTo == null

          ||

          request.resource.data.billingPeriodStart
             < billingRule.effectiveTo
        )

&& (

          billingRule.isActive == true

          ||

          (

            billingRule.valueType == 'fixed'

            &&

            billingRule.effectiveTo is timestamp

            &&

            request.resource.data.billingPeriodStart

               < billingRule.effectiveTo

          )

        )
        // ==========================================================
        // BILLING RULE SCOPE
        // ==========================================================

        && isBillingRuleApplicableToMonthlyBill(
          billingRule,
          request.resource.data
        )


        // ==========================================================
        // BASIC IDENTITY FIELDS
        // ==========================================================

        && request.resource.data.propertyId is string
        && request.resource.data.propertyId != ''

        && request.resource.data.floorId is string
        && request.resource.data.floorId != ''

        && request.resource.data.unitId is string
        && request.resource.data.unitId != ''

        && request.resource.data.tenantId is string
        && request.resource.data.tenantId != ''

        && request.resource.data.sourceRuleId is string
        && request.resource.data.sourceRuleId != ''

        && request.resource.data.type is string
        && request.resource.data.type != ''

        && request.resource.data.valueType is string
        && request.resource.data.valueType != ''


        // ==========================================================
        // BILLING PERIOD
        // ==========================================================

        && request.resource.data.billingPeriodStart is timestamp

        && request.resource.data.billingPeriodEnd is timestamp

        && request.resource.data.billingPeriodEnd
           > request.resource.data.billingPeriodStart


        // ==========================================================
        // DUE DATE
        // ==========================================================

        && request.resource.data.dueDate is timestamp

        && request.resource.data.dueDate
           >= request.resource.data.billingPeriodStart


        // ==========================================================
        // AMOUNT
        // ==========================================================

        && request.resource.data.amount is number

        && request.resource.data.amount >= 0


        // ==========================================================
        // PAID AMOUNT
        // ==========================================================

        && request.resource.data.paidAmount is number

        && request.resource.data.paidAmount == 0


        // ==========================================================
        // CREATED / UPDATED
        // ==========================================================

        && request.resource.data.createdAt is timestamp

        && request.resource.data.updatedAt is timestamp

        && request.resource.data.createdAt
           == request.resource.data.updatedAt

        && request.resource.data.createdAt
           <= request.time

        && request.resource.data.updatedAt
           <= request.time


        // ==========================================================
        // FINAL BILL AMOUNT
        //
        // Both Fixed and Variable rules have an amount BEFORE
        // MonthlyBill creation.
        //
        // Therefore:
        //
        // billingRule.amount == monthlyBill.amount
        //
        // No pending / zero-amount variable bill exists.
        // ==========================================================

        && billingRule.amount is number

        && billingRule.amount >= 0

        && request.resource.data.amount
           == billingRule.amount

        && request.resource.data.status == 'unpaid';
    }


    // ============================================================
    // SECURITY HELPERS
    // ============================================================

    function isAuthenticated() {
      return request.auth != null;
    }


    // ============================================================
    // PROPERTY TENANT ACCESS
    // ============================================================

    function isValidPropertyTenantAccess(propertyId) {

      return exists(
        /databases/$(database)/documents/tenantAccess/$(request.auth.uid)
      )

      &&

      get(
        /databases/$(database)/documents/tenantAccess/$(request.auth.uid)
      ).data.userId == request.auth.uid

      &&

      get(
        /databases/$(database)/documents/tenantAccess/$(request.auth.uid)
      ).data.propertyId == propertyId

      &&

      get(
        /databases/$(database)/documents/tenantAccess/$(request.auth.uid)
      ).data.ownerId
         == resource.data.ownerId;
    }


    // ============================================================
    // MONTHLY BILL TYPE ↔ BILLING RULE CHARGE TYPE
    // ============================================================

    function isMatchingMonthlyBillType(
      chargeType,
      billType
    ) {

      return

        (
          chargeType == 'water'
          &&
          billType == 'water'
        )

        ||

        (
          chargeType == 'gas'
          &&
          billType == 'gas'
        )

        ||

        (
          chargeType == 'garbage'
          &&
          billType == 'garbage'
        )

        ||

        (
          chargeType == 'serviceCharge'
          &&
          billType == 'serviceCharge'
        )

        ||

        (
          chargeType == 'electricity'
          &&
          billType == 'electricity'
        )

        ||

        (
          chargeType == 'other'
          &&
          billType == 'other'
        );
    }


    // ============================================================
    // BILLING RULE SCOPE VALIDATION
    //
    // Property → propertyId
    // Floor    → floorId
    // Unit     → unitId
    // Tenant   → tenantId
    // ============================================================

    function isBillingRuleApplicableToMonthlyBill(
      rule,
      bill
    ) {

      return

        (
          rule.scopeType == 'property'

          &&

          rule.scopeId == bill.propertyId
        )

        ||

        (
          rule.scopeType == 'floor'

          &&

          rule.scopeId == bill.floorId
        )

        ||

        (
          rule.scopeType == 'unit'

          &&

          rule.scopeId == bill.unitId
        )

        ||

        (
          rule.scopeType == 'tenant'

          &&

          rule.scopeId == bill.tenantId
        );
    }


    // ============================================================
    // MONTHLY BILL — UPDATE VALIDATION
    // ============================================================

    function isValidMonthlyBillUpdate() {

      return

        // ==========================================================
        // ONLY OWNER
        // ==========================================================

        resource.data.ownerId
           == request.auth.uid


        // ==========================================================
        // IMMUTABLE IDENTITY
        // ==========================================================

        && request.resource.data.ownerId
           == resource.data.ownerId

        && request.resource.data.propertyId
           == resource.data.propertyId

        && request.resource.data.floorId
           == resource.data.floorId

        && request.resource.data.unitId
           == resource.data.unitId

        && request.resource.data.tenantId
           == resource.data.tenantId

        && request.resource.data.tenantUserId
           == resource.data.tenantUserId


        // ==========================================================
        // IMMUTABLE SOURCE
        // ==========================================================

        && request.resource.data.sourceRuleId
           == resource.data.sourceRuleId

        && request.resource.data.type
           == resource.data.type

        && request.resource.data.valueType
           == resource.data.valueType


        // ==========================================================
        // IMMUTABLE PERIOD
        // ==========================================================

        && request.resource.data.billingPeriodStart
           == resource.data.billingPeriodStart

        && request.resource.data.billingPeriodEnd
           == resource.data.billingPeriodEnd

        && request.resource.data.dueDate
           == resource.data.dueDate


        // ==========================================================
        // IMMUTABLE CREATED AT
        // ==========================================================

        && request.resource.data.createdAt
           == resource.data.createdAt


        // ==========================================================
        // AMOUNT IS IMMUTABLE AFTER GENERATION
        //
        // This is important.
        //
        // There is NO longer an "enter variable amount later"
        // workflow.
        //
        // Therefore generated bill amount must remain unchanged.
        // ==========================================================

        && request.resource.data.amount is number

        && request.resource.data.amount
           == resource.data.amount


        // ==========================================================
        // PAID AMOUNT
        // ==========================================================

        && request.resource.data.paidAmount is number

        && request.resource.data.paidAmount >= 0

        && request.resource.data.paidAmount
           <= request.resource.data.amount


        // ==========================================================
        // STATUS
        // ==========================================================

        && request.resource.data.status is string

        && request.resource.data.status in [
          'unpaid',
          'partiallyPaid',
          'paid',
          'overdue',
          'cancelled'
        ]


        // ==========================================================
        // STATUS / PAYMENT CONSISTENCY
        // ==========================================================

        && (
                  (
                    request.resource.data.status == 'unpaid'

                    && request.resource.data.amount >= 0

                    && request.resource.data.paidAmount == 0
                  )

          ||

          (
            request.resource.data.status == 'partiallyPaid'

            && request.resource.data.amount > 0

            && request.resource.data.paidAmount > 0

            && request.resource.data.paidAmount
               < request.resource.data.amount
          )

          ||

          (
            request.resource.data.status == 'paid'

            && request.resource.data.amount > 0

            && request.resource.data.paidAmount
               == request.resource.data.amount
          )

          ||

          (
            request.resource.data.status == 'overdue'

            && request.resource.data.amount > 0

            && request.resource.data.paidAmount
               < request.resource.data.amount
          )

          ||

          (
            request.resource.data.status == 'cancelled'

            && request.resource.data.paidAmount == 0
          )
        )


        // ==========================================================
        // UPDATED AT
        // ==========================================================

        && request.resource.data.updatedAt is timestamp

        && request.resource.data.updatedAt
           >= resource.data.updatedAt

        && request.resource.data.updatedAt
           <= request.time;
    }


    // ============================================================
    // PROPERTY OWNER
    // ============================================================

    function isPropertyOwner(propertyId) {

      return exists(
        /databases/$(database)/documents/properties/$(propertyId)
      )

      &&

      get(
        /databases/$(database)/documents/properties/$(propertyId)
      ).data.ownerId == request.auth.uid;
    }


    // ============================================================
    // TENANT RENT RATE ACCESS
    // ============================================================

    function isTenantRentRateAccess(
      ownerId,
      unitId
    ) {

      return exists(
        /databases/$(database)/documents/tenantAccess/$(request.auth.uid)
      )

      &&

      get(
        /databases/$(database)/documents/tenantAccess/$(request.auth.uid)
      ).data.userId == request.auth.uid

      &&

      get(
        /databases/$(database)/documents/tenantAccess/$(request.auth.uid)
      ).data.ownerId == ownerId

      &&

      get(
        /databases/$(database)/documents/tenantAccess/$(request.auth.uid)
      ).data.unitId == unitId;
    }


    // ============================================================
    // VALIDATE TENANT ACCEPTANCE
    // ============================================================

    function isValidTenantAcceptance(
      ownerId,
      propertyId,
      unitId
    ) {

      let access =
        getAfter(
          /databases/$(database)/documents/tenantAccess/$(request.auth.uid)
        ).data;

      return access.userId == request.auth.uid

             && access.ownerId
                == (
                  ownerId == null
                  ? access.ownerId
                  : ownerId
                )

             && (
               propertyId == null
               ||
               access.propertyId == propertyId
             )

             && (
               unitId == null
               ||
               access.unitId == unitId
             );
    }


    // ============================================================
    // TENANT UNIT / PROPERTY ACCESS
    // ============================================================

    function isActiveTenantAccessForUnit(
      propertyId,
      unitId
    ) {

      return exists(
        /databases/$(database)/documents/tenantAccess/$(request.auth.uid)
      )

      &&

      get(
        /databases/$(database)/documents/tenantAccess/$(request.auth.uid)
      ).data.userId == request.auth.uid

      &&

      get(
        /databases/$(database)/documents/tenantAccess/$(request.auth.uid)
      ).data.propertyId == propertyId

      &&

      get(
        /databases/$(database)/documents/tenantAccess/$(request.auth.uid)
      ).data.unitId == unitId;
    }


    // ============================================================
    // INVITATION TENANT ACCESS
    // ============================================================

    function isValidInvitationTenantAccess() {

      let tenantAfter =
        getAfter(
          /databases/$(database)/documents/tenants/$(request.resource.data.tenantId)
        ).data;

      let invitationAfter =
        getAfter(
          /databases/$(database)/documents/tenantInvitations/$(request.resource.data.invitationId)
        ).data;

      return tenantAfter.userId == request.auth.uid

             && tenantAfter.ownerId
                == request.resource.data.ownerId

             && tenantAfter.propertyId
                == request.resource.data.propertyId

             && tenantAfter.unitId
                == request.resource.data.unitId

             && invitationAfter.status == 'accepted'

             && invitationAfter.tenantId
                == request.resource.data.tenantId

             && invitationAfter.propertyId
                == request.resource.data.propertyId

             && invitationAfter.unitId
                == request.resource.data.unitId

             && invitationAfter.ownerId
                == request.resource.data.ownerId;
    }


    // ============================================================
    // LINKED TENANT — INVITATION ACCEPTANCE
    // ============================================================

    function isValidLinkedTenantInvitationAcceptance(
      tenantId
    ) {

      let accessAfter =
        getAfter(
          /databases/$(database)/documents/tenantAccess/$(request.auth.uid)
        ).data;

      let invitationAfter =
        getAfter(
          /databases/$(database)/documents/tenantInvitations/$(accessAfter.invitationId)
        ).data;

      let tenantAfter =
        getAfter(
          /databases/$(database)/documents/tenants/$(tenantId)
        ).data;

      return

        accessAfter.userId
           == request.auth.uid

        && accessAfter.tenantId
           == tenantId

        && accessAfter.ownerId
           == resource.data.ownerId

        && accessAfter.propertyId
           == resource.data.propertyId

        && accessAfter.unitId
           == resource.data.unitId

        && accessAfter.invitationId is string

        && accessAfter.invitationId != ''

        && invitationAfter.status == 'accepted'

        && invitationAfter.tenantId
           == tenantId

        && invitationAfter.ownerId
           == resource.data.ownerId

        && invitationAfter.propertyId
           == resource.data.propertyId

        && invitationAfter.unitId
           == resource.data.unitId

        && invitationAfter.phone
           == resource.data.phone

        && tenantAfter.userId
           == request.auth.uid

        && tenantAfter.ownerId
           == resource.data.ownerId

        && tenantAfter.propertyId
           == resource.data.propertyId

        && tenantAfter.unitId
           == resource.data.unitId

        && tenantAfter.status == 'active'

        && tenantAfter.accountStatus
           == resource.data.accountStatus

        && tenantAfter.confirmationStatus
           == 'confirmed'

        && tenantAfter.tenancyStartedAt is timestamp;
    }


    // ============================================================
    // UNIT ASSIGNMENT STATE
    // ============================================================

    function isUnitUnassigned(unitData) {

      return !unitData.keys().hasAny(['tenantUserId'])

             ||

             unitData.tenantUserId == null

             ||

             (
               unitData.tenantUserId is string
               &&
               unitData.tenantUserId == ''
             );
    }


    // ============================================================
    // OWNER — START NEW TENANCY
    // TENANT ACCESS VALIDATION
    // ============================================================

    function isValidOwnerStartNewTenancyAccess() {

      let tenantBefore =
        get(
          /databases/$(database)/documents/tenants/$(request.resource.data.tenantId)
        ).data;

      let tenantAfter =
        getAfter(
          /databases/$(database)/documents/tenants/$(request.resource.data.tenantId)
        ).data;

      let propertyAfter =
        getAfter(
          /databases/$(database)/documents/properties/$(request.resource.data.propertyId)
        ).data;

      let unitBefore =
        get(
          /databases/$(database)/documents/units/$(request.resource.data.unitId)
        ).data;

      let unitAfter =
        getAfter(
          /databases/$(database)/documents/units/$(request.resource.data.unitId)
        ).data;

      return request.resource.data.invitationId == null

             && request.resource.data.userId is string

             && request.resource.data.userId != ''

             && tenantBefore.ownerId == request.auth.uid

             && tenantBefore.status == 'inactive'

             && tenantBefore.accountStatus == 'registered'

             && tenantBefore.userId is string

             && tenantBefore.userId
                == request.resource.data.userId

             && tenantAfter.userId
                == request.resource.data.userId

             && tenantAfter.ownerId
                == request.auth.uid

             && tenantAfter.status == 'active'

             && tenantAfter.accountStatus == 'registered'

             && tenantAfter.propertyId
                == request.resource.data.propertyId

             && tenantAfter.unitId
                == request.resource.data.unitId

             && unitBefore.propertyId
                == request.resource.data.propertyId

             && unitBefore.status == 'available'

             && isUnitUnassigned(unitBefore)

             && propertyAfter.ownerId
                == request.auth.uid

             && propertyAfter.tenantUserIds is list

             && request.resource.data.userId
                in propertyAfter.tenantUserIds

             && unitAfter.propertyId
                == request.resource.data.propertyId

             && unitAfter.status == 'occupied'

             && unitAfter.tenantUserId
                == request.resource.data.userId;
    }


    // ============================================================
    // OWNER — START NEW TENANCY
    // TENANT DOCUMENT VALIDATION
    // ============================================================

    function isValidOwnerStartNewTenancyTenant(
      tenantId
    ) {

      let tenantBefore =
        get(
          /databases/$(database)/documents/tenants/$(tenantId)
        ).data;

      let propertyAfter =
        getAfter(
          /databases/$(database)/documents/properties/$(request.resource.data.propertyId)
        ).data;

      let unitAfter =
        getAfter(
          /databases/$(database)/documents/units/$(request.resource.data.unitId)
        ).data;

      let accessAfter =
        getAfter(
          /databases/$(database)/documents/tenantAccess/$(request.resource.data.userId)
        ).data;

      return tenantBefore.ownerId == request.auth.uid

             && tenantBefore.status == 'inactive'

             && tenantBefore.accountStatus == 'registered'

             && tenantBefore.userId is string

             && tenantBefore.userId
                == request.resource.data.userId

             && propertyAfter.ownerId
                == request.auth.uid

             && propertyAfter.tenantUserIds is list

             && request.resource.data.userId
                in propertyAfter.tenantUserIds

             && unitAfter.propertyId
                == request.resource.data.propertyId

             && unitAfter.status == 'occupied'

             && unitAfter.tenantUserId
                == request.resource.data.userId

             && accessAfter.userId
                == request.resource.data.userId

             && accessAfter.tenantId
                == tenantId

             && accessAfter.ownerId
                == request.auth.uid

             && accessAfter.propertyId
                == request.resource.data.propertyId

             && accessAfter.unitId
                == request.resource.data.unitId

             && accessAfter.invitationId == null;
    }


    // ============================================================
    // OWNER — END TENANCY
    // TENANT DOCUMENT VALIDATION
    // ============================================================

    function isValidOwnerEndTenancy() {

      let propertyAfter =
        getAfter(
          /databases/$(database)/documents/properties/$(request.resource.data.propertyId)
        ).data;

      let unitAfter =
        getAfter(
          /databases/$(database)/documents/units/$(request.resource.data.unitId)
        ).data;

      return propertyAfter.ownerId == request.auth.uid

             && propertyAfter.tenantUserIds is list

             && !(request.resource.data.userId
                  in propertyAfter.tenantUserIds)

             && unitAfter.propertyId
                == request.resource.data.propertyId

             && unitAfter.status == 'available'

             && isUnitUnassigned(unitAfter)

             && !existsAfter(
                  /databases/$(database)/documents/tenantAccess/$(request.resource.data.userId)
                );
    }


    // ============================================================
    // OWNER — END TENANCY
    // TENANT ACCESS DELETE VALIDATION
    // ============================================================

    function isValidOwnerEndTenancyAccessDelete() {

      let tenantAfter =
        getAfter(
          /databases/$(database)/documents/tenants/$(resource.data.tenantId)
        ).data;

      return tenantAfter.ownerId == request.auth.uid

             && tenantAfter.userId
                == resource.data.userId

             && tenantAfter.propertyId
                == resource.data.propertyId

             && tenantAfter.unitId
                == resource.data.unitId

             && tenantAfter.status == 'inactive';
    }


    // ============================================================
    // OWNER — END TENANCY
    // TENANCY HISTORY VALIDATION
    // ============================================================

    function isValidOwnerEndTenancyHistory() {

      let tenantAfter =
        getAfter(
          /databases/$(database)/documents/tenants/$(request.resource.data.tenantId)
        ).data;

      let propertyAfter =
        getAfter(
          /databases/$(database)/documents/properties/$(request.resource.data.propertyId)
        ).data;

      let unitAfter =
        getAfter(
          /databases/$(database)/documents/units/$(request.resource.data.unitId)
        ).data;

      return isAuthenticated()

        && request.resource.data.tenantId is string
        && request.resource.data.tenantId != ''

        && request.resource.data.ownerId
           == request.auth.uid

        && tenantAfter.ownerId
           == request.auth.uid

        && tenantAfter.status == 'inactive'

        && tenantAfter.propertyId
           == request.resource.data.propertyId

        && tenantAfter.unitId
           == request.resource.data.unitId

        && request.resource.data.tenantName
           == tenantAfter.name

        && (
          (
            (
              !tenantAfter.keys().hasAny(['userId'])
              ||
              tenantAfter.userId == null
            )

            &&

            request.resource.data.tenantUserId == null
          )

          ||

          (
            tenantAfter.userId is string
            &&
            tenantAfter.userId != ''
            &&
            request.resource.data.tenantUserId
               == tenantAfter.userId
          )
        )

        && tenantAfter.tenancyStartedAt != null

        && request.resource.data.startedAt
           == tenantAfter.tenancyStartedAt

        && request.resource.data.endedAt is timestamp

        && request.resource.data.startedAt is timestamp

        && request.resource.data.endedAt
           >= request.resource.data.startedAt

        && request.resource.data.endedAt <= request.time

        && request.resource.data.status == 'ended'

        && request.resource.data.monthlyRent is number

        && request.resource.data.monthlyRent > 0

        && propertyAfter.ownerId
           == request.auth.uid

        && request.resource.data.propertyName
           == propertyAfter.name

        && request.resource.data.propertyCode
           == propertyAfter.propertyCode

        && (
          (
            !propertyAfter.keys().hasAny(['address'])
            &&
            request.resource.data.propertyAddress == null
          )

          ||

          (
            propertyAfter.address == null
            &&
            request.resource.data.propertyAddress == null
          )

          ||

          (
            propertyAfter.address is string
            &&
            request.resource.data.propertyAddress
               == propertyAfter.address
          )
        )

        && propertyAfter.tenantUserIds is list

        && (
          request.resource.data.tenantUserId == null

          ||

          !(request.resource.data.tenantUserId
             in propertyAfter.tenantUserIds)
        )

        && unitAfter.propertyId
           == request.resource.data.propertyId

        && request.resource.data.unitNumber
           == unitAfter.unitNumber

        && (
          (
            !unitAfter.keys().hasAny(['name'])
            &&
            request.resource.data.unitName == null
          )

          ||

          (
            unitAfter.name == null
            &&
            request.resource.data.unitName == null
          )

          ||

          (
            unitAfter.name is string
            &&
            request.resource.data.unitName
               == unitAfter.name
          )
        )

        && request.resource.data.floorNumber
           == unitAfter.floorNumber

        && unitAfter.status == 'available'

        && isUnitUnassigned(unitAfter)

        && (
          request.resource.data.tenantUserId == null

          ||

          !existsAfter(
            /databases/$(database)/documents/tenantAccess/$(request.resource.data.tenantUserId)
          )
        )

        && request.resource.data.createdAt == request.time;
    }


    // ============================================================
    // RENT RATE — INITIAL CREATE
    // ============================================================

    function isValidInitialRentRateCreate() {

      return
        isValidOwnerInitialRentRateCreate()

        ||

        isValidInvitationInitialRentRateCreate();
    }


    // ============================================================
    // RENT RATE — INITIAL CREATE
    // OWNER START
    // ============================================================

    function isValidOwnerInitialRentRateCreate() {

      let unitAfter =
        getAfter(
          /databases/$(database)/documents/units/$(request.resource.data.unitId)
        ).data;

      let accessAfter =
        getAfter(
          /databases/$(database)/documents/tenantAccess/$(unitAfter.tenantUserId)
        ).data;

      let tenantAfter =
        getAfter(
          /databases/$(database)/documents/tenants/$(accessAfter.tenantId)
        ).data;

      let propertyAfter =
        getAfter(
          /databases/$(database)/documents/properties/$(request.resource.data.propertyId)
        ).data;

      return

        request.auth.uid
           == request.resource.data.ownerId

        && request.resource.data.source == 'initial'

        && unitAfter.propertyId
           == request.resource.data.propertyId

        && unitAfter.status == 'occupied'

        && unitAfter.tenantUserId is string

        && unitAfter.tenantUserId != ''

        && accessAfter.userId
           == unitAfter.tenantUserId

        && accessAfter.ownerId
           == request.auth.uid

        && accessAfter.propertyId
           == request.resource.data.propertyId

        && accessAfter.unitId
           == request.resource.data.unitId

        && accessAfter.invitationId == null

        && tenantAfter.ownerId
           == request.auth.uid

        && tenantAfter.userId
           == unitAfter.tenantUserId

        && tenantAfter.status == 'active'

        && tenantAfter.propertyId
           == request.resource.data.propertyId

        && tenantAfter.unitId
           == request.resource.data.unitId

        && tenantAfter.tenancyStartedAt is timestamp

        && request.resource.data.effectiveFrom
           == tenantAfter.tenancyStartedAt

        && propertyAfter.ownerId
           == request.auth.uid

        && propertyAfter.tenantUserIds is list

        && unitAfter.tenantUserId
           in propertyAfter.tenantUserIds;
    }


    // ============================================================
    // RENT RATE — INITIAL CREATE
    // INVITATION ACCEPTANCE
    // ============================================================

    function isValidInvitationInitialRentRateCreate() {

      let unitAfter =
        getAfter(
          /databases/$(database)/documents/units/$(request.resource.data.unitId)
        ).data;

      let accessAfter =
        getAfter(
          /databases/$(database)/documents/tenantAccess/$(request.auth.uid)
        ).data;

      let tenantAfter =
        getAfter(
          /databases/$(database)/documents/tenants/$(accessAfter.tenantId)
        ).data;

      let invitationAfter =
        getAfter(
          /databases/$(database)/documents/tenantInvitations/$(accessAfter.invitationId)
        ).data;

      let propertyAfter =
        getAfter(
          /databases/$(database)/documents/properties/$(request.resource.data.propertyId)
        ).data;

      return

        request.auth.uid
           == unitAfter.tenantUserId

        && request.auth.uid
           != request.resource.data.ownerId

        && request.resource.data.source == 'initial'

        && unitAfter.propertyId
           == request.resource.data.propertyId

        && unitAfter.status == 'occupied'

        && unitAfter.tenantUserId
           == request.auth.uid

        && accessAfter.userId
           == request.auth.uid

        && accessAfter.ownerId
           == request.resource.data.ownerId

        && accessAfter.propertyId
           == request.resource.data.propertyId

        && accessAfter.unitId
           == request.resource.data.unitId

        && accessAfter.invitationId is string

        && accessAfter.invitationId != ''

        && tenantAfter.userId
           == request.auth.uid

        && tenantAfter.ownerId
           == request.resource.data.ownerId

        && tenantAfter.status == 'active'

        && tenantAfter.propertyId
           == request.resource.data.propertyId

        && tenantAfter.unitId
           == request.resource.data.unitId

        && tenantAfter.tenancyStartedAt is timestamp

        && request.resource.data.effectiveFrom
           == tenantAfter.tenancyStartedAt

        && invitationAfter.status == 'accepted'

        && invitationAfter.ownerId
           == request.resource.data.ownerId

        && invitationAfter.tenantId
           == accessAfter.tenantId

        && invitationAfter.propertyId
           == request.resource.data.propertyId

        && invitationAfter.unitId
           == request.resource.data.unitId

        && invitationAfter.rentAmount is number

        && invitationAfter.rentAmount > 0

        && request.resource.data.amount
           == invitationAfter.rentAmount

        && propertyAfter.ownerId
           == request.resource.data.ownerId;
    }


    // ============================================================
    // RENT RATE — CHANGED RATE CREATE
    // ============================================================

    function isValidChangedRentRateCreate() {

      let previousRateBefore =
        get(
          /databases/$(database)/documents/rentRates/$(request.resource.data.previousRentRateId)
        ).data;

      let previousRateAfter =
        getAfter(
          /databases/$(database)/documents/rentRates/$(request.resource.data.previousRentRateId)
        ).data;

      let unitAfter =
        getAfter(
          /databases/$(database)/documents/units/$(request.resource.data.unitId)
        ).data;

      let propertyAfter =
        getAfter(
          /databases/$(database)/documents/properties/$(request.resource.data.propertyId)
        ).data;

      return

        request.auth.uid
           == request.resource.data.ownerId

        && request.resource.data.source
           in [
             'property',
             'floor',
             'unit'
           ]

        && request.resource.data.previousRentRateId is string

        && request.resource.data.previousRentRateId != ''

        && request.resource.data.previousRentRateId
           != request.resource.id

        && previousRateBefore.ownerId
           == request.auth.uid

        && previousRateBefore.propertyId
           == request.resource.data.propertyId

        && previousRateBefore.unitId
           == request.resource.data.unitId

        && previousRateBefore.effectiveTo == null

        && previousRateAfter.ownerId
           == request.auth.uid

        && previousRateAfter.propertyId
           == request.resource.data.propertyId

        && previousRateAfter.unitId
           == request.resource.data.unitId

        && previousRateAfter.effectiveTo is timestamp

        && previousRateAfter.effectiveTo
           >= previousRateAfter.effectiveFrom

        && previousRateAfter.effectiveTo
           <= request.resource.data.effectiveFrom

        && previousRateAfter.nextRentRateId
           == request.resource.id

        && request.resource.data.ownerId
           == previousRateBefore.ownerId

        && request.resource.data.propertyId
           == previousRateBefore.propertyId

        && request.resource.data.unitId
           == previousRateBefore.unitId

        && request.resource.data.amount is number

        && request.resource.data.amount > 0

        && request.resource.data.effectiveFrom is timestamp

        && request.resource.data.effectiveFrom
           > previousRateBefore.effectiveFrom

        && request.resource.data.effectiveTo == null

        && unitAfter.propertyId
           == request.resource.data.propertyId

        && propertyAfter.ownerId
           == request.auth.uid

        && request.resource.data.createdAt is timestamp

        && request.resource.data.updatedAt is timestamp

        && request.resource.data.createdAt <= request.time

        && request.resource.data.updatedAt <= request.time;
    }


    // ============================================================
    // RENT RATE — END TENANCY CLOSE
    // ============================================================

    function isValidEndTenancyRentRateClose() {

      let unitBefore =
        get(
          /databases/$(database)/documents/units/$(resource.data.unitId)
        ).data;

      let unitAfter =
        getAfter(
          /databases/$(database)/documents/units/$(resource.data.unitId)
        ).data;

      let propertyAfter =
        getAfter(
          /databases/$(database)/documents/properties/$(resource.data.propertyId)
        ).data;

      return

        resource.data.ownerId == request.auth.uid

        && unitBefore.propertyId
           == resource.data.propertyId

        && unitBefore.status == 'occupied'

        && unitBefore.tenantUserId is string

        && unitBefore.tenantUserId != ''

        && propertyAfter.ownerId
           == request.auth.uid

        && propertyAfter.tenantUserIds is list

        && !(unitBefore.tenantUserId
             in propertyAfter.tenantUserIds)

        && unitAfter.propertyId
           == resource.data.propertyId

        && unitAfter.status == 'available'

        && isUnitUnassigned(unitAfter)

        && !existsAfter(
          /databases/$(database)/documents/tenantAccess/$(unitBefore.tenantUserId)
        )

        && request.resource.data.effectiveTo <= request.time

        && request.resource.data.effectiveTo
           >= resource.data.effectiveFrom;
    }


    // ============================================================
    // RENT RATE — NORMAL RATE CHANGE CLOSE
    // ============================================================

    function isValidChangedRentRateClose() {

      let unit =
        get(
          /databases/$(database)/documents/units/$(resource.data.unitId)
        ).data;

      let property =
        get(
          /databases/$(database)/documents/properties/$(resource.data.propertyId)
        ).data;

      let nextRate =
        getAfter(
          /databases/$(database)/documents/rentRates/$(request.resource.data.nextRentRateId)
        ).data;

      return

        property.ownerId == request.auth.uid

        && resource.data.ownerId == request.auth.uid

        && unit.propertyId
           == resource.data.propertyId

        && request.resource.data.nextRentRateId is string

        && request.resource.data.nextRentRateId != ''

        && request.resource.data.nextRentRateId
           != resource.id

        && request.resource.data.effectiveTo is timestamp

        && request.resource.data.effectiveTo
           >= resource.data.effectiveFrom

        && request.resource.data.effectiveTo
           <= nextRate.effectiveFrom

        && nextRate.previousRentRateId
           == resource.id

        && nextRate.ownerId
           == resource.data.ownerId

        && nextRate.propertyId
           == resource.data.propertyId

        && nextRate.unitId
           == resource.data.unitId

        && nextRate.effectiveFrom is timestamp

        && nextRate.effectiveFrom
           > resource.data.effectiveFrom

        && nextRate.effectiveTo == null

        && (
          !nextRate.keys()
            .hasAny(['nextRentRateId'])

          ||

          nextRate.nextRentRateId == null
        )

        && nextRate.amount is number

        && nextRate.amount > 0

        && nextRate.createdAt is timestamp

        && nextRate.updatedAt is timestamp

        && nextRate.createdAt <= request.time

        && nextRate.updatedAt <= request.time;
    }


    // ============================================================
    // MONTHLY RENT — CREATE VALIDATION
    // ============================================================

    function isValidMonthlyRentCreate() {

      let property =
        get(
          /databases/$(database)/documents/properties/$(request.resource.data.propertyId)
        ).data;

      let unit =
        get(
          /databases/$(database)/documents/units/$(request.resource.data.unitId)
        ).data;

      let tenant =
        get(
          /databases/$(database)/documents/tenants/$(request.resource.data.tenantId)
        ).data;

      let rentRate =
        get(
          /databases/$(database)/documents/rentRates/$(request.resource.data.rentRateId)
        ).data;

      return

        request.resource.data.ownerId
           == request.auth.uid

        && property.ownerId
           == request.auth.uid

        && tenant.ownerId
           == request.auth.uid

        && rentRate.ownerId
           == request.auth.uid

        && tenant.propertyId
           == request.resource.data.propertyId

        && unit.propertyId
           == request.resource.data.propertyId

        && rentRate.propertyId
           == request.resource.data.propertyId

        && tenant.unitId
           == request.resource.data.unitId

        && rentRate.unitId
           == request.resource.data.unitId

        && unit.status == 'occupied'

        && tenant.status == 'active'

        && tenant.userId is string

        && tenant.userId != ''

        && unit.tenantUserId
           == tenant.userId

        && request.resource.data.tenantUserId
           == tenant.userId

        && rentRate.effectiveFrom
           <= request.resource.data.billingPeriodStart

        && (
          rentRate.effectiveTo == null

          ||

          request.resource.data.billingPeriodStart
             < rentRate.effectiveTo
        )

        && request.resource.data.rentRateId is string

        && request.resource.data.rentRateId != ''

        && request.resource.data.amount is number

        && request.resource.data.amount > 0

        && request.resource.data.amount
           == rentRate.amount

        && request.resource.data.billingPeriodStart is timestamp

        && request.resource.data.billingPeriodEnd is timestamp

        && request.resource.data.billingPeriodEnd
           > request.resource.data.billingPeriodStart

        && request.resource.data.dueDate is timestamp

        && request.resource.data.dueDate
           >= request.resource.data.billingPeriodStart

        && request.resource.data.status == 'unpaid'

        && request.resource.data.createdAt is timestamp

        && request.resource.data.updatedAt is timestamp

        && request.resource.data.updatedAt
           == request.resource.data.createdAt

        && request.resource.data.createdAt <= request.time

        && request.resource.data.updatedAt <= request.time;
    }


    // ============================================================
    // OWNER — CREATE RENT
    // ============================================================

    function isValidOwnerCreateRent() {

      let property =
        get(
          /databases/$(database)/documents/properties/$(request.resource.data.propertyId)
        ).data;

      let unit =
        get(
          /databases/$(database)/documents/units/$(request.resource.data.unitId)
        ).data;

      let tenant =
        get(
          /databases/$(database)/documents/tenants/$(request.resource.data.tenantId)
        ).data;

      return

        request.resource.data.ownerId
           == request.auth.uid

        && property.ownerId
           == request.auth.uid

        && tenant.ownerId
           == request.auth.uid

        && tenant.propertyId
           == request.resource.data.propertyId

        && unit.propertyId
           == request.resource.data.propertyId

        && unit.status == 'occupied'

        && tenant.status == 'active'

        && tenant.unitId
           == request.resource.data.unitId

        && (
          (
            tenant.userId is string

            &&

            tenant.userId != ''

            &&

            request.resource.data.tenantUserId
               == tenant.userId

            &&

            unit.tenantUserId
               == tenant.userId
          )

          ||

          (
            (
              !tenant.keys().hasAny(['userId'])

              ||

              tenant.userId == null

              ||

              (
                tenant.userId is string
                &&
                tenant.userId == ''
              )
            )

            &&

            request.resource.data.tenantUserId == null

            &&

            isUnitUnassigned(unit)
          )
        )

        && request.resource.data.amount is number

        && request.resource.data.amount > 0

        && request.resource.data.billingPeriodStart is timestamp

        && request.resource.data.billingPeriodEnd is timestamp

        && request.resource.data.billingPeriodStart
           <= request.resource.data.billingPeriodEnd

        && request.resource.data.dueDate is timestamp

        && request.resource.data.dueDate
           >= request.resource.data.billingPeriodStart

        && request.resource.data.status == 'unpaid'

        && request.resource.data.createdAt is timestamp

        && request.resource.data.updatedAt is timestamp

        && request.resource.data.updatedAt
           == request.resource.data.createdAt;
    }
  }
}