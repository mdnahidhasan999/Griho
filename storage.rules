rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function validImage() {
      return request.resource.size < 5 * 1024 * 1024
          && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    function property(propertyId) {
      return firestore.get(
        /databases/(default)/documents/properties/$(propertyId)
      );
    }

    function isOwner(propertyId) {
      return signedIn() && property(propertyId).data.ownerId == request.auth.uid;
    }

    function isManager(propertyId) {
      return signedIn()
          && firestore.exists(
            /databases/(default)/documents/managerAccess/
            $(request.auth.uid + '_' + propertyId)
          );
    }

    function isTenant(propertyId) {
      return signedIn()
          && firestore.exists(
            /databases/(default)/documents/tenantAccess/$(request.auth.uid)
          )
          && firestore.get(
            /databases/(default)/documents/tenantAccess/$(request.auth.uid)
          ).data.propertyId == propertyId;
    }

    function canManage(propertyId) {
      return isOwner(propertyId) || isManager(propertyId);
    }

    match /users/{userId}/profile/{fileName} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if signedIn() && request.auth.uid == userId && validImage();
    }

    match /properties/{propertyId}/tenants/{tenantId}/{fileName} {
      allow read: if canManage(propertyId) || isTenant(propertyId);
      allow write: if canManage(propertyId) && validImage();
    }

    match /properties/{propertyId}/payments/{paymentId}/{fileName} {
      allow read: if canManage(propertyId) || isTenant(propertyId);
      allow write: if (canManage(propertyId) || isTenant(propertyId))
          && validImage();
    }
  }
}
